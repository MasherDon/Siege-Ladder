From 40112aa345e1bd23e0f7edc16e58d7a101b94ce2 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Wed, 04 Nov 2026 21:51:30 +0000
Subject: [PATCH 117/121] P13 LID byte for byte: indexer projections (q, RoPE,
 head weights) over the whole ubatch, only scores and top-k per query chunk
 (lab L048, Cursor)

---
 src/models/deepseek4.cpp | 59 ++++++++++++++++++++++++++++++++++------
 src/models/models.h      | 24 ++++++++++++++++
 2 files changed, 74 insertions(+), 9 deletions(-)

diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index 40059e0..35df6f2 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -961,15 +961,12 @@ ggml_tensor * llama_model_deepseek4::graph::build_candidate_mask(
     return keep;
 }
 
-ggml_tensor * llama_model_deepseek4::graph::build_lid_top_k(
+llama_model_deepseek4::graph::dsv4_lid_prepared llama_model_deepseek4::graph::build_lid_prepare(
         const llama_model & model,
         llm_graph_input_dsv4 * inp_dsv4,
         ggml_tensor * qr,
         ggml_tensor * cur,
         ggml_tensor * inp_pos,
-        ggml_tensor * score_mask,
-        ggml_tensor * inp_lid_pin,
-        ggml_tensor ** cand_carry,
         int il) const {
     const auto & layer = model.layers[il];
     const auto & inp_lid = inp_dsv4->get_lid();
@@ -979,7 +976,6 @@ ggml_tensor * llama_model_deepseek4::graph::build_lid_top_k(
     const int64_t n_indexer_head           = hparams.indexer_n_head;
     const int64_t nt                       = cur->ne[1];
 
-    GGML_ASSERT(score_mask);
     // k_rot is optional: it is an orthogonal rotation applied to both sides of the dot
     // product, so leaving it off q and k alike is the identity. V4.1 has none, because a
     // shared rotation needs the full head dim to match the indexer's, and here it does not.
@@ -1013,6 +1009,24 @@ ggml_tensor * llama_model_deepseek4::graph::build_lid_top_k(
     indexer_weights = ggml_scale(ctx0, indexer_weights, 1.0f/sqrtf(float(n_embd_indexer_head*n_indexer_head)));
     cb(indexer_weights, "lid_weights", il);
 
+    return { indexer_q, indexer_weights };
+}
+
+ggml_tensor * llama_model_deepseek4::graph::build_lid_score_top_k(
+        const llama_model & model,
+        llm_graph_input_dsv4 * inp_dsv4,
+        const dsv4_lid_prepared & prep,
+        ggml_tensor * score_mask,
+        ggml_tensor * inp_lid_pin,
+        ggml_tensor ** cand_carry,
+        int il) const {
+    GGML_ASSERT(score_mask);
+    GGML_ASSERT(prep.indexer_q && prep.indexer_weights);
+
+    ggml_tensor * indexer_q       = prep.indexer_q;
+    ggml_tensor * indexer_weights = prep.indexer_weights;
+    const int64_t nt              = indexer_q->ne[2];
+
     // V4.1 shares the index keys from the owning layer; in V4 the source is the layer itself
     const int32_t lid_src_il = hparams.dsv4_kv_src_layer[il];
     GGML_ASSERT(lid_src_il >= 0 && "DSV4: layer reads index keys with no source");
@@ -1094,6 +1108,20 @@ ggml_tensor * llama_model_deepseek4::graph::build_lid_top_k(
     return top_k;
 }
 
+ggml_tensor * llama_model_deepseek4::graph::build_lid_top_k(
+        const llama_model & model,
+        llm_graph_input_dsv4 * inp_dsv4,
+        ggml_tensor * qr,
+        ggml_tensor * cur,
+        ggml_tensor * inp_pos,
+        ggml_tensor * score_mask,
+        ggml_tensor * inp_lid_pin,
+        ggml_tensor ** cand_carry,
+        int il) const {
+    const dsv4_lid_prepared prep = build_lid_prepare(model, inp_dsv4, qr, cur, inp_pos, il);
+    return build_lid_score_top_k(model, inp_dsv4, prep, score_mask, inp_lid_pin, cand_carry, il);
+}
+
 ggml_tensor * llama_model_deepseek4::graph::build_top_k_mask(
         ggml_tensor * kq_mask,
         ggml_tensor * top_k,
@@ -1173,6 +1201,15 @@ ggml_tensor * llama_model_deepseek4::graph::build_csa_lid_attention(
                     "unfused_kq_est=%.1f MiB\n", __func__, il, (long long) (plan.n_chunk-c0),
                     (long long) max_cs, (long long) width(inp_dsv4->get_csa()),
                     (long long) width(inp_dsv4->get_hca()), (long long) inp_csa.lid_mask->ne[0], kq_mib);
+            const int64_t nt_seg = cur->ne[1];
+            const dsv4_lid_prepared prep = build_lid_prepare(model, inp_dsv4, qr, cur, inp_pos, il);
+            ggml_build_forward_expand(gf, prep.indexer_q);
+            ggml_build_forward_expand(gf, prep.indexer_weights);
+            const double prep_q_mib = double(hparams.indexer_head_size)*double(hparams.indexer_n_head)*
+                    double(nt_seg)*sizeof(float)/(1024.0*1024.0);
+            const double prep_w_mib = double(hparams.indexer_n_head)*double(nt_seg)*sizeof(float)/(1024.0*1024.0);
+            LLAMA_LOG_INFO("%s: L048 layer=%d nt_seg=%lld lid_prep_q_est=%.1f MiB lid_prep_w_est=%.1f MiB\n",
+                    __func__, il, (long long) nt_seg, prep_q_mib, prep_w_mib);
             ggml_tensor * incoming = cand_carry ? *cand_carry : nullptr;
             ggml_tensor * published = nullptr;
             ggml_tensor * published_idx = nullptr;
@@ -1184,9 +1221,13 @@ ggml_tensor * llama_model_deepseek4::graph::build_csa_lid_attention(
                     GGML_ASSERT(t->ne[3] == 1 && t->ne[2] == 1);
                     return ggml_view_2d(ctx0, t, t->ne[0], n, t->nb[1], (size_t) off*t->nb[1]);
                 };
-                ggml_tensor * cq = rows2(qr);
-                ggml_tensor * cc = rows2(cur);
-                ggml_tensor * cp = ggml_view_1d(ctx0, inp_pos, n, (size_t) off*inp_pos->nb[0]);
+                ggml_tensor * chunk_q = ggml_view_3d(ctx0, prep.indexer_q,
+                        prep.indexer_q->ne[0], prep.indexer_q->ne[1], n,
+                        prep.indexer_q->nb[1], prep.indexer_q->nb[2], (size_t) off*prep.indexer_q->nb[2]);
+                ggml_tensor * chunk_w = ggml_view_2d(ctx0, prep.indexer_weights,
+                        prep.indexer_weights->ne[0], n, prep.indexer_weights->nb[1],
+                        (size_t) off*prep.indexer_weights->nb[1]);
+                const dsv4_lid_prepared chunk_prep { chunk_q, chunk_w };
                 ggml_tensor * mask = nullptr;
                 if (inp_csa.mask_visible) {
                     ggml_tensor * visible = ggml_view_1d(ctx0, inp_csa.mask_visible, n,
@@ -1210,7 +1251,7 @@ ggml_tensor * llama_model_deepseek4::graph::build_csa_lid_attention(
                     candidate = ggml_view_4d(ctx0, incoming, ne[0], ne[1], ne[2], ne[3],
                             incoming->nb[1], incoming->nb[2], incoming->nb[3], (size_t) off*incoming->nb[axis]);
                 }
-                ggml_tensor * pick = build_lid_top_k(model, inp_dsv4, cq, cc, cp, mask, pin,
+                ggml_tensor * pick = build_lid_score_top_k(model, inp_dsv4, chunk_prep, mask, pin,
                         cand_carry ? &candidate : nullptr, il);
                 // Materialize each result before building the next score graph.
                 ggml_build_forward_expand(gf, pick);
diff --git a/src/models/models.h b/src/models/models.h
index d18cd46..c43b475 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -1244,6 +1244,30 @@ struct llama_model_deepseek4 : public llama_model_base {
                 ggml_tensor * cand_pin,
                 int il) const;
 
+        struct dsv4_lid_prepared {
+                ggml_tensor * indexer_q     = nullptr;
+                ggml_tensor * indexer_weights = nullptr;
+        };
+
+        // Per-batch LID prep: q projection, RoPE, optional k_rot, head weights (P13 L048).
+        dsv4_lid_prepared build_lid_prepare(
+                const llama_model & model,
+                llm_graph_input_dsv4 * inp_dsv4,
+                ggml_tensor * qr,
+                ggml_tensor * cur,
+                ggml_tensor * inp_pos,
+                int il) const;
+
+        // Scores, candidate mask, top-k from prepared q/weights and a row-local mask.
+        ggml_tensor * build_lid_score_top_k(
+                const llama_model & model,
+                llm_graph_input_dsv4 * inp_dsv4,
+                const dsv4_lid_prepared & prep,
+                ggml_tensor * score_mask,
+                ggml_tensor * inp_lid_pin,
+                ggml_tensor ** cand_carry,
+                int il) const;
+
         ggml_tensor * build_lid_top_k(
                 const llama_model & model,
                 llm_graph_input_dsv4 * inp_dsv4,
