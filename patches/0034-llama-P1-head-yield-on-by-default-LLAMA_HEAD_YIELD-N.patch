+bool llama_moe_stream::read_bytes(uint32_t file_idx, size_t offs, size_t len,
+        const std::function<void(const uint8_t * data, size_t off, size_t n)> & sink) {
+    if (file_idx >= files.size()) {
+        return false;
+    }
+    const size_t piece = 64ull << 20;
+    // the staging slack of llama_moe_stream_pread: an unaligned head and tail of one sector each
+    uint8_t * staging = (uint8_t *) moe_aligned_alloc(piece + 2*MOE_STREAM_DIRECT_ALIGN);
+    if (staging == nullptr) {
+        return false;
+    }
+    bool ok = true;
+    for (size_t done = 0; done < len && ok; ) {
+        const size_t n = std::min(piece, len - done);
+        // -1: the shared handle - no worker reads through it
+        const uint8_t * data = llama_moe_stream_pread(*files[file_idx], staging, n, offs + done, use_direct_io, /*worker_id =*/ -1);
+        if (data == nullptr) {
+            ok = false;
+            break;
+        }
+        sink(data, done, n);
+        done += n;
+    }
+    moe_aligned_free(staging);
+    return ok;
+}
