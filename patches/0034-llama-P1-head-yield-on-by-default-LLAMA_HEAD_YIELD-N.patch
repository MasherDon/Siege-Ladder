+bool llama_model::head_yield_ready() const {
+    return pimpl->head_buft != nullptr && pimpl->moe_stream != nullptr && pimpl->head_file_idx >= 0 && output != nullptr;
+}
+
+bool llama_model::head_is_released() const {
+    return pimpl->head_released;
+}
+
+ggml_backend_buffer_type_t llama_model::head_buft() const {
+    return pimpl->head_buft;
+}
+
+void llama_model::head_release() const {
+    if (!head_yield_ready() || pimpl->head_released) {
+        return;
+    }
+    // ggml_backend_tensor_alloc wants both null again, and a graph that still referenced the head would now fail
+    // loudly (gallocr would try to place 1.2 GiB in the compute buffer) instead of reading freed memory
+    output->data   = nullptr;
+    output->buffer = nullptr;
+    pimpl->head_buf.reset();
+    pimpl->head_released = true;
+}
+
+bool llama_model::head_restore(double * t_read_ms) const {
+    if (!head_yield_ready() || !pimpl->head_released) {
+        return true;
+    }
+    ggml_backend_buffer_t hb = ggml_backend_buft_alloc_buffer(pimpl->head_buft, ggml_backend_buft_get_alloc_size(pimpl->head_buft, output));
+    if (hb == nullptr) {
+        LLAMA_LOG_ERROR("%s: the output head's %s buffer cannot be allocated again\n", __func__, ggml_backend_buft_name(pimpl->head_buft));
+        return false;
+    }
+    GGML_ASSERT(ggml_backend_tensor_alloc(hb, output, ggml_backend_buffer_get_base(hb)) == GGML_STATUS_SUCCESS);
+    ggml_backend_buffer_set_usage(hb, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    const int64_t t0 = ggml_time_us();
+    ggml_tensor * t = output;
+    const bool ok = pimpl->moe_stream->read_bytes((uint32_t) pimpl->head_file_idx, pimpl->head_file_offs, ggml_nbytes(t),
+            [t](const uint8_t * data, size_t off, size_t n) { ggml_backend_tensor_set(t, data, off, n); });
+    if (t_read_ms) {
+        *t_read_ms = (ggml_time_us() - t0)/1000.0;
+    }
+    if (!ok) {
+        LLAMA_LOG_ERROR("%s: the output head could not be read back from file %d\n", __func__, pimpl->head_file_idx);
+        output->data   = nullptr;
+        output->buffer = nullptr;
+        ggml_backend_buffer_free(hb);
+        return false;
+    }
+    pimpl->head_buf.reset(hb);
+    pimpl->head_released = false;
+    return true;
+}
