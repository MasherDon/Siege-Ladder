+void llama_moe_stream::enqueue_stage_copy_locked(const stage_copy & c, bool demand) {
+    auto & sl = *c.sl;
+    if (c.gen != sl.slot_gen[c.slot] || sl.slot_state[c.slot] != LLAMA_MOE_STREAM_SLOT_LOADING) {
+        if (l2) {
+            l2->release(c.l2_slot); // the slot was reserved again: this guess's slab is not wanted any more
+        }
+        n_stage_dropped++;
+        return;
+    }
+    const auto & wt = sl.weights[c.weight];
+    {
+        std::lock_guard<std::mutex> up(upload_mtx);
+        if (compute_backend != nullptr && (size_t) c.slot < sl.slot_up_event.size()) {
+            ggml_backend_tensor_set_async(up_backend, wt.cache, c.data, (size_t) c.slot*wt.nb_expert, wt.nb_expert);
+            const uint64_t seq = ++up_seq;
+            ggml_backend_event_record(sl.slot_up_event[c.slot], up_backend);
+            sl.slot_up_seq[c.slot] = seq;
+            up_l2_pending.emplace_back(seq, c.l2_slot); // released once a fence covers this copy
+            if (demand) {
+                demand_ev  = sl.slot_up_event[c.slot];
+                demand_seq = seq;
+            } else if (!stage_ring.empty()) {
+                ggml_backend_event_record(stage_ring[stage_ring_n % stage_ring.size()], up_backend);
+                stage_ring_n++;
+            }
+        } else {
+            ggml_backend_tensor_set(wt.cache, c.data, (size_t) c.slot*wt.nb_expert, wt.nb_expert);
+            if (l2) {
+                l2->release(c.l2_slot);
+            }
+        }
+    }
+    // published as any other part: RESIDENT once the slot's last part is enqueued
+    if (sl.slot_parts_left[c.slot] > 0 && --sl.slot_parts_left[c.slot] == 0) {
+        sl.slot_state[c.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+    }
+    cv_done.notify_all();
+}
+
+void llama_moe_stream::want_stage_slot_locked(llama_moe_stream_layer & sl, int32_t slot) {
+    if (stage_inflight <= 0) {
+        return;
+    }
+    sl.slot_wanted[slot] = 1; // parts still being read go at once too (the worker checks this flag)
+    for (auto it = stage_copies.begin(); it != stage_copies.end();) {
+        if (it->sl == &sl && it->slot == slot) {
+            const stage_copy c = *it;
+            it = stage_copies.erase(it);
+            enqueue_stage_copy_locked(c, /*demand =*/ true);
+            n_stage_taken++;
+        } else {
+            ++it;
+        }
+    }
+}
+
+void llama_moe_stream::flush_stage_copies_sync_locked() {
+    // upload_mtx is held, so the copies are made here rather than through enqueue_stage_copy_locked
+    for (const auto & c : stage_copies) {
+        auto & sl = *c.sl;
+        if (c.gen == sl.slot_gen[c.slot] && sl.slot_state[c.slot] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+            const auto & wt = sl.weights[c.weight];
+            ggml_backend_tensor_set(wt.cache, c.data, (size_t) c.slot*wt.nb_expert, wt.nb_expert);
+            if (sl.slot_parts_left[c.slot] > 0 && --sl.slot_parts_left[c.slot] == 0) {
+                sl.slot_state[c.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+            }
+        }
+        if (l2) {
+            l2->release(c.l2_slot);
+        }
+    }
+    stage_copies.clear();
+    cv_done.notify_all();
+}
+
+void llama_moe_stream::stage_dispatch_loop() {
+    std::unique_lock<std::mutex> lk(mtx);
+    while (true) {
+        cv_stage.wait(lk, [&]{ return shutting_down || !stage_copies.empty(); });
+        if (shutting_down) {
+            break;
+        }
+        // The gate is on the device and is waited for outside the locks: the latest demand copy has landed, and
+        // so has the staged copy N back (only this thread records those). A demand copy enqueued after this one
+        // waits behind at most N staged slabs.
+        ggml_backend_event_t ev_d  = nullptr;
+        ggml_backend_event_t ev_s  = nullptr;
+        uint64_t             seq_d = 0;
+        {
+            std::lock_guard<std::mutex> up(upload_mtx);
+            ev_d  = demand_ev;
+            seq_d = demand_seq;
+            if (!stage_ring.empty() && stage_ring_n >= stage_ring.size()) {
+                ev_s = stage_ring[stage_ring_n % stage_ring.size()];
+            }
+        }
+        lk.unlock();
+        if (ev_d) {
+            ggml_backend_event_synchronize(ev_d);
+        }
+        if (ev_s) {
+            ggml_backend_event_synchronize(ev_s);
+        }
+        lk.lock();
+        if (shutting_down) {
+            break;
+        }
+        bool newer_demand = false;
+        {
+            std::lock_guard<std::mutex> up(upload_mtx);
+            newer_demand = demand_seq != seq_d;
+        }
+        if (newer_demand || stage_copies.empty()) {
+            continue; // a demand copy came meanwhile (it goes first), or a call took the queued copies itself
+        }
+        const stage_copy c = stage_copies.front();
+        stage_copies.pop_front();
+        enqueue_stage_copy_locked(c, /*demand =*/ c.sl->slot_wanted[c.slot] != 0);
+        n_stage_dispatched++;
+    }
+}
