+// Pairs outside the current wave of a multi-pass prefill.
+//
+// They used to park on resident slots, run through the expert GEMMs and be zeroed by a mask, so
+// every wave multiplied the whole ubatch: with 18 slots that is 64 waves per layer. Measured
+// 2026-10-11 on an 8,897-token prompt (SiegeLadder runs.md 4.15): the wait on loads was 11% of
+// prompt time at -ub 2048 and 59% at -ub 512; the rest, ~15 ms per token at every ubatch size, was
+// mostly those 64 passes.
+//
+// Skipped, a pair gets LLAMA_MOE_STREAM_SKIP_ID, an id past the last slot. The CUDA mul_mat_id
+// leaves it out of the GEMM (the MMQ id helper never matches it), and op_params[2] = 1 on the down
+// projection zeroes its rows of dst, so the wave outputs add up without a mask.
+//
+// Only from LLAMA_MOE_STREAM_SKIP_MIN_TOKENS tokens: below that the CUDA backend can take the MMVQ
+// path, whose kernels index the expert by id with no range check.
+static const int32_t LLAMA_MOE_STREAM_SKIP_ID         = INT32_MAX;
+static const int64_t LLAMA_MOE_STREAM_SKIP_MIN_TOKENS = 64;
+
+// The one place the mode is decided. The graph (mask or no mask) and the wave ids op (park or
+// skip) must agree, or parked pairs would be summed unmasked.
+static inline bool llama_moe_stream_wave_skip(const llama_moe_stream_layer & sl, int64_t n_tokens) {
+    return sl.mgr->wave_skip && sl.wave_skip_ok && n_tokens >= LLAMA_MOE_STREAM_SKIP_MIN_TOKENS;
+}
+
 // callback of the id-remapping custom op inserted by build_moe_ffn
 void llama_moe_stream_remap(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata);
 
