         for (int64_t i12 = 0; i12 < ne12; ++i12) { // tokens
             for (int64_t iex = 0; iex < n_expert_used; ++iex) {
                 const int32_t expert_to_use = *(const int32_t *)(ids_host.data() + i12*ids->nb[1] + iex*ids->nb[0]);
-                assert(expert_to_use >= 0 && expert_to_use < ne02);
+                assert(expert_to_use >= 0); // past ne02: a pair left out of the product
                 if (expert_to_use == i02) {
                     ids_from_sorted_host[i12*n_expert_used + iex] = ids_to_sorted_host.size();
                     ids_to_sorted_host.push_back(i12*ne11 + iex % ne11);
@@ -1951,7 +1958,19 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
             }
         }
     }
-    GGML_ASSERT(ids_to_sorted_host.size() == size_t(ne_get_rows));
+    // pairs left out read the zero row after the sorted ones; ids_to_sorted is padded to ne_get_rows
+    // so that ids_from_sorted keeps its offset in the device buffer
+    const int64_t n_sorted = ids_to_sorted_host.size();
+    GGML_ASSERT(n_sorted <= ne_get_rows);
+    for (int32_t & i : ids_from_sorted_host) {
+        if (i < 0) {
+            i = n_sorted;
+        }
+    }
+    ids_to_sorted_host.resize(ne_get_rows, 0);
+    if (n_sorted < ne_get_rows) {
