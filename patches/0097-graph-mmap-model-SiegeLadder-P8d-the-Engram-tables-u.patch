+bool llm_graph_input_engram::read_rows(uint32_t e, const int64_t * idx, size_t n, uint8_t * out, int n_thr, int qd) const {
+    const size_t   hd  = hparams.engram_head_dim;
+    const size_t   sb  = hd/32;
+    const size_t   rb  = hd + sb;
+    const uint64_t SEC = 4096;
+    if (e >= model.engram_src.size()) {
+        return false;
+    }
+    const auto & src = model.engram_src[e];
+    // P8c (tables mapped): both from the files; P8d: from the file what lies only there, from memory what is in RAM
+    const bool w_file = !model.engram_unmapped || (e < model.engram_w_disk.size() && model.engram_w_disk[e]);
+    const bool s_file = !model.engram_unmapped || (e < model.engram_s_disk.size() && model.engram_s_disk[e]);
+    const auto &    layer = model.layers[hparams.engram_layer_ids[e]];
+    const uint8_t * w     = (const uint8_t *) layer.engram_embd->data;
+    const uint8_t * sc    = (const uint8_t *) layer.engram_embd_scale->data;
+    std::vector<llama_scatter_piece> ps;
+    ps.reserve(n*(w_file ? 2 : 0) + (s_file ? n : 0));
+    for (size_t k = 0; k < n; ++k) {
+        uint8_t * d = out + k*rb;
+        if (w_file) {
+            // a row's FP8 bytes: two pieces when they cross a 4 KB boundary
+            const uint64_t wo = src.offs_w + (uint64_t) idx[k]*hd;
+            const uint64_t a  = std::min<uint64_t>(hd, SEC - (wo & (SEC - 1)));
+            ps.push_back({ wo, (uint32_t) a, 0, d });
+            if (a < hd) {
+                ps.push_back({ wo + a, (uint32_t) (hd - a), 0, d + a });
+            }
+        } else {
+            std::memcpy(d, w + (size_t) idx[k]*hd, hd);
+        }
+        if (s_file) {
+            ps.push_back({ src.offs_s + (uint64_t) idx[k]*sb, (uint32_t) sb, 1, d + hd });
+        } else {
+            std::memcpy(d + hd, sc + (size_t) idx[k]*sb, sb);
+        }
+    }
+    const std::string paths[2] = { src.path_w, src.path_s };
+    return llama_read_scattered(paths, ps, n_thr, qd);
+}
