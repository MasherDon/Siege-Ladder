+#ifdef _WIN32
+// SiegeLadder P8d: FSCTL_MANAGE_BYPASS_IO (Windows 11), declared here - winioctl.h shows it only from NTDDI_WIN10_CO on
+struct sl_bpio_input  { int32_t op; int32_t in_flags; uint64_t r1, r2; };
+struct sl_bpio_output { int32_t op; int32_t out_flags; uint64_t r1, r2; uint32_t op_status; uint16_t drv_len;
+                        wchar_t drv[32]; uint16_t why_len; wchar_t why[128]; };
+
+// SiegeLadder P8d: one unbuffered overlapped handle per file for the whole process (each thread brings its own
+// OVERLAPPED), with BypassIO asked for: on an unmapped engram file diskspd did 0.72M 4 KB reads a second plain and
+// 1.14M with it (SiegeLadder runs.md 4.240); on a mapped one it changes nothing (13K). Opened once instead of by every
+// reader thread of every call - decode reads a layer's ~50 sectors per token
+static HANDLE llama_scatter_handle(const std::string & path) {
+    static std::mutex mtx;
+    static std::unordered_map<std::string, HANDLE> handles;
+    std::lock_guard<std::mutex> lk(mtx);
+    auto it = handles.find(path);
+    if (it != handles.end()) {
+        return it->second;
+    }
+    HANDLE h = CreateFileA(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+            FILE_FLAG_OVERLAPPED | FILE_FLAG_NO_BUFFERING, NULL);
+    if (h != INVALID_HANDLE_VALUE) {
+        sl_bpio_input  in  = { 1 /* FS_BPIO_OP_ENABLE */, 0, 0, 0 };
+        sl_bpio_output out = {};
+        OVERLAPPED     ov  = {};
+        ov.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+        DWORD got = 0;
+        BOOL  r   = ov.hEvent != NULL && DeviceIoControl(h, CTL_CODE(FILE_DEVICE_FILE_SYSTEM, 274, METHOD_BUFFERED,
+                FILE_ANY_ACCESS), &in, sizeof(in), &out, sizeof(out), &got, &ov);
+        if (!r && ov.hEvent != NULL && GetLastError() == ERROR_IO_PENDING) {
+            r = GetOverlappedResult(h, &ov, &got, TRUE);
+        }
+        if (ov.hEvent != NULL) {
+            CloseHandle(ov.hEvent);
+        }
+        const bool on = r && out.op_status == 0;
+        std::string why;
+        for (uint16_t k = 0; !on && k < std::min<uint16_t>(out.why_len, 128); ++k) {
+            why += (char) (out.why[k] < 128 ? out.why[k] : '?');
+        }
+        LLAMA_LOG_INFO("%s: SiegeLadder P8d: %s - BypassIO %s%s%s\n", __func__, path.c_str(), on ? "on" : "off",
+                on ? "" : ": ", on ? "" : (why.empty() ? llama_format_win_err(r ? (DWORD) out.op_status : GetLastError()).c_str() : why.c_str()));
+    }
+    handles.emplace(path, h);
+    return h;
+}
+#endif
