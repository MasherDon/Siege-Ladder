--- a/src/llama-moe-stream.h
+++ b/src/llama-moe-stream.h
@@ -662,7 +662,7 @@ struct llama_moe_stream {
     // target_slots: 0 = auto from DXGI; seg_reserve_bytes = margin for segment graphs (POOL_MARGIN + peak sched buf)
     bool p19_lm_pool_begin(uint32_t target_slots, size_t seg_reserve_bytes, size_t margin_mib);
     bool p19_lm_pool_shrunk = false;
-    void p19_lm_pool_shrink(const char * reason, size_t sc, int layer, size_t ub);
+    void p19_lm_pool_shrink(const char * reason, size_t sc, int layer, size_t ub, size_t guard_mib);
     void p19_lm_pool_end(); // shrink to p19_lm_base_slots; no-op when p11_leave will restore the cache
     // SiegeLadder P4: the last layer whose experts the latest graph build runs (-1: every layer) - an encoder-only ubatch
     // stops before the first decoder layer's FFN, and nothing reads ahead into a layer it will not run. Set at graph build
