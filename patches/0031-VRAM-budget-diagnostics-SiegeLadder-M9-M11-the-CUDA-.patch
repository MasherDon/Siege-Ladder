From 32cf9d8a894b8d49793db0d93caecceb608ded48 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Sat, 17 Oct 2026 06:56:17 +0000
Subject: [PATCH 31/91] VRAM budget diagnostics (SiegeLadder M9 / M11): the
 CUDA VMM pool logs every growth with the node that asked; the WDDM budgets of
 the process (DXGI) are printed when the host tier is allocated and when the
 context is built; LLAMA_MOE_STREAM_PROBE_VRAM=1 takes 16 MiB blocks after
 load until the driver refuses

Under "Prefer No Sysmem Fallback" the real limit was ~15 665 MiB of DXGI usage in every configuration (the DXGI budget, 15 227, is exceeded freely): -ub 2048 at 12K leaves 16 MiB, so the pool fails on its first growth.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 20 ++++++++-
 src/CMakeLists.txt              |  1 +
 src/llama-moe-stream.cpp        | 56 ++++++++++++++++++++++++
 src/llama-wddm.cpp              | 76 +++++++++++++++++++++++++++++++++
 src/llama-wddm.h                | 17 ++++++++
 5 files changed, 169 insertions(+), 1 deletion(-)
 create mode 100644 src/llama-wddm.cpp
 create mode 100644 src/llama-wddm.h

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b91e5e6..06e6fa7 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -415,6 +415,11 @@ const ggml_cuda_device_info & ggml_cuda_info() {
 
 // #define DEBUG_CUDA_MALLOC
 
+// SiegeLadder (theory M11, runs.md 4.43): the graph node being computed on this thread, so that the VMM pool can say
+// which op made it grow. The pool grows at run time, after the load-time memory estimate, and with the driver's
+// "Prefer No Sysmem Fallback" a growth past free VRAM is a crash in the middle of a prompt.
+static thread_local const ggml_tensor * ggml_cuda_pool_cur_node = nullptr;
+
 // buffer pool for cuda (legacy)
 struct ggml_cuda_pool_leg : public ggml_cuda_pool {
     static const int MAX_BUFFERS = 256;
@@ -538,6 +543,7 @@ struct ggml_cuda_pool_vmm : public ggml_cuda_pool {
 
     int device;
     int physical_device;
+    int stream_no = 0;
     CUdeviceptr pool_addr = 0;
     size_t pool_used = 0;
     size_t pool_size = 0;
@@ -580,6 +586,14 @@ struct ggml_cuda_pool_vmm : public ggml_cuda_pool {
 
             GGML_ASSERT(pool_size + reserve_size <= CUDA_POOL_VMM_MAX_SIZE);
 
+            // M11: every growth, logged before the driver calls, so a failing one is the last line
+            {
+                const ggml_tensor * node = ggml_cuda_pool_cur_node;
+                GGML_LOG_INFO("%s: cuda pool[%d][%d] grows %.1f -> %.1f MiB for a %.2f MiB buffer (%.1f MiB in use) at %s (%s)\n",
+                        __func__, device, stream_no, pool_size/1048576.0, (pool_size + reserve_size)/1048576.0,
+                        size/1048576.0, pool_used/1048576.0, node ? node->name : "-", node ? ggml_op_desc(node) : "-");
+            }
+
             // allocate more physical memory
             CUmemAllocationProp prop = {};
             prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
@@ -686,7 +700,9 @@ std::unique_ptr<ggml_cuda_pool> ggml_backend_cuda_context::new_pool_for_device(i
                                                                                [[maybe_unused]] int stream_no) {
 #if defined(GGML_USE_VMM)
     if (ggml_cuda_info().devices[device].vmm) {
-        return std::unique_ptr<ggml_cuda_pool>(new ggml_cuda_pool_vmm(device));
+        auto * pool = new ggml_cuda_pool_vmm(device);
+        pool->stream_no = stream_no;
+        return std::unique_ptr<ggml_cuda_pool>(pool);
     }
 #endif // defined(GGML_USE_VMM)
     return std::unique_ptr<ggml_cuda_pool>(new ggml_cuda_pool_leg(device));
@@ -4065,7 +4081,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 GGML_UNUSED(integrated);
 #endif  // NDEBUG
 
+                ggml_cuda_pool_cur_node = node;
                 bool ok = ggml_cuda_compute_forward(*cuda_ctx, node);
+                ggml_cuda_pool_cur_node = nullptr;
                 if (!ok) {
                     GGML_LOG_ERROR("%s: op not supported %s (%s)\n", __func__, node->name, ggml_op_name(node->op));
                 }
