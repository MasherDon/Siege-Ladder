diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index 469d0e7..5205996 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -1,4 +1,5 @@
 #include "llama-moe-stream.h"
+#include "llama-wddm.h"
 
 #include "llama-impl.h"
 
@@ -410,6 +411,17 @@ void llama_moe_stream::alloc_l2(ggml_backend_buffer_type_t host_buft) {
 
     const size_t bytes = n_l2 * stride;
 
+    // M9: pinned memory counts against the shared (non-local) WDDM budget; past it the tier is not locked (4.36)
+    {
+        const llama_wddm_budget wb = llama_wddm_query_budget();
+        if (wb.ok) {
+            LLAMA_LOG_INFO("%s: WDDM shared-memory budget %.0f MiB, %.0f in use; the tier asks %.0f MiB%s\n", __func__,
+                    wb.nonlocal_budget/1048576.0, wb.nonlocal_usage/1048576.0, bytes/1048576.0,
+                    host_buft != nullptr && wb.nonlocal_usage + bytes > wb.nonlocal_budget ?
+                        " - more than is left: the part past the budget will not stay locked" : "");
+        }
+    }
+
     if (host_buft != nullptr) {
         ggml_backend_buffer_t b = ggml_backend_buft_alloc_buffer(host_buft, bytes);
         if (b != nullptr) {
@@ -685,6 +697,50 @@ llama_moe_stream::~llama_moe_stream() {
 }
 
 void llama_moe_stream::attach_backend(ggml_backend_t backend) {
+    // M11: the end of the context's construction - every load-time buffer is in place, and what is left of the
+    // process's VRAM budget is all the CUDA pool can grow into (with "Prefer No Sysmem Fallback" a growth past it
+    // is a crash in the middle of a prompt: -ub 2048 at 12K, runs.md 4.43)
+    {
+        const llama_wddm_budget wb = llama_wddm_query_budget();
+        if (wb.ok) {
+            const double headroom = ((double) wb.local_budget - (double) wb.local_usage)/1048576.0;
+            LLAMA_LOG_INFO("%s: WDDM budget of %s: VRAM %.0f of %.0f MiB in use (dedicated %.0f), %.0f MiB left for "
+                    "the CUDA pool; shared %.0f of %.0f MiB\n", __func__, wb.name, wb.local_usage/1048576.0,
+                    wb.local_budget/1048576.0, wb.dedicated/1048576.0, headroom, wb.nonlocal_usage/1048576.0,
+                    wb.nonlocal_budget/1048576.0);
+            if (headroom < 256.0) {
+                LLAMA_LOG_WARN("%s: only %.0f MiB of the VRAM budget left after load - a prompt batch that grows the "
+                        "CUDA pool past it fails under \"Prefer No Sysmem Fallback\" (a smaller -ub needs less)\n",
+                        __func__, headroom);
+            }
+        }
+        // measurement (LLAMA_MOE_STREAM_PROBE_VRAM=1): the DXGI budget is not the real limit - 4.43 ran 100-400 MiB
+        // past it, and the pool still died 16 MiB above the load at -ub 2048 - so take 16 MiB blocks until the driver
+        // refuses, note how far it went, and give them all back
+        if (std::getenv("LLAMA_MOE_STREAM_PROBE_VRAM") != nullptr && backend != nullptr) {
+            ggml_backend_dev_t pdev = ggml_backend_get_device(backend);
+            ggml_backend_buffer_type_t pbuft = pdev != nullptr ? ggml_backend_dev_buffer_type(pdev) : nullptr;
+            if (pbuft != nullptr) {
+                const size_t step = 16ull << 20;
+                std::vector<ggml_backend_buffer_t> got;
+                while (got.size() < 1024) { // 16 GiB at most
+                    ggml_backend_buffer_t b = ggml_backend_buft_alloc_buffer(pbuft, step);
+                    if (b == nullptr) {
+                        break;
+                    }
+                    got.push_back(b);
+                }
+                const llama_wddm_budget at_peak = llama_wddm_query_budget();
+                for (ggml_backend_buffer_t b : got) {
+                    ggml_backend_buffer_free(b);
+                }
+                LLAMA_LOG_WARN("%s: VRAM probe: %zu MiB more could be allocated after load%s%.0f MiB in use at the "
+                        "peak, budget %.0f, dedicated %.0f)\n", __func__, got.size()*16, at_peak.ok ? " (DXGI: " : " (",
+                        at_peak.ok ? at_peak.local_usage/1048576.0 : 0.0, at_peak.local_budget/1048576.0,
+                        at_peak.dedicated/1048576.0);
+            }
+        }
+    }
     if (!async_upload || backend == nullptr || bufs.empty()) {
         return;
     }
diff --git a/src/llama-wddm.cpp b/src/llama-wddm.cpp
new file mode 100644
index 0000000..dc24ab0
--- /dev/null
+++ b/src/llama-wddm.cpp
@@ -0,0 +1,76 @@
+// SiegeLadder (theories M9, M11; runs.md 4.43). Under WDDM a process may hold only its budget of the adapter's
+// dedicated memory - the OS keeps the rest - and with the NVIDIA driver's "Prefer No Sysmem Fallback" an allocation
+// past the budget fails instead of spilling into system memory: the CUDA pool then dies in the middle of a prompt.
+// Pinned host memory counts against the non-local (shared) budget, which caps the host tier (M6).
+#include "llama-wddm.h"
+
+#ifdef _WIN32
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <dxgi1_4.h>
+
+#pragma comment(lib, "dxgi.lib")
+
+llama_wddm_budget llama_wddm_query_budget() {
+    llama_wddm_budget r;
+
+    IDXGIFactory4 * factory = nullptr;
+    if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory4), (void **) &factory))) {
+        return r;
+    }
+    // the adapter with the most dedicated memory: the discrete card, not an iGPU that drives the monitor
+    IDXGIAdapter1 * best     = nullptr;
+    SIZE_T          best_mem = 0;
+    for (UINT i = 0; ; i++) {
+        IDXGIAdapter1 * a = nullptr;
+        if (factory->EnumAdapters1(i, &a) == DXGI_ERROR_NOT_FOUND) {
+            break;
+        }
+        DXGI_ADAPTER_DESC1 d = {};
+        a->GetDesc1(&d);
+        if (!(d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) && d.DedicatedVideoMemory > best_mem) {
+            if (best != nullptr) {
+                best->Release();
+            }
+            best     = a;
+            best_mem = d.DedicatedVideoMemory;
+            WideCharToMultiByte(CP_UTF8, 0, d.Description, -1, r.name, (int) sizeof(r.name), nullptr, nullptr);
+        } else {
+            a->Release();
+        }
+    }
+    if (best != nullptr) {
+        IDXGIAdapter3 * a3 = nullptr;
+        if (SUCCEEDED(best->QueryInterface(__uuidof(IDXGIAdapter3), (void **) &a3))) {
+            DXGI_QUERY_VIDEO_MEMORY_INFO local    = {};
+            DXGI_QUERY_VIDEO_MEMORY_INFO nonlocal = {};
+            if (SUCCEEDED(a3->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local)) &&
+                SUCCEEDED(a3->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal))) {
+                r.ok              = true;
+                r.dedicated       = best_mem;
+                r.local_budget    = local.Budget;
+                r.local_usage     = local.CurrentUsage;
+                r.nonlocal_budget = nonlocal.Budget;
+                r.nonlocal_usage  = nonlocal.CurrentUsage;
+            }
+            a3->Release();
+        }
+        best->Release();
+    }
+    factory->Release();
+    return r;
+}
+
+#else
+
+llama_wddm_budget llama_wddm_query_budget() {
+    return {};
+}
+
+#endif
diff --git a/src/llama-wddm.h b/src/llama-wddm.h
new file mode 100644
index 0000000..b96e39e
--- /dev/null
+++ b/src/llama-wddm.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <cstdint>
+
+// SiegeLadder (theories M9, M11; runs.md 4.43): the WDDM video memory budgets of this process for the adapter with
+// the most dedicated memory, read through DXGI. ok is false off Windows or when DXGI cannot tell.
+struct llama_wddm_budget {
+    bool     ok              = false;
+    char     name[128]       = {};
+    uint64_t dedicated       = 0; // DXGI_ADAPTER_DESC1::DedicatedVideoMemory
+    uint64_t local_budget    = 0; // VRAM the OS lets this process hold
+    uint64_t local_usage     = 0; // VRAM this process holds now
+    uint64_t nonlocal_budget = 0; // system memory the GPU may map for this process: pinned host buffers count here
+    uint64_t nonlocal_usage  = 0;
+};
+
+llama_wddm_budget llama_wddm_query_budget();
