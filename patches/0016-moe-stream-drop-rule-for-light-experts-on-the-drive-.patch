+// Deterministic uniform [0, 1) of a call index and an expert (splitmix64): every run of one
+// ORACLE_RECALL point keeps exactly the same experts.
+static float moe_hash01(uint64_t a, uint64_t b) {
+    uint64_t z = a*0x9E3779B97F4A7C15ull + b + 0x632BE59BD9B4E019ull;
