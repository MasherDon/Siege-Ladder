diff --git a/ggml/src/ggml-cuda/mmq-load-tiles.cuh b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
index 8ed704c..47d9021 100644
--- a/ggml/src/ggml-cuda/mmq-load-tiles.cuh
