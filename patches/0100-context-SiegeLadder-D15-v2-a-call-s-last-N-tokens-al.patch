--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1051,9 +1051,18 @@ void llama_context::sched_reserve() {
     auto reserve_dense = [&](uint32_t n_tok, uint32_t n_out) {
         std::vector<size_t> sizes_dense(backend_ptrs.size(), 0);
 
+        // SiegeLadder D12 + D15: a shape whose full widths did not fit once is reserved capped from then on - every
+        // phase change of P1 reserves again, and the failing attempt cost a graph build and a cudaMalloc each time
+        // (256K at -ub 8192: a reserve 1.6-2.5 s against 0.2-0.75, a 2.8K agent turn +1.7 s; runs.md 4.254)
+        const uint64_t key = ((uint64_t) n_tok << 1) | (cparams.dsv4_enc_only ? 1u : 0u);
+        const bool capped_before = d12_capped.count(key) > 0;
+
         cparams.dsv4_reserve_dense = true;
-        auto * gf = graph_reserve(n_tok, n_seqs, n_out, mctx.get(),
-                model.hparams.no_alloc, model.hparams.no_alloc ? sizes_dense.data() : nullptr);
+        ggml_cgraph * gf = nullptr;
+        if (!capped_before) {
+            gf = graph_reserve(n_tok, n_seqs, n_out, mctx.get(),
+                    model.hparams.no_alloc, model.hparams.no_alloc ? sizes_dense.data() : nullptr);
+        }
 
         // SiegeLadder D12: at 512K+ that graph at the full compressed widths asks 8-10 GiB (runs.md 4.216), but on one
         // sequence only its first ubatches - below ~1024 + -ub positions - ever take it: reserve it for them
@@ -1065,10 +1074,13 @@ void llama_context::sched_reserve() {
                 llm_graph_dsv4_set_dense_cap(mctx.get(), 0);
                 if (gf) {
                     cparams.dsv4_dense_cap = std::max(cparams.dsv4_dense_cap, n_pos);
-                    LLAMA_LOG_WARN("%s: SiegeLadder D12: the non-sparse pp graph%s does not fit at the full compressed "
-                            "widths - reserved for positions below %u, where a sequence's first ubatches take it; a "
-                            "non-sparse ubatch past them would need more\n", __func__,
-                            cparams.dsv4_enc_only ? " (encoder only)" : "", n_pos);
+                    if (!capped_before) {
+                        d12_capped.insert(key);
+                        LLAMA_LOG_WARN("%s: SiegeLadder D12: the non-sparse pp graph%s at %u tokens does not fit at the "
+                                "full compressed widths - reserved for positions below %u, where a sequence's first "
+                                "ubatches take it; a non-sparse ubatch past them would need more\n", __func__,
+                                cparams.dsv4_enc_only ? " (encoder only)" : "", n_tok, n_pos);
+                    }
                 }
             }
         }
@@ -1092,28 +1104,44 @@ void llama_context::sched_reserve() {
     // SiegeLadder D15: P4's encoder-only graph at the full -ub (and its non-sparse plan, as D10 above). The log gives
