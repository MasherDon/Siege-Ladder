         if (gf && dsv4_dense) {
             try {
-                reserve_dense(n_tokens, n_out_enc);
+                reserve_dense(n_wide, n_out_enc);
             } catch (...) {
                 cparams.dsv4_enc_only = false;
                 throw;
@@ -2540,9 +2568,13 @@ int llama_context::decode(const llama_batch & batch_inp) {
     }
 
     // SiegeLadder D15: the leading tokens of the call that P4 runs encoder-only - no output, every sequence's position below
-    // its p4_dec_start - go in ubatches of -ub, everything from the first other token on in ubatches of d15_ub_full. A last
-    // wide ubatch shorter than p4_min would run the whole model at a width the buffers may not hold: it goes narrow too
+    // its p4_dec_start - go in ubatches of the encoder-only width, the rest in ubatches of d15_ub_full; the call's last
+    // d15_ub_full tokens always go narrow, so that a call that fits one whole-model ubatch stays one (a 2.8K agent turn
