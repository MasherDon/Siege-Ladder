+    // goes narrow too
     if (d15_ub_full > 0) {
+        const uint32_t ub_wide = d15_ub_wide > 0 ? d15_ub_wide : cparams.n_ubatch;
         uint32_t n_wide = 0;
         if (p4_reach > 0) {
             const llama_batch & b = balloc->get_batch();
@@ -2557,12 +2589,13 @@ int llama_context::decode(const llama_batch & batch_inp) {
                 }
                 n_wide++;
             }
-            const uint32_t tail = n_wide % cparams.n_ubatch;
