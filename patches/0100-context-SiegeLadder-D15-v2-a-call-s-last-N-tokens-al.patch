+        uint32_t n_wide = d15_ub_wide > 0 ? std::min(d15_ub_wide, n_tokens) : n_tokens;
+        uint32_t n_out_enc = std::min(n_wide, cparams.n_outputs_max);
+        // the sizes, once per width pair (two graph builds each time a phase of P1 changed - see d12_capped)
+        if (d15_logged != (((uint64_t) n_wide << 32) | n_tok_pp)) {
+            d15_logged = ((uint64_t) n_wide << 32) | n_tok_pp;
+            std::vector<size_t> s_enc(backend_ptrs.size(), 0);
