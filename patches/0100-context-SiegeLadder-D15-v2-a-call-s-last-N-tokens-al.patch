-        for (size_t i = 0; i < backend_ptrs.size(); ++i) {
-            if (s_enc[i] > 1 || s_full[i] > 1) {
-                LLAMA_LOG_WARN("%s: SiegeLadder D15: %10s pp graph - encoder only at %u tokens %8.1f MiB, the whole model "
-                        "at %u %8.1f MiB (sparse plans)\n", __func__, ggml_backend_buft_name(backend_buft[i]), n_tokens,
-                        s_enc[i]/1048576.0, n_tok_pp, s_full[i]/1048576.0);
