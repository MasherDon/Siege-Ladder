From 7b18534eff1edad6de3efa41897d8a67e0a95b09 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Wed, 14 Oct 2026 17:46:33 +0000
Subject: [PATCH 12/92] moe-stream : NVTX ranges for prefill waves

stage_wave_locked is now a `wave` range on the graph thread and its wait for the wave's loads a `wave.stall`
range, both with the layer as payload, so a prefill can be split in Nsight Systems the way decode already
is (SiegeLadder bench/prefill_nsys.py, bench/nsys_waves.py). No cost without a profiler attached.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-moe-stream.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index 01511b8..4be9ea9 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -1865,6 +1865,7 @@ void llama_moe_stream::plan_waves_locked(llama_moe_stream_layer & sl, const int3
 // preload the next wave so its loads overlap this wave's compute. leaves sl.demand_slots = this wave's
 // slots and sl.plan_pool = the resident parking pool (>= n_ids slots) the emit draws masked pairs from
 void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llama_moe_stream_layer & sl, int32_t w, uint32_t n_ids) {
+    moe_nvtx_range nvtx_wave("wave", sl.il); // prefill profile (SiegeLadder bench/prefill_nsys.py)
     const size_t first = (size_t) w*sl.plan_capacity;
     const size_t count = first < sl.uniq.size() ? std::min<size_t>(sl.plan_capacity, sl.uniq.size() - first) : 0;
 
@@ -1958,6 +1959,7 @@ void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llam
 
     if (waited) {
         const int64_t t0 = ggml_time_us();
+        moe_nvtx_push("wave.stall", sl.il);
         cv_done.wait(lk, [&]{
             if (load_failed) {
                 return true;
@@ -1969,6 +1971,7 @@ void llama_moe_stream::stage_wave_locked(std::unique_lock<std::mutex> & lk, llam
             }
             return true;
         });
+        moe_nvtx_pop();
         if (load_failed) {
             GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
         }
