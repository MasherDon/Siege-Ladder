diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index a5433d9..b7c22df 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1350,7 +1350,12 @@ static bool llama_moe_stream_resolve_slots(const llama_model_params & params, co
         return true;
     }
 
-    const uint32_t n_min = llama_moe_stream_min_slots(hparams.n_expert_used);
+    // skipping waves need 2*n_expert_used slots, parking ones 3*n_expert_used (llama_moe_stream_min_slots). Skipping
+    // is on unless LLAMA_MOE_STREAM_WAVE_SKIP=0 - the same test as the ctor's; a backend that cannot skip (not CUDA)
+    // turns it off later, and alloc_bufs refuses a cache smaller than parking needs then
+    const char *   skip_env = std::getenv("LLAMA_MOE_STREAM_WAVE_SKIP");
+    const bool     skip_ok  = skip_env == nullptr || std::atoi(skip_env) != 0;
