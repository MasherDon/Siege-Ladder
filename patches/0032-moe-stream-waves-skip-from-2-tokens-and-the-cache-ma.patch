     uint32_t n_slots = params.moe_stream_slots;
     const char * source = "--moe-stream-cache <N>s";
diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index 5205996..16783f8 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -607,6 +607,10 @@ llama_moe_stream::llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n
         const char * s = std::getenv("LLAMA_MOE_STREAM_WAVE_SKIP");
         wave_skip = s == nullptr || std::atoi(s) != 0;
     }
+    // the smallest batch that skips; see skip_min_tokens in the header (64 = before 17.10)
+    if (const char * s = std::getenv("LLAMA_MOE_STREAM_SKIP_MIN")) {
+        skip_min_tokens = std::max<int64_t>(2, std::strtoll(s, nullptr, 10));
+    }
 
     // Router bias toward resident experts. Read once here rather than per call so a run cannot
     // change policy halfway through and leave counters that describe two different experiments.
@@ -701,16 +705,19 @@ void llama_moe_stream::attach_backend(ggml_backend_t backend) {
     // process's VRAM budget is all the CUDA pool can grow into (with "Prefer No Sysmem Fallback" a growth past it
     // is a crash in the middle of a prompt: -ub 2048 at 12K, runs.md 4.43)
     {
+        // The DXGI budget is not the limit: runs went 100-440 MiB past it. What failed, in every configuration
+        // probed (SiegeLadder runs.md 4.44, RTX 5070 Ti, driver 617.42), was ~330 MiB short of the dedicated size.
+        const double limit_margin = 330.0;
         const llama_wddm_budget wb = llama_wddm_query_budget();
         if (wb.ok) {
-            const double headroom = ((double) wb.local_budget - (double) wb.local_usage)/1048576.0;
-            LLAMA_LOG_INFO("%s: WDDM budget of %s: VRAM %.0f of %.0f MiB in use (dedicated %.0f), %.0f MiB left for "
-                    "the CUDA pool; shared %.0f of %.0f MiB\n", __func__, wb.name, wb.local_usage/1048576.0,
-                    wb.local_budget/1048576.0, wb.dedicated/1048576.0, headroom, wb.nonlocal_usage/1048576.0,
+            const double headroom = ((double) wb.dedicated - (double) wb.local_usage)/1048576.0 - limit_margin;
+            LLAMA_LOG_INFO("%s: WDDM (%s): VRAM %.0f MiB in use, dedicated %.0f, DXGI budget %.0f; about %.0f MiB "
+                    "left for the CUDA pool; shared %.0f of %.0f MiB\n", __func__, wb.name, wb.local_usage/1048576.0,
+                    wb.dedicated/1048576.0, wb.local_budget/1048576.0, headroom, wb.nonlocal_usage/1048576.0,
                     wb.nonlocal_budget/1048576.0);
-            if (headroom < 256.0) {
-                LLAMA_LOG_WARN("%s: only %.0f MiB of the VRAM budget left after load - a prompt batch that grows the "
-                        "CUDA pool past it fails under \"Prefer No Sysmem Fallback\" (a smaller -ub needs less)\n",
+            if (headroom < 128.0) {
+                LLAMA_LOG_WARN("%s: only about %.0f MiB of VRAM left after load - a prompt batch that grows the CUDA "
+                        "pool past it fails under \"Prefer No Sysmem Fallback\" (a smaller -ub needs less)\n",
                         __func__, headroom);
             }
         }
@@ -1175,12 +1182,18 @@ void llama_moe_stream::alloc_bufs(bool no_alloc) {
         // skipped pairs carry an out-of-range id that only the CUDA mul_mat_id knows to leave out;
         // any other backend would index past the cache with it
         if (ggml_backend_buft_is_host(buft) || std::strncmp(ggml_backend_buft_name(buft), "CUDA", 4) != 0) {
+            if (wave_skip) {
+                // the slot count was resolved for skipping (2*n_expert_used); parking needs 3*n_expert_used, and
+                // a smaller cache stops at the wave plan's assert on the first batch that needs waves
+                LLAMA_LOG_WARN("%s: %s cannot skip pairs: waves park them, which needs 3*n_expert_used slots "
+                        "(%u per layer here)\n", __func__, ggml_backend_buft_name(buft), n_slots);
+            }
             wave_skip = false;
         }
     }
     if (!no_alloc) {
-        LLAMA_LOG_INFO("%s: multi-pass prefill: pairs outside a wave are %s\n", __func__,
-                wave_skip ? "skipped (from 64 tokens)" : "parked and masked");
+        LLAMA_LOG_INFO("%s: multi-pass prefill: pairs outside a wave are %s (from %lld tokens)\n", __func__,
+                wave_skip ? "skipped" : "parked and masked", (long long) (wave_skip ? skip_min_tokens : 2));
     }
 
     // The host tier is allocated here and not in the constructor: max_nb_expert only exists once
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
index 26421af..36c07b2 100644
--- a/src/llama-moe-stream.h
+++ b/src/llama-moe-stream.h
@@ -219,8 +219,13 @@ struct llama_moe_stream_work {
 // discovered inside graph building instead, on the first batch that touched more experts than the
 // cache holds - measured 2026-08-03 in runs/2026-08-03/stream-a1-on/run-01.raw.txt as
 // "have 16, need 18", where 16 was what the DEFAULT resolved to.
-static inline uint32_t llama_moe_stream_min_slots(uint32_t n_expert_used) {
-    return 3*n_expert_used;
+//
+// skip: the waves skip the pairs outside them (llama_moe_stream_wave_skip) - no parking slots, a wave takes half
+// the cache and the next wave's preload the other half, so n_slots >= 2*n_expert_used. SiegeLadder 17.10 (runs.md
+// 4.45): once the MMVQ kernels left skipped ids out as well, every batch of two tokens or more could skip, and a
+// cache of 17 slots - 380 MiB below the 18 the parking rule asked for at K = 6 - became possible.
+static inline uint32_t llama_moe_stream_min_slots(uint32_t n_expert_used, bool skip = false) {
+    return (skip ? 2 : 3)*n_expert_used;
 }
 
 // Worst-case wave plan for one ubatch. cap is experts per wave, n_waves passes over the expert
@@ -261,7 +266,7 @@ static inline llama_moe_stream_wave_budget llama_moe_stream_wave_plan(
         return b; // everything this ubatch can touch is already resident-able: one pass
     }
 
-    GGML_ASSERT(n_slots >= llama_moe_stream_min_slots(n_expert_used));
+    GGML_ASSERT(n_slots >= llama_moe_stream_min_slots(n_expert_used, skip));
 
     b.split   = true;
     b.cap     = skip ? n_slots/2 : (n_slots - n_expert_used)/2;
@@ -450,6 +455,10 @@ struct llama_moe_stream {
     // expert caches live in a CUDA buffer, the one backend whose mul_mat_id handles skipped ids.
     // Exact either way - it changes which GEMM rows run, not what the model computes.
     bool wave_skip = false;
+    // The smallest batch that skips (LLAMA_MOE_STREAM_SKIP_MIN, default 2). It was 64: below that a batch may take
+    // the MMVQ path, whose kernels used to index the expert by id with no range check (SiegeLadder 17.10, runs.md
+    // 4.45: they leave skipped ids out now). 64 brings the old behaviour back, for A/B.
+    int64_t skip_min_tokens = 2;
 
     llama_files files; // privately reopened GGUF files, same indices as the loader's
 
@@ -789,15 +798,15 @@ struct llama_moe_stream {
 // leaves it out of the GEMM (the MMQ id helper never matches it), and op_params[2] = 1 on the down
 // projection zeroes its rows of dst, so the wave outputs add up without a mask.
 //
-// Only from LLAMA_MOE_STREAM_SKIP_MIN_TOKENS tokens: below that the CUDA backend can take the MMVQ
-// path, whose kernels index the expert by id with no range check.
-static const int32_t LLAMA_MOE_STREAM_SKIP_ID         = INT32_MAX;
-static const int64_t LLAMA_MOE_STREAM_SKIP_MIN_TOKENS = 64;
+// From llama_moe_stream::skip_min_tokens tokens (2 by default since SiegeLadder 17.10): it used to be
+// 64, because below that the CUDA backend can take the MMVQ path, whose kernels indexed the expert by
+// id with no range check. They leave an id at or past LLAMA_MOE_STREAM_SKIP_ID out now (mmvq.cu).
+static const int32_t LLAMA_MOE_STREAM_SKIP_ID = INT32_MAX;
 
 // The one place the mode is decided. The graph (mask or no mask) and the wave ids op (park or
 // skip) must agree, or parked pairs would be summed unmasked.
 static inline bool llama_moe_stream_wave_skip(const llama_moe_stream_layer & sl, int64_t n_tokens) {
-    return sl.mgr->wave_skip && sl.wave_skip_ok && n_tokens >= LLAMA_MOE_STREAM_SKIP_MIN_TOKENS;
+    return sl.mgr->wave_skip && sl.wave_skip_ok && n_tokens >= sl.mgr->skip_min_tokens;
 }
 
 // callback of the id-remapping custom op inserted by build_moe_ffn
