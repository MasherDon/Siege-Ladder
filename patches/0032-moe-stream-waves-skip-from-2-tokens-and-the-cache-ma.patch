From e830016ac25d51f4d57111717658bb75cb1b5470 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Sat, 17 Oct 2026 07:49:48 +0000
Subject: [PATCH 32/91] moe-stream : waves skip from 2 tokens and the cache may
 have 2*K slots - the MMVQ kernels leave skipped ids out (an id at or past
 INT32_MAX), LLAMA_MOE_STREAM_SKIP_MIN (default 2, 64 = before); the node
 budget plans with skipping below 3*K; the load-time VRAM note uses the probed
 limit (dedicated - 330 MiB), LLAMA_GRAPH_TOP=N lists the largest tensors of
 the pp graph

17 slots instead of 18 free 380 MiB: -ub 2048 at 12K fits again under "Prefer No Sysmem Fallback" (162 tok/s on an 8.9K prompt), decode within noise (13.25 vs 13.39 tok/s, text = trace). Small batches: -ub 4 (MMVQ) parking, skipping and 17 slots give the same numbers bit for bit; -ub 32 (MMQ) KL 0.0073 vs 0.0075 for parking. MUL_MAT_ID 877/877.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmvq.cu | 12 ++++++++++
 src/llama-context.cpp      | 45 +++++++++++++++++++++++++++++++++++++-
 src/llama-graph.cpp        |  2 +-
 src/llama-model.cpp        |  7 +++++-
 src/llama-moe-stream.cpp   | 31 ++++++++++++++++++--------
 src/llama-moe-stream.h     | 25 ++++++++++++++-------
 6 files changed, 102 insertions(+), 20 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 0589e65..cced12c 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -517,6 +517,13 @@ static __global__ void mul_mat_vec_q(
     channel_y  = ncols_dst == 1 && ids ? fastmodulo(channel_dst, nchannels_y) : channel_dst;
     sample_dst = blockIdx.z;
 
+    // SiegeLadder (17.10, runs.md 4.45): an id at or past INT32_MAX is a pair left out of the product - the skip
+    // marker of llama-moe-stream's multi-pass prefill, which the MMQ id helper never matches. The whole block shares
+    // channel_dst, so it leaves together, before any barrier, and dst keeps what it had.
+    if (ncols_dst == 1 && ids && channel_x >= 0x7FFFFFFFu) {
+        return;
+    }
+
     const uint32_t sample_x    = fastdiv(sample_dst, sample_ratio);
     const uint32_t sample_y    = sample_dst;
 
@@ -740,6 +747,11 @@ static __global__ void mul_mat_vec_q_moe(
     const uint32_t channel_x = ids[channel_dst + token_idx * ids_stride];
     const uint32_t channel_y = fastmodulo(channel_dst, nchannels_y);
 
+    // a skipped pair (see mul_mat_vec_q): each warp works alone, so this one just stops
+    if (channel_x >= 0x7FFFFFFFu) {
+        return;
+    }
+
     const block_q8_1 * y = ((const block_q8_1 *) vy) + channel_y*stride_channel_y + token_idx*stride_col_y;
     const int kbx_offset  = channel_x*stride_channel_x + row0*stride_row_x;
 
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 8ef7565..843f99b 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -13,8 +13,10 @@
 #include "llama-ext.h"
 #include "llama.h"
 
+#include <algorithm>
 #include <cinttypes>
 #include <cmath>
+#include <cstdlib>
 #include <cstring>
 #include <limits>
 #include <stdexcept>
@@ -683,6 +685,43 @@ void llama_context::sched_reserve() {
 
         n_splits_pp = ggml_backend_sched_get_n_splits(sched.get());
         n_nodes_pp  = ggml_graph_n_nodes(gf);
+
+        // SiegeLadder (M11, runs.md 4.43): LLAMA_GRAPH_TOP=N prints the N largest kinds of tensor the pp graph
+        // computes (name without the layer suffix, largest size, how many) - what fills the compute buffer at a
+        // large -ub. Sizes, not the allocator's peak: tensors of one kind mostly reuse the same memory.
+        if (const char * p = std::getenv("LLAMA_GRAPH_TOP")) {
+            struct kind { size_t max_nb = 0; int n = 0; const ggml_tensor * t = nullptr; };
+            std::map<std::string, kind> kinds;
+            for (int i = 0; i < ggml_graph_n_nodes(gf); i++) {
+                const ggml_tensor * t = ggml_graph_node(gf, i);
+                if (t->view_src != nullptr) {
+                    continue;
+                }
+                std::string name = t->name;
+                const size_t dash = name.rfind('-');
+                if (dash != std::string::npos && dash + 1 < name.size() &&
+                        name.find_first_not_of("0123456789", dash + 1) == std::string::npos) {
+                    name.resize(dash);
+                }
+                kind & k = kinds[name];
+                k.n++;
+                if (ggml_nbytes(t) > k.max_nb) {
+                    k.max_nb = ggml_nbytes(t);
+                    k.t      = t;
+                }
+            }
+            std::vector<std::pair<std::string, kind>> v(kinds.begin(), kinds.end());
+            std::sort(v.begin(), v.end(), [](const auto & a, const auto & b) { return a.second.max_nb > b.second.max_nb; });
+            const int top = std::max(1, atoi(p));
+            for (int i = 0; i < top && i < (int) v.size(); i++) {
+                const ggml_tensor * t = v[i].second.t;
+                ggml_backend_t      b = ggml_backend_sched_get_tensor_backend(sched.get(), const_cast<ggml_tensor *>(t));
+                LLAMA_LOG_INFO("%s: pp graph: %8.1f MiB  x%-4d %-34s %-16s %s [%lld, %lld, %lld, %lld] on %s\n", __func__,
+                        v[i].second.max_nb/1048576.0, v[i].second.n, v[i].first.c_str(), ggml_op_desc(t),
+                        ggml_type_name(t->type), (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2],
+                        (long long) t->ne[3], b ? ggml_backend_name(b) : "-");
+            }
+        }
     }
 
     // reserve with tg (token generation) graph to get the number of splits and nodes
@@ -2411,8 +2450,12 @@ uint32_t llama_context::graph_max_nodes(uint32_t n_tokens) const {
         // multi-pass streamed prefill adds a bounded number of extra nodes per wave per streamed
         //   layer. Same plan as build_moe_ffn, from the same function, so the budget cannot drift
         //   away from the graph it is budgeting for.
+        //   The parking plan has more waves, so it bounds the skipping one - where the cache is big enough for
+        //   it at all: below 3*n_expert_used slots only skipping can run (SiegeLadder 17.10, 17 slots).
+        const uint32_t n_dyn   = mstream->n_slots - mstream->pin_budget;
+        const bool     bound_s = n_dyn < llama_moe_stream_min_slots(model.hparams.n_expert_used);
         const llama_moe_stream_wave_budget wb = llama_moe_stream_wave_plan(
-                mstream->n_slots - mstream->pin_budget, model.hparams.n_expert, model.hparams.n_expert_used, n_tokens);
+                n_dyn, model.hparams.n_expert, model.hparams.n_expert_used, n_tokens, bound_s);
         // only STREAMED layers produce wave nodes; layers[] carries a null for every other one
         uint32_t n_streamed = 0;
         for (const auto & sl : mstream->layers) {
