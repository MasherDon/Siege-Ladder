@@ -749,6 +756,16 @@ struct llama_moe_stream {
     // G30: the exact GEMMs reuse the pass's rows of the pairs resident at the first half (LLAMA_MOE_STREAM_RA_REUSE,
     // default on; 0 = the exact path recomputes all of them, as before). Needs ra_skip
     bool     ra_reuse        = true;
+    // G32: the real attention of layer L+1 left out of the compute when runahead's pass computed it exactly - every pair of
+    // layer L resident at the end of the first half (LLAMA_MOE_STREAM_G32: 0 off, the default - only counted; 1 on; 2 the
+    // block and its copies built, never left out: A/B of the copies). See llm_graph_g32 and the model graph (deepseek4)
+    int32_t  g32             = 0;
