                 model.layers[il].hc_ffn_fn,
@@ -2619,10 +2693,62 @@ llama_model_deepseek4::graph::graph(const llama_model & model, const llm_graph_p
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
