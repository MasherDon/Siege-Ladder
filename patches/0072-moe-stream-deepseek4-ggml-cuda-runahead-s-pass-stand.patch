+++ b/src/llama-context.cpp
@@ -1795,9 +1795,22 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
 
+    // SiegeLadder G32: this graph's attention blocks that runahead's first halves may leave out, bound for this compute
+    // only - a reused graph binds its own again, a reserve graph is never bound, and every flag taken off is given back
+    // once all splits are launched (the flags matter only to the launches and captures)
+    llama_moe_stream * g32_ms = res->g32.empty() ? nullptr : model.moe_stream();
+    if (g32_ms != nullptr) {
+        for (const auto & g : res->g32) {
+            g32_ms->g32_bind_layer(g.il, &g.nodes);
+        }
+    }
+
     llama_moe_stream_nvtx_push("graph_compute");
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
     llama_moe_stream_nvtx_pop();
+    if (g32_ms != nullptr) {
+        g32_ms->g32_unbind();
+    }
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
         ret = status;
