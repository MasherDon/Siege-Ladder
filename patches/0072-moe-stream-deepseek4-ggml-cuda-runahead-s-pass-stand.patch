index c1b6a19..7a68a78 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2627,7 +2627,22 @@ static bool ggml_cuda_graph_check_compability(ggml_cgraph * cgraph) {
 }
 
 static const void * ggml_cuda_graph_get_key(ggml_cgraph * cgraph) {
-    return cgraph->nodes[0];
+    // SiegeLadder G32: the host may take nodes of a split out of a compute (GGML_TENSOR_FLAG_COMPUTE off, set between the
+    // splits); each pattern of left-out nodes is a CUDA graph of its own, so the two patterns of a split neither replay
+    // each other's capture nor re-capture when they alternate. The node properties compared below include the flags, so
+    // a shared key would only cost captures, never a wrong replay. No left-out node - the first node, as before; else an
+    // address inside the first node's own struct, which no other split's key can be
+    uint64_t sig = 0;
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 && !ggml_cuda_is_view_or_noop(node)) {
+            sig = (sig ^ (uint64_t) (i + 1))*0x100000001b3ull;
+        }
+    }
+    if (sig == 0) {
+        return cgraph->nodes[0];
+    }
+    return (const char *) cgraph->nodes[0] + 1 + sig % (sizeof(ggml_tensor) - 1);
 }
 
 static bool ggml_cuda_graph_update_required(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph) {
