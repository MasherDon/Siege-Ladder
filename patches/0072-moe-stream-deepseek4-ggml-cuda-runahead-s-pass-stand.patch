     // the expert caches live where mul_mat_id can leave pairs out (a CUDA buffer): wave skipping and ra_skip need it
     bool     skip_capable    = true;
     // How good must a predictor be (2026-10-15): the oracle's staging keeps each expert of a call with this
@@ -1044,6 +1061,9 @@ struct llama_moe_stream {
         int64_t n_ra_reused   = 0; // G30: pairs whose exact row was the approximate pass's (skipped by the exact GEMMs)
         int64_t n_ra_full     = 0; // G32 (measurement): calls whose every pair was resident at the end of the first half -
                                    // the pass's input to the next layer is then exactly the real one
+        int64_t n_g32_calls   = 0; // G32: calls whose next layer's real attention block was eligible (g32_counted)
+        int64_t n_g32_full    = 0; // of those, the pass's attention was exact (all pairs resident, no substitute, mask 1)
+        int64_t n_g32_skip    = 0; // of those, the real block was left out of the compute (G32=1)
         int64_t t_ra_gap_us   = 0; // time from the end of the first half to the start of the second (the approximate pass)
