+        if (stats.n_g32_calls > 0) {
+            LLAMA_LOG_WARN("%s: %smoe stream: runahead: G32 - of %" PRId64 " calls whose next layer's attention the pass "
+                    "computes in full, %" PRId64 " (%.1f%%) had it exact; %" PRId64 " left the real one out of the compute "
+                    "(LLAMA_MOE_STREAM_G32=%d)\n", __func__, pfx, stats.n_g32_calls, stats.n_g32_full,
+                    100.0*stats.n_g32_full/stats.n_g32_calls, stats.n_g32_skip, g32);
+        }
     }
     if (stats.n_calls > 0) {
         // G21: the lock the I/O workers take for every slab they pick up and publish; a remap waits for it on the
@@ -3719,10 +3734,60 @@ static void moe_stream_runahead_issue_locked(llama_moe_stream & mgr, llama_moe_s
     if (!sl.ra_valid) {
         mgr.stats.n_ra_invalid++;
     }
+    // G32: every pair reads its own expert in the pass at multiplier 1 (no substitute), and the exact path's multipliers
+    // are 1 too (the drop rule's, with runahead next to it: nothing resident is dropped, nothing renormalised) - the
+    // pass's MoE of this layer is the exact one, so its attention of the next layer is the real one. Before the card
+    // split that holds the real one is launched (two host splits later), its block leaves the compute: the CUDA backend
+    // skips nodes without GGML_TENSOR_FLAG_COMPUTE, and a CUDA graph of the split is captured per pattern of them
+    if (sl.g32_counted) {
+        mgr.stats.n_g32_calls++;
+        bool exact_ones = true;
+        for (const float f : sl.exact_mask) {
+            exact_ones = exact_ones && f == 1.0f;
+        }
+        if (n_kept == n && sl.ra_valid && sub == nullptr && exact_ones) {
+            mgr.stats.n_g32_full++;
+            if (mgr.g32 == 1 && sl.g32_nodes != nullptr) {
+                for (ggml_tensor * t : *sl.g32_nodes) {
+                    if (t->flags & GGML_TENSOR_FLAG_COMPUTE) {
+                        t->flags &= ~GGML_TENSOR_FLAG_COMPUTE;
+                        mgr.g32_cleared.push_back(t);
+                    }
+                }
+                mgr.stats.n_g32_skip++;
+            }
+        }
+    }
     mgr.fence_slots_locked(sl, out, (size_t) n);
     sl.ra_t_issue = ggml_time_us();
 }
 
+// G32: bound around each compute by llama_context::process_ubatch - the graph's eligible blocks (llm_graph_g32) to the
+// layers whose first half decides, then every flag taken off during the compute given back and the bindings dropped
+void llama_moe_stream::g32_bind_layer(int32_t il, const std::vector<ggml_tensor *> * nodes) {
+    llama_moe_stream_layer * sl = layer(il);
+    if (sl == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lk(mtx);
+    sl->g32_counted = true;
+    sl->g32_nodes   = nodes != nullptr && !nodes->empty() ? nodes : nullptr;
+}
+
+void llama_moe_stream::g32_unbind() {
+    std::lock_guard<std::mutex> lk(mtx);
+    for (ggml_tensor * t : g32_cleared) {
+        t->flags |= GGML_TENSOR_FLAG_COMPUTE;
+    }
+    g32_cleared.clear();
+    for (auto & sl : layers) {
+        if (sl) {
+            sl->g32_counted = false;
+            sl->g32_nodes   = nullptr;
+        }
+    }
+}
