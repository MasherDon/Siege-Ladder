+    // computes it in full); g32_nodes - that block's nodes, which the first half takes out of the compute when every pair
+    // of the call is resident (LLAMA_MOE_STREAM_G32=1), null when they were not built (G32=0)
+    bool                               g32_counted = false;
+    const std::vector<ggml_tensor *> * g32_nodes   = nullptr;
+
