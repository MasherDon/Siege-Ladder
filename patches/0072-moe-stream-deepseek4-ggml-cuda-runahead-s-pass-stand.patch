 };
 
+// SiegeLadder G32 (DeepSeek V4.1 runahead, decode): the real attention block of layer il + 1, which the first half of
+// layer il's remap may leave out of the compute (GGML_TENSOR_FLAG_COMPUTE off) when runahead's pass computed it exactly.
+// nodes: the block's nodes in graph order, the copies of its results into the pass's tensors last; empty - the layer is
+// only counted (LLAMA_MOE_STREAM_G32=0). Bound to the expert stream for one compute by llama_context::process_ubatch
+struct llm_graph_g32 {
+    int32_t il = -1;
+    std::vector<ggml_tensor *> nodes;
+};
