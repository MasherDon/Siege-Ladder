+
+// G2 runahead, the end of the first half: the slots the approximate pass may read. A pair whose expert is resident
+// now - it was when the call came, or all its copies were enqueued since - reads its own slot; any other pair reads
+// a resident slot of its token, or else of the layer, at weight 0 (drop_mask, copied out by llama_moe_stream_drop_mask).
+// Those slots are kept, so no victim is taken from them before the next call of this layer, and fenced, so the pass
+// waits on the device for their copies. With no resident slot in the layer at all (cold start) the pass reads a slot
+// that may be loading: it still runs, but its prediction is not staged (ra_valid).
+static void moe_stream_runahead_issue_locked(llama_moe_stream & mgr, llama_moe_stream_layer & sl, const int32_t * ids,
+        int64_t n, int64_t k, int32_t * out) {
+    sl.ra_ids.assign(ids, ids + n);
+    sl.ra_pending = true;
+    sl.ra_valid   = true;
+    sl.drop_mask.assign((size_t) n, 1.0f);
+
+    int64_t n_kept = 0;
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t s = sl.expert_slot.at(ids[i]);
+        if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+            out[i] = s;
+            n_kept++;
+        } else {
+            out[i] = -1;
+            sl.drop_mask[i] = 0.0f;
+        }
+    }
+    int32_t any_resident = -1;
+    for (int64_t i = 0; i < n; i++) {
+        if (out[i] >= 0) {
+            continue;
+        }
+        const int64_t t0 = (i/k)*k;
+        for (int64_t j = t0; j < t0 + k; j++) {
+            if (sl.drop_mask[j] != 0.0f) {
+                out[i] = out[j];
+                break;
+            }
+        }
+        if (out[i] < 0) {
+            for (uint32_t s = 0; any_resident < 0 && s < sl.n_slots; s++) {
+                if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    any_resident = (int32_t) s;
+                }
+            }
+            if (any_resident >= 0) {
+                out[i] = any_resident;
+                sl.keep[any_resident] = 1;
+            } else {
+                out[i] = 0;
+                sl.ra_valid = false;
+            }
+        }
+    }
+    mgr.stats.n_ra_calls++;
+    mgr.stats.n_ra_pairs += n;
+    mgr.stats.n_ra_kept  += n_kept;
+    if (!sl.ra_valid) {
+        mgr.stats.n_ra_invalid++;
+    }
+    mgr.fence_slots_locked(sl, out, (size_t) n);
+    sl.ra_t_issue = ggml_time_us();
+}
+
 static void moe_stream_remap_impl(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor * pred,
-        const ggml_tensor * wts, void * userdata) {
+        const ggml_tensor * wts, void * userdata, bool issue_only) {
     auto * sl  = (llama_moe_stream_layer *) userdata;
     auto * mgr = sl->mgr;
 
@@ -2638,6 +2737,14 @@ static void moe_stream_remap_impl(ggml_tensor * dst, const ggml_tensor * a, cons
         mgr->predict_locked(*sl, (const int32_t *) pred->data, pred->ne[0], pred->ne[1]);
     }
 
+    if (issue_only) {
+        // G2 runahead: counted, classified, its loads queued; llama_moe_stream_remap_wait waits for them once the
+        // graph has computed the approximate pass on what is resident
+        GGML_ASSERT(sl->dropped.empty());
+        moe_stream_runahead_issue_locked(*mgr, *sl, ids, n, a->ne[0], out);
+        return;
+    }
+
     if (waited) {
         moe_nvtx_range r_stall("stall", sl->il);
         const int64_t t0 = ggml_time_us();
@@ -2703,6 +2810,99 @@ static void moe_stream_remap_impl(ggml_tensor * dst, const ggml_tensor * a, cons
     mgr->fence_slots_locked(*sl, out, (size_t) n);
 }
 
+// G2 runahead, second half: the prediction of the next layer is staged as A' stages its own (predict_locked) - after
+// this call's loads, which the first half queued, so they stay first in line - then the call waits for its loads and
+// hands its slots to the exact expert GEMMs, as the remap does. Its experts were kept since the first half and
+// nothing stages into this layer in between, so each still holds the slot it was given; one that does not is
+// loaded again (counted in n_ra_redo).
+void llama_moe_stream_remap_wait(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+    auto * sl  = (llama_moe_stream_layer *) userdata;
+    auto * mgr = sl->mgr;
+    const ggml_tensor * pred = dst->src[1];
+
+    moe_nvtx_range r_wait("remap_wait", sl->il);
+
+    GGML_ASSERT(dst->type == GGML_TYPE_I32 && ggml_is_contiguous(dst));
+    GGML_ASSERT(pred != nullptr && pred->type == GGML_TYPE_I32 && ggml_is_contiguous(pred) && pred->ne[1] == dst->ne[1]);
+
+    const int64_t n   = ggml_nelements(dst);
+    int32_t     * out = (int32_t *) dst->data;
+
+    std::unique_lock<std::mutex> lk(mgr->mtx);
+
+    if (mgr->load_failed) {
+        GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+    }
+    GGML_ASSERT(sl->ra_pending && (int64_t) sl->ra_ids.size() == n && "runahead: the second half of a remap without its first");
+    sl->ra_pending = false;
+    mgr->stats.t_ra_gap_us += ggml_time_us() - sl->ra_t_issue;
+
+    if (sl->ra_valid && (mgr->ra_debug & 1) == 0) {
+        moe_nvtx_range r_pred("predict", sl->il);
+        mgr->predict_locked(*sl, (const int32_t *) pred->data, pred->ne[0], pred->ne[1]);
+    }
+
+    sl->demand_slots.clear();
+    bool waited = false;
+    for (const int32_t e : sl->uniq) {
+        const auto it = sl->expert_slot.find(e);
+        int32_t s = -1;
+        if (it != sl->expert_slot.end()) {
+            s = it->second;
+        } else {
+            int32_t v = mgr->pick_victim_locked(*sl, sl->keep.data());
+            while (v < 0) {
+                mgr->cv_done.wait(lk);
+                if (mgr->load_failed) {
+                    GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+                }
+                v = mgr->pick_victim_locked(*sl, sl->keep.data());
+            }
+            mgr->reserve_slot_locked(*sl, e, v);
+            mgr->enqueue_slot_locked(*sl, e, v);
+            sl->keep[v] = 1;
+            mgr->stats.n_ra_redo++;
+            s = v;
+        }
+        if (sl->slot_state[s] != LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+            waited = true;
+        }
+        sl->demand_slots.push_back(s);
+    }
+
+    if (waited) {
+        moe_nvtx_range r_stall("stall", sl->il);
+        const int64_t t0 = ggml_time_us();
+        mgr->cv_done.wait(lk, [&]{
+            if (mgr->load_failed) {
+                return true;
+            }
+            for (const int32_t s : sl->demand_slots) {
+                if (sl->slot_state[s] != LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    return false;
+                }
+            }
+            return true;
+        });
+        if (mgr->load_failed) {
+            GGML_ABORT("MoE expert streaming: expert load failed (I/O error)");
+        }
+        mgr->stats.t_stall_us += ggml_time_us() - t0;
+    }
+
+    const int32_t * ids = sl->ra_ids.data();
+    for (int64_t i = 0; i < n; i++) {
+        const int32_t s = sl->expert_slot.at(ids[i]);
+        sl->slot_last_use[s] = ++sl->use_counter;
+        out[i] = s;
+    }
+    mgr->fence_slots_locked(*sl, out, (size_t) n);
+}
+
 // stable per-wave userdata; grows lazily and records the per-wave expert capacity (set at build)
 llama_moe_stream_wave * llama_moe_stream_layer::wave_userdata(int32_t wave, uint32_t capacity) {
     GGML_ASSERT(capacity >= 1 && capacity <= n_slots);
