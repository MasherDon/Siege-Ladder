+// 3a with a real predictor. pred is the model's guess of the next streamed layer's experts, [k, n_tok],
+// best first per token (DeepSeek V4.1: A' - the hyper-connection streams of layer L carried past FFN L
+// and attention L+1 as if both returned zero, then the router of L+1; 68-69% of the true six in its
+// top-6, 83-84% in its top-12; SiegeLadder runs.md 4.12). Distinct experts are taken in rank order over
+// the tokens; the first pred_vram per token are staged into VRAM slots of that layer exactly as the
+// oracle's staging does, the first pred_ram read ahead into the host tier. A wrong guess costs a load
+// and may evict an expert the call then misses; the math is untouched either way.
+void llama_moe_stream::predict_locked(const llama_moe_stream_layer & sl_now, const int32_t * pred, int64_t k, int64_t n_tok) {
+    llama_moe_stream_layer * sf = nullptr;
+    for (size_t il = (size_t) sl_now.il + 1; il < layers.size() && sf == nullptr; il++) {
+        sf = layers[il].get();
+    }
+    if (sf == nullptr || k <= 0 || n_tok <= 0) {
+        return;
+    }
+    stats.n_pred_calls++;
+
+    pred_seen.assign(sf->n_expert, 0);
+    pred_order.clear();
+    for (int64_t r = 0; r < k; r++) {
+        for (int64_t t = 0; t < n_tok; t++) {
+            const int32_t e = pred[t*k + r];
+            if (e >= 0 && (uint32_t) e < sf->n_expert && !pred_seen[e]) {
+                pred_seen[e] = 1;
+                pred_order.push_back(e);
             }
-            reserve_slot_locked(sf, e, v);
-            sf.slot_staged[v] = 1;
-            sf.keep[v]        = 1;
-            enqueue_slot_locked(sf, e, v, /*stage =*/ true);
-            stats.n_stage++;
         }
     }
+
+    const size_t n_vram = std::min(pred_order.size(), (size_t) pred_vram*(size_t) n_tok);
+    const size_t n_ram  = std::min(pred_order.size(), (size_t) pred_ram *(size_t) n_tok);
+    if (n_vram > 0) {
+        stage_experts_locked(*sf, pred_order.data(), n_vram);
+    }
+    // after staging: speculate_locked skips what now has a VRAM slot, so only the wider ranks are read ahead
+    for (size_t i = 0; i < n_ram; i++) {
+        speculate_locked(*sf, pred_order[i]);
+        stats.n_pred_spec++;
+    }
 }
 
