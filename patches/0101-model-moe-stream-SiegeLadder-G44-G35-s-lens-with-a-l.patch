+void llama_moe_stream::load_g44(int64_t n_embd, int64_t n_expert) {
+    const char * path = std::getenv("LLAMA_MOE_STREAM_G44");
+    if (path == nullptr || path[0] == '\0' || std::strcmp(path, "0") == 0) {
+        return;
+    }
+    if (g35_depth <= 0 || runahead_k > 0) {
+        LLAMA_LOG_WARN("%s: moe stream: LLAMA_MOE_STREAM_G44 needs G35's lens (G35 on, no runahead); ignored\n", __func__);
+        return;
+    }
+    // next to the expert caches: the first device (non-host) buffer type they live in
+    ggml_backend_buffer_type_t buft = nullptr;
+    for (auto & [b, c] : ctxs) {
+        if (!ggml_backend_buft_is_host(b)) {
+            buft = b;
+            break;
+        }
+    }
+    if (buft == nullptr) {
+        LLAMA_LOG_WARN("%s: moe stream: G44: no expert cache on a device to put the lens next to; ignored\n", __func__);
+        return;
+    }
+    ggml_context * meta = nullptr;
+    gguf_init_params gp = { /*.no_alloc =*/ true, /*.ctx =*/ &meta };
+    gguf_context_ptr gg { gguf_init_from_file(path, gp) };
+    if (!gg) {
+        LLAMA_LOG_WARN("%s: moe stream: G44: cannot read %s; ignored\n", __func__, path);
+        return;
+    }
+    ggml_context_ptr meta_ptr { meta };
+    const int64_t kd    = gguf_find_key(gg.get(), "g44.depth");
+    const int32_t depth = kd >= 0 ? (int32_t) gguf_get_val_u32(gg.get(), kd) : -1;
+    if (depth != g35_depth) {
+        LLAMA_LOG_WARN("%s: moe stream: G44: %s was fit for a lens %d calls ahead, G35 looks %d ahead; ignored\n",
+                __func__, path, depth, g35_depth);
+        return;
+    }
+    const size_t n_layer = layers.size();
+    ggml_init_params ip = {
+        /*.mem_size   =*/ ggml_tensor_overhead()*(n_layer + 1),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx { ggml_init(ip) };
+    std::vector<ggml_tensor *> lens(n_layer, nullptr);
+    std::vector<std::pair<ggml_tensor *, size_t>> todo; // the device tensor, its data's offset in the file
+    for (size_t il = 0; il < n_layer; ++il) {
+        const std::string name = format("g44.lens.%zu", il);
+        const ggml_tensor * src = ggml_get_tensor(meta, name.c_str());
+        if (src == nullptr) {
+            continue;
+        }
+        if (src->ne[0] != n_embd || src->ne[1] != n_expert || src->ne[2] != 1 || src->ne[3] != 1) {
+            LLAMA_LOG_WARN("%s: moe stream: G44: %s is %" PRId64 " x %" PRId64 ", the lens needs %" PRId64 " x %" PRId64
+                    "; ignored\n", __func__, name.c_str(), src->ne[0], src->ne[1], n_embd, n_expert);
+            return;
+        }
+        ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), src->type, n_embd, n_expert);
+        ggml_set_name(t, name.c_str());
+        lens[il] = t;
+        const int64_t ti = gguf_find_tensor(gg.get(), name.c_str());
+        todo.emplace_back(t, gguf_get_data_offset(gg.get()) + gguf_get_tensor_offset(gg.get(), ti));
+    }
+    if (todo.empty()) {
+        LLAMA_LOG_WARN("%s: moe stream: G44: no g44.lens.* tensors in %s; ignored\n", __func__, path);
+        return;
+    }
+    ggml_backend_buffer_ptr buf { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft) };
+    if (!buf) {
+        LLAMA_LOG_WARN("%s: moe stream: G44: cannot allocate the lens buffer in %s; ignored\n", __func__,
+                ggml_backend_buft_name(buft));
+        return;
+    }
+    ggml_backend_buffer_set_usage(buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    llama_file f(path, "rb");
+    std::vector<uint8_t> data;
+    for (auto & [t, offs] : todo) {
+        data.resize(ggml_nbytes(t));
+        f.seek(offs, SEEK_SET);
+        f.read_raw(data.data(), data.size());
+        ggml_backend_tensor_set(t, data.data(), 0, data.size());
+    }
+    g44_lens = std::move(lens);
+    g44_ctx  = std::move(ctx);
+    g44_buf  = std::move(buf);
+    LLAMA_LOG_WARN("%s: moe stream: G44: the lens %d calls ahead corrected for %zu source layers from %s (%s, %s %.1f MiB)\n",
+            __func__, g35_depth, todo.size(), path, ggml_type_name(todo[0].first->type),
+            ggml_backend_buffer_name(g44_buf.get()), ggml_backend_buffer_get_size(g44_buf.get()) / 1024.0 / 1024.0);
+}
