+    }
     cb(experts, "ffn_moe_down", il);
 
     if (down_exps_s) {
@@ -2487,7 +2492,11 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
                     args, n_args, llama_moe_stream_wave_ids, 1, msl->wave_userdata(w, stream_wave_cap));
             cb(ids_w, "ffn_moe_wave_ids", il);
 
-            ggml_tensor * e_w = build_expert_gemms(cur, ids_w);
+            // with skipping, every wave after the first writes its down GEMM in place into the first wave's
