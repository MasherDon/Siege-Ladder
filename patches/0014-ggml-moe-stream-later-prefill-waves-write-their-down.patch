 ggml/src/ggml-cuda/ggml-cuda.cu |  5 +++--
 ggml/src/ggml.c                 | 33 +++++++++++++++++++++++++++++++++
 src/llama-graph.cpp             | 28 ++++++++++++++++++++--------
 4 files changed, 65 insertions(+), 10 deletions(-)

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 35f0c44..cbd8fb8 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -1448,6 +1448,15 @@ extern "C" {
             struct ggml_tensor  * b,
             struct ggml_tensor  * ids);
 
+    // ggml_mul_mat_id in place into acc: writes only the rows of the pairs it computes (ids past the last
+    // matrix are left out and keep acc's rows). Multi-pass MoE prefill; CUDA only.
+    GGML_API struct ggml_tensor * ggml_mul_mat_id_into(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * as,
+            struct ggml_tensor  * b,
+            struct ggml_tensor  * ids,
+            struct ggml_tensor  * acc);
+
     // A: m columns, n rows,
     // B: p columns, n rows,
     // result is m columns, p rows
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 048c506..b91e5e6 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1878,8 +1878,9 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
     const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
 
     // An id past the last expert marks a pair left out of the product (llama-moe-stream multi-pass
-    // prefill). No path below writes its rows of dst; op_params[2] = 1 asks for them to read as zero.
-    if (ggml_get_op_params_i32(dst, 2) != 0) {
+    // prefill). No path below writes its rows of dst; op_params[2] = 1 asks for them to read as zero,
+    // 2 (ggml_mul_mat_id_into) leaves them as they are: dst is then a view of the previous pass's output.
+    if (ggml_get_op_params_i32(dst, 2) == 1) {
         CUDA_CHECK(cudaMemsetAsync(dst->data, 0, ggml_nbytes(dst), ctx.stream()));
     }
 
diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 59191c6..9d1fc0c 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -3352,6 +3352,39 @@ struct ggml_tensor * ggml_mul_mat_id(
     return result;
 }
 
+// ggml_mul_mat_id_into: ggml_mul_mat_id written in place into acc (op_params[2] = 2). Only the rows of
+// the pairs it computes are written; the rows of pairs whose id is past the last matrix are left as acc
+// has them. For multi-pass MoE prefill with the other passes' pairs skipped: every pair belongs to one
+// pass, so the passes fill disjoint rows of one tensor and need no sum. Backends without support for
+// skipped ids must not run it (CUDA only, see llama-moe-stream).
+struct ggml_tensor * ggml_mul_mat_id_into(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * as,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * acc) {
+    GGML_ASSERT(!ggml_is_transposed(as));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(as->ne[3] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(ids->ne[2] == 1 && ids->ne[3] == 1);
+    GGML_ASSERT(ids->ne[1] == b->ne[2]);
+    GGML_ASSERT(as->ne[0] == b->ne[0]);
+    GGML_ASSERT(ids->ne[0] % b->ne[1] == 0);
+    GGML_ASSERT(acc->type == GGML_TYPE_F32 && ggml_is_contiguous(acc));
+    GGML_ASSERT(acc->ne[0] == as->ne[1] && acc->ne[1] == ids->ne[0] && acc->ne[2] == b->ne[2] && acc->ne[3] == 1);
+
+    struct ggml_tensor * result = ggml_view_tensor(ctx, acc);
+
+    result->op     = GGML_OP_MUL_MAT_ID;
+    result->src[0] = as;
+    result->src[1] = b;
+    result->src[2] = ids;
+    result->src[3] = acc;
+    ggml_set_op_params_i32(result, 2, 2);
+
+    return result;
+}
+
 // ggml_out_prod
 
 static inline bool ggml_can_out_prod(const struct ggml_tensor * t0, const struct ggml_tensor * t1) {
