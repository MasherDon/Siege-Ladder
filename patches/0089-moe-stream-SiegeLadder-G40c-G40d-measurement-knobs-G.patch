         if (!g40_pick.empty()) {
             const int64_t s0 = stats.n_stage;
             const int64_t d0 = stats.n_stage_drive;
-            stage_experts_locked(st, g40_pick.data(), g40_pick.size(), /*add_keep =*/ false, /*wrong =*/ false, g40_low);
