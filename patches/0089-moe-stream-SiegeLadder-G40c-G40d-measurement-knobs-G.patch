@@ -3423,14 +3468,17 @@ void llama_moe_stream::g35_speculate(llama_moe_stream_layer & sl, const ggml_ten
         g40_pick.clear();
         for (int64_t k = 0; k < n_top && (int32_t) g40_pick.size() < g40_k; k++) {
             const int32_t e = top[k];
-            if ((double) sc[e] >= h*sum && st.expert_slot.find(e) == st.expert_slot.end()) {
+            // G40d (G40_SRC=1): only experts the host tier holds whole - no staging from the drive
