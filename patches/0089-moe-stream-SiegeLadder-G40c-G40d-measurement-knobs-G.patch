+// SiegeLadder G40c: a staging's victim as pick_victim_locked picks it, but only among slots whose expert the host tier
+// holds whole - a miss on the evicted one later is a copy from RAM, never a drive read, so the drop rule (held in
+// neither tier) never drops it. The tier is asked only for a slot that would beat the best so far
+int32_t llama_moe_stream::pick_victim_tier_locked(llama_moe_stream_layer & sl, const uint8_t * keep) {
+    int32_t v = -1;
+
+    for (uint32_t s = 0; s < sl.n_slots; s++) {
+        if ((keep && keep[s]) || sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+            continue;
+        }
+        if (!sl.slot_pinned.empty() && sl.slot_pinned[s]) {
+            continue;
+        }
+        if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_EMPTY) {
+            return s;
+        }
+        if (v >= 0) {
+            const uint32_t hs = sl.route_hotness[sl.slot_expert[s]];
+            const uint32_t hv = sl.route_hotness[sl.slot_expert[v]];
+            if (!(hs < hv || (hs == hv && sl.slot_last_use[s] < sl.slot_last_use[v]))) {
+                continue;
+            }
+        }
+        if (!on_drive_locked(sl, sl.slot_expert[s])) {
+            v = s;
+        }
+    }
+
+    return v;
+}
