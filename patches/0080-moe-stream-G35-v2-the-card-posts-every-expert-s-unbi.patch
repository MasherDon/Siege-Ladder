+    // computes it while the host remaps); the first half picks the lens's G35_M best and reads ahead into the host tier
+    // (speculate_locked, one pool wake-up a lens) those whose share of the lens's top n_used is at least G35_H - the
+    // heavy drive misses the default would wait for, d calls before their call. The math is untouched (it changes when a
+    // slab is read); with the drop rule fewer heavy experts are on the drive, so fewer calls wait
     int32_t  g35_depth       = 0;
     int32_t  g35_m           = 8;
     float    g35_h           = 0.14f;
@@ -1265,8 +1266,9 @@ struct llama_moe_stream {
     // 3a: act on the prediction of the next streamed layer after sl_now; pred is [k, n_tok] I32
     void predict_locked(const llama_moe_stream_layer & sl_now, const int32_t * pred, int64_t k, int64_t n_tok);
 
-    // queue a host-tier-only fill for an expert not yet asked for
-    void speculate_locked(llama_moe_stream_layer & sl, int32_t expert);
