From b82dce2a3ae41d32aebb7e0e9c855c10d5df3e53 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Thu, 22 Oct 2026 07:19:21 +0000
Subject: [PATCH 80/91] moe-stream : G35 v2 - the card posts every expert's
 unbiased and biased scores of the lens ([n_expert, 2]) in record [1] after
 record [0] and the shared expert (computed while the host remaps; no sort on
 the card), the host picks the G35_M best and wakes the I/O pool once a lens
 (speculate_locked notify = false). v1 on the exact path: drive wait -2.4 ms
 per token, outside +2.6 ms (SiegeLadder twentieth session)

---
 src/llama-graph.cpp      |  7 +++---
 src/llama-moe-stream.cpp | 48 ++++++++++++++++++++++++++++++----------
 src/llama-moe-stream.h   | 20 +++++++++--------
 src/models/deepseek4.cpp | 12 +++++-----
 4 files changed, 56 insertions(+), 31 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 50070da..5925dd2 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -3261,13 +3261,14 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
             } else {
                 iargs[n_iargs++] = ids_cont;
             }
-            // SiegeLadder G35: the lens rides in record [1], posted before record [0] - the first half never waits for it
+            mb_post(0, iargs[0]);
+            mb_shexp();
+            // SiegeLadder G35: the lens rides in record [1], after record [0] and the shared expert - the card computes it
+            // while the host runs the first half, which reads it once the call's loads are queued
             if (g35_lens != nullptr && msl->mb_rec[1] != nullptr) {
                 mb_post(1, g35_lens);
                 msl->g35_on = true;
             }
-            mb_post(0, iargs[0]);
-            mb_shexp();
             ra_ids = ggml_custom_4d(ctx0, GGML_TYPE_I32, ids_cont->ne[0], ids_cont->ne[1], 1, 1, nullptr, 0,
                     llama_moe_stream_remap_issue_g31_mb, 1, msl);
             cb(ra_ids, "ffn_moe_topk_g31", il);
diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index c8baf29..97f3f1f 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -3185,37 +3185,58 @@ void llama_moe_stream::predict_locked(const llama_moe_stream_layer & sl_now, con
 // (share >= g35_h) are read ahead into the host tier. speculate_locked skips what sits in a VRAM slot; the worker skips
 // what the tier holds already
 void llama_moe_stream::g35_speculate(llama_moe_stream_layer & sl, const ggml_tensor & lens) {
+    // the lens is [n_expert, 2] F32: every expert's unbiased score, then its biased one (the selection's); the host
+    // picks the g35_m best by the biased score (no sort on the card)
     if (sl.g35_target < 0 || (size_t) sl.g35_target >= layers.size() || !layers[(size_t) sl.g35_target] ||
             lens.type != GGML_TYPE_F32 || lens.ne[1] != 2) {
         return;
     }
     llama_moe_stream_layer & st = *layers[(size_t) sl.g35_target];
-    const int64_t m  = lens.ne[0];
-    const float * v  = (const float *) lens.data;
+    const int64_t ne = lens.ne[0];
+    const float * sc = (const float *) lens.data;
+    const float * sb = sc + ne;
+    const int64_t m  = std::min<int64_t>(g35_m, ne);
     const int64_t nu = std::min<int64_t>(m, st.n_used > 0 ? st.n_used : 6);
+    int32_t top[64];
+    int64_t n_top = 0;
+    for (int64_t e = 0; e < ne; e++) {   // insertion into a short sorted list: ne 384, m <= 64
+        if (n_top == m && sb[e] <= sb[top[m - 1]]) {
+            continue;
+        }
+        int64_t i = n_top < m ? n_top++ : m - 1;
+        while (i > 0 && sb[top[i - 1]] < sb[e]) {
+            top[i] = top[i - 1];
+            i--;
+        }
+        top[i] = (int32_t) e;
+    }
     double sum = 0.0;
-    for (int64_t k = 0; k < nu; k++) {
-        sum += v[m + k];
+    for (int64_t k = 0; k < std::min(nu, n_top); k++) {
+        sum += sc[top[k]];
     }
     std::lock_guard<std::mutex> lk(mtx);
     stats.n_g35_posts++;
     if (!(sum > 0.0)) {
         return;
     }
-    for (int64_t k = 0; k < m; k++) {
-        if ((double) v[m + k] < (double) g35_h*sum) {
+    const size_t q0 = q_spec.size();
+    for (int64_t k = 0; k < n_top; k++) {
+        if ((double) sc[top[k]] < (double) g35_h*sum) {
             continue;
         }
         stats.n_g35_cand++;
         const size_t before = q_spec.size();
-        speculate_locked(st, (int32_t) v[k]);
+        speculate_locked(st, top[k], /*notify =*/ false);
         stats.n_g35_spec += q_spec.size() > before ? 1 : 0;
     }
+    if (q_spec.size() > q0) {
+        cv_work.notify_all();   // once for the lens
+    }
 }
 
 // Queue a host-tier fill for an expert this layer has NOT been asked for yet. Bounded, because
 // a speculative queue longer than the drive can drain is a queue of guesses about the past.
-void llama_moe_stream::speculate_locked(llama_moe_stream_layer & sl, int32_t expert) {
+void llama_moe_stream::speculate_locked(llama_moe_stream_layer & sl, int32_t expert, bool notify) {
     if (!l2 || expert < 0 || (uint32_t) expert >= sl.n_expert) {
         return;
     }
@@ -3243,8 +3264,11 @@ void llama_moe_stream::speculate_locked(llama_moe_stream_layer & sl, int32_t exp
     stats.n_spec_queued += n;
     // notify_all is what the demand path needs; here it also wakes the reserved workers, which
     // re-check the predicate and go back to sleep. Harmless but not free, and there is no
-    // notify_some -- documented rather than papered over.
-    cv_work.notify_all();
+    // notify_some -- documented rather than papered over. (~24 us a call, runs.md 4.79: G35 queues a lens's
+    // experts with notify = false and wakes the pool once)
+    if (notify) {
+        cv_work.notify_all();
+    }
 }
 
 size_t llama_moe_stream::size_bufs() const {
@@ -5956,8 +5980,8 @@ void llama_moe_stream_remap_issue_g31_mb(ggml_tensor * dst, int ith, int nth, vo
     }
     d2.src[0] = &in0;
     moe_stream_remap_issue_half(&d2, userdata, /*half =*/ 2);
-    // SiegeLadder G35: the lens of layer g35_target rode in record [1], posted before record [0] - after this call's own
-    // loads are queued, its heavy experts are read ahead into the host tier
+    // SiegeLadder G35: the lens of layer g35_target rides in record [1], posted after record [0] and the shared expert (the
+    // card computed it while this half ran) - after this call's own loads are queued, its heavy experts are read ahead
     if (sl->g35_on && sl->mb_ne[1][0] > 0) {
         moe_mb_wait(*sl->mgr, *sl, 1);
         const ggml_tensor lens = moe_mb_tensor(*sl, 1);
