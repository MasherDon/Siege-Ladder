-                    const uint8_t * data = llama_moe_stream_pread(*files[wt.file_idx], dst,
-                            wt.nb_expert, offs, use_direct_io, worker_id);
+                    const uint8_t * data = pread_slab(wt.file_idx, dst, wt.nb_expert, offs, worker_id);
                     io_record(/*spec =*/ true, t_io, ggml_time_us(), wt.nb_expert);
                     if (data == nullptr) {
                         // a failed speculative read is not an error: drop the slot and carry on
@@ -2178,8 +2268,7 @@ void llama_moe_stream::worker_loop(int worker_id) {
 
                 moe_nvtx_push("read", sl.il);
                 const int64_t t_io = ggml_time_us();
-                data = llama_moe_stream_pread(*files[wt.file_idx], dst ? dst : staging,
-                        wt.nb_expert, offs, use_direct_io, worker_id);
+                data = pread_slab(wt.file_idx, dst ? dst : staging, wt.nb_expert, offs, worker_id);
                 io_record(/*spec =*/ false, t_io, ggml_time_us(), wt.nb_expert);
                 moe_nvtx_pop();
 
@@ -3057,6 +3146,12 @@ void llama_moe_stream::print_stats(const char * role) const {
                         p.us_max.load()/1000.0, p.hist[0].load(), p.hist[1].load(), p.hist[2].load(), p.hist[3].load(),
                         p.hist[4].load(), p.hist[5].load());
             }
+            if (io_mirror_n.load() > 0) {
+                const int64_t b_all = io[0].bytes.load() + io[1].bytes.load();
+                LLAMA_LOG_WARN("%s: %smoe stream: P16 reads from the copies = %" PRId64 ", %.2f GB (%.1f%% of the bytes)\n",
+                        __func__, pfx, io_mirror_n.load(), io_mirror_bytes.load()/1e9,
+                        b_all > 0 ? 100.0*io_mirror_bytes.load()/b_all : 0.0);
+            }
         }
     }
     LLAMA_LOG_INFO("%s: %smoe stream: slot wait = %.2f ms total over %" PRId64 " waits (%.1f%% of the two stalls)\n",
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
index 4df3e2f..1b6cf51 100644
--- a/src/llama-moe-stream.h
+++ b/src/llama-moe-stream.h
@@ -640,6 +640,21 @@ struct llama_moe_stream {
 
     llama_files files; // privately reopened GGUF files, same indices as the loader's
 
+    // SiegeLadder P16 (LLAMA_MOE_STREAM_MIRROR=dir, off by default): byte-identical copies of the GGUF parts on a second
+    // drive, same indices as files (nullptr where a part has no copy). A slab is read from the copy only while the
+    // primary drive already has mirror_at reads in flight and the copy fewer than mirror_max: decode's shallow queue
+    // stays on the fast drive, a prompt's overflow goes to the second one. Same bytes either way - only the drive differs
+    llama_files mirrors;
+    int32_t mirror_at  = 8;  // LLAMA_MOE_STREAM_MIRROR_AT
+    int32_t mirror_max = 4;  // LLAMA_MOE_STREAM_MIRROR_MAX
+    std::atomic<int32_t> io_inflight_pri{0};
+    std::atomic<int32_t> io_inflight_mir{0};
+    std::atomic<int64_t> io_mirror_n{0};
+    std::atomic<int64_t> io_mirror_bytes{0};
+    void open_mirrors(const std::vector<std::string> & paths, const char * dir);
+    // a slab of part file_idx into staging (see llama_moe_stream_pread), from the part or its copy
+    const uint8_t * pread_slab(uint32_t file_idx, uint8_t * staging, size_t len, size_t offs, int worker_id);
+
     // Host-RAM tier below the VRAM slots. Off unless LLAMA_MOE_STREAM_L2_GIB is set; sized in
     // whole GiB because the useful range on a consumer box is tens of gigabytes and a finer knob
     // would suggest a precision the allocation does not have.
