     n_streamed_layers  = std::max<int64_t>(1, n_streamed);
 }
 
+void llama_moe_stream::open_mirrors(const std::vector<std::string> & paths, const char * dir) {
+    mirrors.clear();
+    mirrors.resize(files.size());
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_MIRROR_AT")) {
+        mirror_at = std::max(0, atoi(p));
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_MIRROR_MAX")) {
+        mirror_max = std::max(1, atoi(p));
+    }
+    // A copy is used only with the part's size and the same bytes in 17 sampled 64 KiB blocks (the start, 15 spread
+    // through the file, the tail): a stale copy of another build must not feed the cache without a word
+    const size_t blk = 64u << 10;
+    uint8_t * buf_a = (uint8_t *) moe_aligned_alloc(blk + 2*MOE_STREAM_DIRECT_ALIGN);
+    uint8_t * buf_b = (uint8_t *) moe_aligned_alloc(blk + 2*MOE_STREAM_DIRECT_ALIGN);
+    GGML_ASSERT(buf_a != nullptr && buf_b != nullptr);
+    std::string base = dir;
+    if (!base.empty() && base.back() != '/' && base.back() != '\\') {
+        base += '/';
+    }
+    int    n_open = 0;
+    double gb     = 0.0;
+    for (size_t i = 0; i < paths.size() && i < files.size(); i++) {
+        const size_t      cut   = paths[i].find_last_of("/\\");
+        const std::string mpath = base + (cut == std::string::npos ? paths[i] : paths[i].substr(cut + 1));
+        FILE * probe = ggml_fopen(mpath.c_str(), "rb");
+        if (probe == nullptr) {
+            continue; // no copy of this part
+        }
+        fclose(probe);
+        std::unique_ptr<llama_file> m;
+        try {
+            m.reset(new llama_file(mpath.c_str(), "rb", use_direct_io));
+        } catch (const std::exception & e) {
+            LLAMA_LOG_WARN("%s: P16: cannot open the copy '%s': %s\n", __func__, mpath.c_str(), e.what());
+            continue;
+        }
+        const size_t sz = files[i]->size();
+        if (m->size() != sz || m->has_direct_io() != files[i]->has_direct_io()) {
+            LLAMA_LOG_WARN("%s: P16: the copy '%s' is not the part (size %zu vs %zu, direct %d vs %d) - not used\n",
+                    __func__, mpath.c_str(), m->size(), sz, (int) m->has_direct_io(), (int) files[i]->has_direct_io());
+            continue;
+        }
+        const size_t n = std::min(blk, sz);
+        bool same = true;
+        for (int k = 0; k <= 16 && same; k++) {
+            size_t off = k == 16 ? sz - n : (sz - n) / 16 * k;
+            off &= ~(size_t) (MOE_STREAM_DIRECT_ALIGN - 1);
+            const size_t    len = std::min(n, sz - off);
+            const uint8_t * a   = llama_moe_stream_pread(*files[i], buf_a, len, off, use_direct_io, /*worker_id =*/ -1);
+            const uint8_t * b   = llama_moe_stream_pread(*m,        buf_b, len, off, use_direct_io, /*worker_id =*/ -1);
+            same = a != nullptr && b != nullptr && memcmp(a, b, len) == 0;
+        }
+        if (!same) {
+            LLAMA_LOG_WARN("%s: P16: the copy '%s' has other bytes than the part - not used\n", __func__, mpath.c_str());
+            continue;
+        }
+        gb += sz / 1e9;
+        n_open++;
+        mirrors[i] = std::move(m);
+    }
+    moe_aligned_free(buf_a);
+    moe_aligned_free(buf_b);
+    LLAMA_LOG_INFO("%s: P16: copies of %d of %zu parts in %s (%.1f GB); a slab goes to a copy while the primary has >= %d "
+            "reads in flight and the copies < %d\n", __func__, n_open, files.size(), dir, gb, mirror_at, mirror_max);
+}
+
+const uint8_t * llama_moe_stream::pread_slab(uint32_t file_idx, uint8_t * staging, size_t len, size_t offs, int worker_id) {
+    llama_file * f   = files[file_idx].get();
+    bool         mir = false;
+    if (file_idx < mirrors.size() && mirrors[file_idx] != nullptr &&
+            io_inflight_pri.load(std::memory_order_relaxed) >= mirror_at &&
+            io_inflight_mir.load(std::memory_order_relaxed) < mirror_max) {
+        f   = mirrors[file_idx].get();
+        mir = true;
+    }
+    std::atomic<int32_t> & n = mir ? io_inflight_mir : io_inflight_pri;
+    n.fetch_add(1, std::memory_order_relaxed);
+    const uint8_t * data = llama_moe_stream_pread(*f, staging, len, offs, use_direct_io, worker_id);
+    n.fetch_sub(1, std::memory_order_relaxed);
+    if (mir) {
+        io_mirror_n.fetch_add(1, std::memory_order_relaxed);
+        io_mirror_bytes.fetch_add((int64_t) len, std::memory_order_relaxed);
+    }
+    return data;
+}
+
 void llama_moe_stream::cap_runahead(uint32_t n_expert_used) {
     if (runahead_default && n_expert_used > 0 && runahead_k > n_expert_used) {
         runahead_k = n_expert_used;
@@ -2109,8 +2200,7 @@ void llama_moe_stream::worker_loop(int worker_id) {
                 uint8_t * dst = l2->reserve(wt.file_idx, offs, wt.nb_expert, &slot_l2, sl.il);
                 if (dst != nullptr) {
