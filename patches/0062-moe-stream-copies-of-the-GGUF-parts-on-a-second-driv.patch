--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -1670,6 +1670,11 @@ void llama_moe_stream::open_files(const std::vector<std::string> & paths) {
         LLAMA_LOG_INFO("%s: MoE expert streaming uses O_DIRECT (page cache bypassed)\n", __func__);
     }
 
+    // SiegeLadder P16: copies of the parts on a second drive (see mirrors in the header)
+    if (const char * dir = std::getenv("LLAMA_MOE_STREAM_MIRROR"); dir != nullptr && *dir != '\0') {
