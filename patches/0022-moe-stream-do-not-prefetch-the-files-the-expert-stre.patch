From dfe23fda88fae7e678d2b2abdc14a526f13139ac Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:54:05 +0000
Subject: [PATCH 22/92] moe-stream : do not prefetch the files the expert
 stream reads itself

init_mappings asked Windows to prefetch every file that fit in free memory less 8 GiB. On a split model each
expert shard fits on its own, and the standby pages of the previous shard count as free, so all seven expert
files of V4.1-Flash Q2mix (~153 GB) were read into the file cache at every load, while the stream never reads
them through the mapping (its own unbuffered handles; the mappings are released after load). Measured
(SiegeLadder runs.md 4.35, two runs each): hard-fault page reads per run 41.4M -> 4.0M, load 32-33 s -> 12-16 s,
generation unchanged. LLAMA_MOE_STREAM_PREFETCH_ALL=1 keeps the old behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-model-loader.cpp | 11 +++++++++--
 src/llama-model-loader.h   |  3 ++-
 src/llama-model.cpp        | 20 +++++++++++++++++++-
 3 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 560e83b..ab5806f 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1343,11 +1343,12 @@ void llama_model_loader::done_getting_tensors(bool partial) const {
     }
 }
 
-void llama_model_loader::init_mappings(bool prefetch, llama_mlocks * mlock_mmaps) {
+void llama_model_loader::init_mappings(bool prefetch, llama_mlocks * mlock_mmaps, const std::vector<bool> * no_prefetch) {
     if (use_mmap) {
         mappings.reserve(files.size());
         mmaps_used.reserve(files.size());
-        for (const auto & file : files) {
+        for (size_t i_file = 0; i_file < files.size(); ++i_file) {
+            const auto & file = files[i_file];
             bool is_numa = false;
 
             auto * dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
@@ -1366,6 +1367,12 @@ void llama_model_loader::init_mappings(bool prefetch, llama_mlocks * mlock_mmaps
             // 0.1 GiB, which is paging, not caching.
             size_t prefetch_bytes = prefetch ? (size_t) -1 : 0;
 
+            if (prefetch_bytes != 0 && no_prefetch && i_file < no_prefetch->size() && (*no_prefetch)[i_file]) {
+                LLAMA_LOG_INFO("%s: not prefetching %.1f GiB: the expert stream reads this file itself\n",
+                        __func__, file->size()/1073741824.0);
+                prefetch_bytes = 0;
+            }
+
             if (prefetch_bytes != 0) {
                 auto * cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
                 if (cpu_dev) {
diff --git a/src/llama-model-loader.h b/src/llama-model-loader.h
index caee92a..d8b15fb 100644
--- a/src/llama-model-loader.h
+++ b/src/llama-model-loader.h
@@ -218,7 +218,8 @@ struct llama_model_loader {
 
     void done_getting_tensors(bool partial = false) const;
 
-    void init_mappings(bool prefetch = true, llama_mlocks * mlock_mmaps = nullptr);
+    // no_prefetch[i]: never prefetch file i (the MoE expert stream reads it with its own handles)
+    void init_mappings(bool prefetch = true, llama_mlocks * mlock_mmaps = nullptr, const std::vector<bool> * no_prefetch = nullptr);
 
     void get_mapping_range(size_t * first, size_t * last, void ** addr, int idx, ggml_context * ctx) const;
 
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 533c615..a5433d9 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1708,7 +1708,25 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
-    ml.init_mappings(true, use_mlock ? &pimpl->mlock_mmaps : nullptr);
+    // The expert stream reads its files with its own unbuffered handles, never through the mapping (apart from
+    // the few host tensors copied out at load, below). Prefetching those files only fills the file cache with
+    // pages nobody touches, and init_mappings' free-memory guard does not stop it, because the standby pages of
+    // the previous file count as free: measured 2026-10-16 (SiegeLadder runs.md 4.35), ~42M pages (~170 GB)
+    // read at every load of V4.1-Flash Q2mix, the seven expert files whole into ~51 GiB of RAM.
+    std::vector<bool> no_prefetch(ml.files.size(), false);
+    if (pimpl->moe_stream && std::getenv("LLAMA_MOE_STREAM_PREFETCH_ALL") == nullptr) {
+        for (const auto & sl : pimpl->moe_stream->layers) {
+            if (!sl) {
+                continue;
+            }
+            for (const auto & w : sl->weights) {
+                if (w.file_idx < no_prefetch.size()) {
+                    no_prefetch[w.file_idx] = true;
+                }
+            }
+        }
+    }
+    ml.init_mappings(true, use_mlock ? &pimpl->mlock_mmaps : nullptr, &no_prefetch);
     pimpl->mappings.reserve(ml.mappings.size());
 
     // create the backend buffers
