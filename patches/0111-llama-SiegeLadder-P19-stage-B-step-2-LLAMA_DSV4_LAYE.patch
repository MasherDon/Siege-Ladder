+bool llama_moe_stream::p19_lm_pool_begin(uint32_t target_slots, size_t seg_reserve_bytes, size_t margin_mib) {
+    if (p19_lm_pool_active) {
+        return true;
+    }
+    // P11 owns the shared pool and restores the decode cache. A prior output-less
+    // call may leave it expanded until p11_leave; retain its original wave plan.
+    if (!p11_active || plan_slots != 0) {
+        return false;
+    }
+    const llama_moe_stream_layer * ref = nullptr;
+    for (const auto & sl : layers) {
+        if (sl) {
+            ref = sl.get();
+            break;
+        }
+    }
+    if (ref == nullptr) {
+        return false;
+    }
+    p19_lm_base_slots = ref->n_slots;
+
+    std::vector<size_t> widest_bytes(ref->weights.size(), 0);
+    for (const auto & sl : layers) {
+        if (!sl || sl->weights.size() != widest_bytes.size()) {
+            continue;
+        }
+        for (size_t w = 0; w < sl->weights.size(); ++w) {
+            widest_bytes[w] = std::max(widest_bytes[w], (size_t) sl->weights[w].nb_expert);
+        }
+    }
+    size_t slot_bytes = 0;
+    for (size_t n : widest_bytes) {
+        slot_bytes += n;
+    }
+    if (slot_bytes == 0) {
+        return false;
+    }
+
+    uint32_t P = target_slots;
+    if (P == 0) {
+        const llama_wddm_budget wb = llama_wddm_query_budget();
+        if (!wb.ok || wb.local_budget <= wb.local_usage) {
+            return false;
+        }
+        size_t room = (size_t) (wb.local_budget - wb.local_usage);
+        const size_t margin = (margin_mib << 20) + seg_reserve_bytes;
+        if (room <= margin) {
+            return false;
+        }
+        room -= margin;
+        P = (uint32_t) std::min<uint64_t>(ref->n_expert + p19_lm_base_slots, room / slot_bytes);
+    }
+    P = std::max(p19_lm_base_slots, P);
+    P = std::min(ref->n_expert, P);
+    if (P <= p19_lm_base_slots) {
+        return false;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    std::unique_lock<std::mutex> lk(mtx);
+    moe_p11_quiesce_locked(*this, lk);
+
+    const llama_wddm_budget wb0 = llama_wddm_query_budget();
+    const double            dxgi0 =
+            wb0.ok ? (wb0.local_budget - wb0.local_usage) / 1048576.0 : -1.0;
+
+    if (p11_active) {
+        std::vector<const ggml_tensor *> widest;
+        for (const auto & sl : layers) {
+            if (!sl) {
+                continue;
+            }
+            widest.resize(sl->weights.size(), nullptr);
+            for (size_t w = 0; w < sl->weights.size(); w++) {
+                const ggml_tensor * a = sl->weights[w].cache;
+                if (widest[w] == nullptr || a->nb[2] > widest[w]->nb[2]) {
+                    widest[w] = a;
+                }
+            }
+        }
+        for (auto & sl : layers) {
+            if (sl) for (auto & wt : sl->weights) {
+                wt.cache->data = nullptr;
+                wt.cache->buffer = nullptr;
+            }
+        }
+        p11_buf.reset();
+        p11_ctx.reset();
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead()*(widest.size() + 1),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        p11_ctx.reset(ggml_init(params));
+        std::vector<ggml_tensor *> pool;
+        for (const ggml_tensor * c : widest) {
+            ggml_tensor * t = ggml_new_tensor_3d(p11_ctx.get(), c->type, c->ne[0], c->ne[1], P);
+            pool.push_back(t);
+        }
+        ggml_backend_buffer_type_t buft = ctxs[0].first;
+        p11_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(p11_ctx.get(), buft));
+        const bool expanded = p11_buf != nullptr;
+        if (!expanded) {
+            // The old buffer is gone: restore the original pool before returning.
+            for (ggml_tensor * t : pool) {
+                t->ne[2] = p19_lm_base_slots;
+                t->nb[3] = t->nb[2] * p19_lm_base_slots;
+            }
+            p11_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(p11_ctx.get(), buft));
+            if (!p11_buf) {
+                GGML_ABORT("MoE expert streaming: could not restore P11 pool after P19 allocation failure");
+            }
+            P = p19_lm_base_slots;
+            LLAMA_LOG_WARN("%s: P19 LM pool allocation failed; restored empty P11 pool\n", __func__);
+        }
+        ggml_backend_buffer_set_usage(p11_buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_backend_dev_t dev = compute_backend != nullptr ? ggml_backend_get_device(compute_backend) : nullptr;
+        for (auto & sl : layers) {
+            if (!sl) {
+                continue;
+            }
+            for (size_t w = 0; w < sl->weights.size(); w++) {
+                ggml_tensor * c = sl->weights[w].cache;
+                c->ne[2]  = P;
+                c->nb[3]  = c->nb[2] * P;
+                c->data   = pool[w]->data;
+                c->buffer = pool[w]->buffer;
+            }
+            p11_reset_layer_locked(*sl, P); // the replacement buffer is empty
+            if (slot_fence && dev != nullptr) {
+                if (sl->slot_up_event.size() < P) {
+                    const size_t n0 = sl->slot_up_event.size();
+                    sl->slot_up_event.resize(P, nullptr);
+                    sl->slot_up_seq.resize(P, 0);
+                    for (size_t s = n0; s < P; s++) {
+                        sl->slot_up_event[s] = ggml_backend_event_new(dev);
+                    }
+                }
+            }
+        }
+        if (!expanded) {
+            return false;
+        }
+    } else {
+        for (auto & [buft, ctx] : ctxs) {
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t != nullptr; t = ggml_get_next_tensor(ctx.get(), t)) {
+                if (t->ne[2] == (int64_t) p19_lm_base_slots) {
+                    t->ne[2] = P;
+                    t->nb[3]  = t->nb[2] * P;
+                }
+            }
+        }
+        bufs.clear();
+        for (auto & [buft, ctx] : ctxs) {
+            if (ggml_get_first_tensor(ctx.get()) == nullptr) {
+                continue;
+            }
+            ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft);
+            if (buf == nullptr) {
+                LLAMA_LOG_WARN("%s: P19 LM pool: could not re-allocate per-layer cache for %u slots\n", __func__, P);
+                return false;
+            }
+            ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+            bufs.emplace_back(buf);
+        }
+        for (auto & sl : layers) {
+            if (sl) {
+                p19_lm_extend_layer_locked(*sl, sl->n_slots, P);
+            }
+        }
+    }
+
+    plan_slots         = p19_lm_base_slots;
+    p19_lm_pool_n      = P;
+    p19_lm_pool_active = true;
+    p19_lm_last_il     = -1; // new memory: the first wave 0 of every layer resets its table
+    p19_lm_keep_tables = 0;
+    p19_lm_hits0       = stats.n_hit;
+    p19_lm_miss0       = stats.n_miss;
+    p19_lm_io_bytes0   = io[0].bytes.load();
+
+    const llama_wddm_budget wb1 = llama_wddm_query_budget();
+    const double            dxgi1 =
+            wb1.ok ? (wb1.local_budget - wb1.local_usage) / 1048576.0 : -1.0;
+    LLAMA_LOG_INFO("%s: P19 LM pool (LLAMA_DSV4_LAYER_MAJOR_POOL): slots %u -> %u (plan %u), slot %.2f MiB, pool %.1f MiB, "
+            "DXGI free %.1f -> %.1f MiB, %.1f ms\n", __func__, p19_lm_base_slots, P, plan_slots,
+            slot_bytes / 1048576.0, (double) (slot_bytes * P) / 1048576.0, dxgi0, dxgi1,
+            (ggml_time_us() - t0) / 1000.0);
+    return true;
+}
+
+void llama_moe_stream::p19_lm_pool_end() {
+    if (!p19_lm_pool_active) {
+        return;
+    }
+    const int64_t hits  = stats.n_hit - p19_lm_hits0;
+    const int64_t miss  = stats.n_miss - p19_lm_miss0;
+    const int64_t bytes = io[0].bytes.load() - p19_lm_io_bytes0;
+    if (p11_active) {
+        // p1_leave -> p11_leave restores p11_saved_slots and the per-layer cache; only clear planning state
+        LLAMA_LOG_INFO("%s: P19 LM pool (call end): slots=%u plan=%u hits=%" PRId64 " miss=%" PRId64 " demand_io_bytes=%" PRId64
+                " kept_tables=%" PRId64 " (delta vs call start; compare POOL off on the same prompt)\n", __func__,
+                p19_lm_pool_n, plan_slots, hits, miss, bytes, p19_lm_keep_tables);
+        // Keep the original plan until p11_leave restores the decode cache.
+        p19_lm_pool_active = false;
+        p19_lm_pool_n      = 0;
+        p19_lm_last_il     = -1;
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    std::unique_lock<std::mutex> lk(mtx);
+    moe_p11_quiesce_locked(*this, lk);
+    const uint32_t n = p19_lm_base_slots;
+    for (auto & [buft, ctx] : ctxs) {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t != nullptr; t = ggml_get_next_tensor(ctx.get(), t)) {
+            if ((uint32_t) t->ne[2] == p19_lm_pool_n) {
+                t->ne[2] = n;
+                t->nb[3]  = t->nb[2] * n;
+            }
+        }
+    }
+    bufs.clear();
+    for (auto & [buft, ctx] : ctxs) {
+        if (ggml_get_first_tensor(ctx.get()) == nullptr) {
+            continue;
+        }
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft);
+        GGML_ASSERT(buf != nullptr);
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        bufs.emplace_back(buf);
+    }
+    for (auto & sl : layers) {
+        if (sl) {
+            p11_reset_layer_locked(*sl, n);
+        }
+    }
+    plan_slots         = 0;
+    p19_lm_pool_active = false;
+    p19_lm_pool_n      = 0;
+    LLAMA_LOG_INFO("%s: P19 LM pool: restored %u slots per layer, hits=%" PRId64 " miss=%" PRId64 " host_io_bytes=%" PRId64
+            ", %.1f ms\n", __func__, n, hits, miss, bytes, (ggml_time_us() - t0) / 1000.0);
+}
+
 // spawn the I/O thread pool on first use (from the remap callback, under mtx)
 void llama_moe_stream::start_workers_locked() {
     if (workers_started) {
@@ -6250,7 +6522,14 @@ void llama_moe_stream_wave_ids(ggml_tensor * dst, int ith, int nth, void * userd
             if (mgr->compute_backend != nullptr) {
                 ggml_backend_synchronize(mgr->compute_backend);
             }
-            mgr->p11_reset_layer_locked(*sl, sl->n_slots);
+            // SiegeLadder P19 stage B (L030): with the pool grown for a layer-major call at k 1, no other layer's waves
+            // ran in it since this layer's previous ubatch - its experts are where its table says, so they hit
+            if (mgr->p19_lm_pool_active && mgr->p19_lm_last_il == sl->il) {
+                mgr->p19_lm_keep_tables++;
+            } else {
+                mgr->p11_reset_layer_locked(*sl, sl->n_slots);
+            }
+            mgr->p19_lm_last_il = sl->il;
         }
         mgr->plan_waves_locked(*sl, ids, n, (uint32_t) a->ne[0]);
         if (mgr->p11_active) {
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
index 3eb3a00..31efb81 100644
--- a/src/llama-moe-stream.h
+++ b/src/llama-moe-stream.h
@@ -645,6 +645,23 @@ struct llama_moe_stream {
     uint32_t                p11_ahead   = 0;
     int64_t                 p11_n_ahead = 0;  // experts queued ahead
     void p11_read_ahead_locked(const llama_moe_stream_layer & sl);
+    // SiegeLadder P19 stage B step 2 (LLAMA_DSV4_LAYER_MAJOR_POOL): for a layer-major call with seg sched, a larger
+    // expert pool for the call while wave planning still sees plan_slots (the base cache size, usually 64)
+    uint32_t plan_slots           = 0; // 0 = use each layer's n_slots in llama_moe_stream_wave_plan
+    bool     p19_lm_pool_active   = false;
+    uint32_t p19_lm_pool_n        = 0;    // slots in the expanded pool
+    uint32_t p19_lm_base_slots    = 0;    // per-layer cache size before expand (plan_slots source)
+    int64_t  p19_lm_hits0         = 0;
+    int64_t  p19_lm_miss0         = 0;
+    int64_t  p19_lm_io_bytes0     = 0;
+    // the layer whose wave 0 last ran in P11's shared pool (-1: none, or the pool was just reallocated). With the pool
+    // grown for a layer-major call at k 1, the same layer's next ubatch finds its experts still there - P11's per-ubatch
+    // table reset (wave entry, w == 0) is skipped then, so they hit instead of loading again
+    int32_t  p19_lm_last_il       = -1;
