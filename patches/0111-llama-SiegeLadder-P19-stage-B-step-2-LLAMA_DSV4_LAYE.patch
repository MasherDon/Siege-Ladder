+// grow a layer's slot table to n_new slots; slots [0, n_old) keep their state, new ones are empty
+static void p19_lm_extend_layer_locked(llama_moe_stream_layer & sl, uint32_t n_old, uint32_t n_new) {
+    if (n_new <= n_old) {
+        sl.n_slots = n_new;
+        return;
+    }
+    sl.n_slots = n_new;
+    sl.slot_expert    .resize(n_new, -1);
+    sl.slot_state     .resize(n_new, LLAMA_MOE_STREAM_SLOT_EMPTY);
+    sl.slot_claimed   .resize(n_new, 0);
+    sl.slot_parts_left.resize(n_new, 0);
+    sl.slot_gen       .resize(n_new, 0);
+    sl.slot_last_use  .resize(n_new, 0);
+    sl.keep           .resize(n_new, 0);
+    if (!sl.slot_pinned.empty()) {
+        sl.slot_pinned.resize(n_new, 0);
+    }
+    sl.slot_staged.resize(n_new, 0);
+    sl.slot_src   .resize(n_new, 0);
+    sl.slot_t_res .resize(n_new, 0);
+    sl.slot_t_wait.resize(n_new, 0);
+    sl.slot_wanted.resize(n_new, 0);
+    for (uint32_t s = n_old; s < n_new; s++) {
+        sl.slot_state[s] = LLAMA_MOE_STREAM_SLOT_EMPTY;
+        sl.slot_expert[s] = -1;
+    }
+}
