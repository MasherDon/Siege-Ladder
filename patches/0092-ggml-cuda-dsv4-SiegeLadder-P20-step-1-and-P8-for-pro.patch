+        // layer - bitwise the same logits; agent turns read +5.6%, cold 2.2K / 8.9K +9.0% / +6.3% (runs.md 4.232)
+        static const bool engram_late_pp = getenv("LLAMA_ENGRAM_LATE_PP") == nullptr || atoi(getenv("LLAMA_ENGRAM_LATE_PP")) != 0;
