     if (ahead.joinable()) {
@@ -312,7 +319,78 @@ void llm_graph_input_engram::set_input(const llama_ubatch * ubatch) {
     }
 }
 
-void llm_graph_input_engram::fill_layer(uint32_t e, float * dst, const llama_ubatch & ub) {
+void llm_graph_input_engram::pp_start(const llama_ubatch & ub) {
+    auto * cache = mctx->get_kv();
+    GGML_ASSERT(cache != nullptr && cache->engram_enabled());
+
+    llama_engram_tables t;
+    t.token_map   = (const int32_t *) model.engram_token_map->data;
+    t.primes      = (const int64_t *) model.engram_primes->data;
+    t.offsets     = (const int64_t *) model.engram_offsets->data;
+    t.multipliers = (const int64_t *) model.engram_multipliers->data;
+    t.n_layer     = hparams.engram_n_layer;
+    t.n_head      = hparams.engram_n_head;
+    t.max_ngram   = hparams.engram_max_ngram;
+    t.n_hash_cols = hparams.engram_n_hash_cols;
+    t.head_dim    = hparams.engram_head_dim;
+    t.pad_id      = t.token_map[hparams.engram_pad_token];
+
+    // every layer's row addresses, hashed here as fill_layer hashes them; the helper only faults the pages in
+    std::vector<std::vector<void *>> addrs(t.n_layer);
+    std::vector<std::vector<size_t>> sizes(t.n_layer);
+    std::vector<int32_t> hist(t.max_ngram);
+    std::vector<int64_t> rows(t.n_hash_cols);
+    for (uint32_t e = 0; e < t.n_layer; ++e) {
+        const auto & layer = model.layers[hparams.engram_layer_ids[e]];
+        const uint8_t * w  = (const uint8_t *) layer.engram_embd->data;
+        const uint8_t * sc = (const uint8_t *) layer.engram_embd_scale->data;
+        addrs[e].reserve((size_t) 2*ub.n_tokens*t.n_hash_cols);
+        sizes[e].reserve(addrs[e].capacity());
+        for (uint32_t i = 0; i < ub.n_tokens; ++i) {
+            const llama_seq_id s = ub.seq_id[i][0];
+            const llama_pos    p = ub.pos[i];
+            bool blocked = false;
+            for (uint32_t g = 0; g < t.max_ngram; ++g) {
+                const llama_pos q   = p - (llama_pos) g;
+                const int32_t   cid = q < 0 ? llama_kv_cache_dsv4::ENGRAM_DEAD : cache->engram_get(s, q);
+                blocked = blocked || cid == llama_kv_cache_dsv4::ENGRAM_DEAD
+                                  || cid == llama_kv_cache_dsv4::ENGRAM_NONE;
+                hist[g] = blocked ? t.pad_id : cid;
+            }
+            llama_engram_hash_row(t, e, hist.data(), rows.data());
+            for (uint32_t c = 0; c < t.n_hash_cols; ++c) {
+                addrs[e].push_back((void *) (w  + (size_t) rows[c]*t.head_dim));
+                sizes[e].push_back(t.head_dim);
+                addrs[e].push_back((void *) (sc + (size_t) rows[c]*(t.head_dim/32)));
+                sizes[e].push_back(t.head_dim/32);
+            }
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lk(pp_mtx);
+        pp_done   = 0;
+        pp_active = true;
+    }
+    pp_thread = std::thread([this, addrs = std::move(addrs), sizes = std::move(sizes)]() {
+        for (size_t e = 0; e < addrs.size(); ++e) {
+            llama_moe_stream_nvtx_push("engram_pp");
+            llama_prefetch_ranges(addrs[e].data(), sizes[e].data(), addrs[e].size());
+            llama_moe_stream_nvtx_pop();
+            {
+                std::lock_guard<std::mutex> lk(pp_mtx);
+                pp_done = (uint32_t) e + 1;
+            }
+            pp_cv.notify_all();
+        }
+    });
+}
+
+void llm_graph_input_engram::pp_wait(uint32_t e) {
+    std::unique_lock<std::mutex> lk(pp_mtx);
+    pp_cv.wait(lk, [&] { return pp_done > e; });
+}
+
+void llm_graph_input_engram::fill_layer(uint32_t e, float * dst, const llama_ubatch & ub, bool prefetch) {
     auto * cache = mctx->get_kv();
     GGML_ASSERT(cache != nullptr && cache->engram_enabled());
 
@@ -373,9 +451,11 @@ void llm_graph_input_engram::fill_layer(uint32_t e, float * dst, const llama_uba
         enderecos.push_back((void *) (sc + (size_t) todas[k]*(t.head_dim/32)));
         tamanhos .push_back(t.head_dim/32);
     }
-    llama_moe_stream_nvtx_push("engram_prefetch");
-    llama_prefetch_ranges(enderecos.data(), tamanhos.data(), enderecos.size());
-    llama_moe_stream_nvtx_pop();
+    if (prefetch) {
+        llama_moe_stream_nvtx_push("engram_prefetch");
+        llama_prefetch_ranges(enderecos.data(), tamanhos.data(), enderecos.size());
+        llama_moe_stream_nvtx_pop();
+    }
 
     llama_moe_stream_nvtx_push("engram_read");
     for (uint32_t i = 0; i < n_tokens; ++i) {
@@ -410,8 +490,16 @@ void llm_graph_input_engram::fill_op(uint32_t e, ggml_tensor * dst) {
         std::memset(dst->data, 0, ggml_nbytes(dst)); // no set_input for this compute: nothing to read
         return;
     }
+    bool faulted = false;
+    if (pp_active) {
+        // P8 for prompts: this layer's pages from the helper; the next layer's may still be on their way
+        llama_moe_stream_nvtx_push("engram_pp_wait");
+        pp_wait(e);
+        llama_moe_stream_nvtx_pop();
+        faulted = true;
+    }
     const llama_moe_stream_nvtx_range nvtx_fill("engram_fill");
-    fill_layer(e, (float *) dst->data, *late_ub);
+    fill_layer(e, (float *) dst->data, *late_ub, !faulted);
 }
 
