+    uint32_t                pp_done   = 0;     // engram layers whose rows the helper has faulted in
+    bool                    pp_active = false; // the current compute's rows go through the helper
+    void pp_start(const llama_ubatch & ub);
+    void pp_wait(uint32_t e);
+
     const llama_hparams & hparams;
     const llama_model   & model;
 
diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index a69c216..4778f9b 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -2362,7 +2362,11 @@ llama_model_deepseek4::graph::graph(const llama_model & model, const llm_graph_p
         // gathered by a CPU op of the graph right before the layer's first reader (llm_graph_input_engram::lookup), not in
