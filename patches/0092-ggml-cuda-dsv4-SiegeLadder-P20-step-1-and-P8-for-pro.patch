From 4dfcf40f68e857fffe60143acc734482f63b082e Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Sun, 25 Oct 2026 16:07:52 +0000
Subject: [PATCH 92/92] ggml-cuda + dsv4 : SiegeLadder P20 step 1 and P8 for
 prompts - the per-turn costs of an agent's prompt (runs.md 4.231-4.232). (1)
 The pinned host blocks of 64 MiB and more are kept for reuse
 (GGML_CUDA_HOST_CACHE=0 - off): the head yield's reserve took the scheduler's
 1.66 GiB host compute buffer for -ub 8192 and freed it after every prompt
 (~0.3 s of cudaMallocHost / cudaFreeHost a turn); its peak was in the WDDM
 budget already. A request no waiting block fits gives the waiting ones back
 first - the reserve grows its buffer in two steps (1643.5, then 1659.5 MiB)
 and keeping the first next to the second ran the card out of memory at load
 (the pinned budget is shared with the 44 GB host tier, which comes through
 the same path). Agent turns read +3.7% (A B B A). (2) A prompt's ubatch takes
 the late Engram path too (on by default, LLAMA_ENGRAM_LATE_PP=0 - off):
 set_input hashes its rows and a helper thread faults them in layer by layer
 in the order the graph reads them; each layer's fill op waits for its own
 layer, so the faults of layer 14 go under layers 0-13 (the rows were read
 before the first kernel: 1.29 s on a 7.5K turn). Bitwise the same logits at
 -ub 4096 (bench/engram_pp_check.py); agent turns read +5.6%, cold 2.2K / 8.9K
 +9.0% / +6.3% (A B B A)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 77 +++++++++++++++++++++++++-
 src/llama-graph.cpp             | 98 +++++++++++++++++++++++++++++++--
 src/llama-graph.h               | 23 +++++++-
 src/models/deepseek4.cpp        |  6 +-
 4 files changed, 195 insertions(+), 9 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 7a68a78..12e1d2f 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1316,8 +1316,51 @@ static bool ggml_backend_buft_is_cuda_host(ggml_backend_buffer_type_t buft) {
     return buft->iface.get_name == ggml_backend_cuda_host_buffer_type_name;
 }
 
+// SiegeLadder P20 (GGML_CUDA_HOST_CACHE=0 - off): big pinned blocks are kept for reuse instead of freed. A prompt's
+// head-yield cycle (llama-context p1_enter / p1_leave) reserves the scheduler's host compute buffer for the large ubatch
+// (1.66 GiB at -ub 8192 on V4.1) and frees it after the prompt - ~0.25 s of cudaMallocHost / cudaFreeHost on every agent
+// turn (SiegeLadder runs.md 4.231). Its peak is in the WDDM budget already (the host tier is sized around it), so keeping
+// it costs no new room. Blocks under 64 MiB are freed as before; at most two blocks wait, and a request takes a cached
+// block only up to twice its size
+struct ggml_cuda_host_block {
+    void * ptr;
+    size_t size;
+};
+static std::mutex                         ggml_cuda_host_cache_mtx;
+static std::vector<ggml_cuda_host_block>  ggml_cuda_host_cache;      // freed big blocks, oldest first
+static std::unordered_map<void *, size_t> ggml_cuda_host_block_size; // every big block from cudaMallocHost: its size
+static const size_t                       GGML_CUDA_HOST_CACHE_MIN = (size_t) 64 << 20;
+
+static bool ggml_cuda_host_cache_on() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_HOST_CACHE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return on;
+}
+
+static void ggml_cuda_host_free(void * ptr) {
+    if (ggml_cuda_host_cache_on()) {
+        std::lock_guard<std::mutex> lock(ggml_cuda_host_cache_mtx);
+        auto it = ggml_cuda_host_block_size.find(ptr);
+        if (it != ggml_cuda_host_block_size.end()) {
+            GGML_LOG_DEBUG("%s: %.1f MiB of pinned memory kept for reuse, %zu blocks waiting\n", __func__,
+                    it->second / 1024.0 / 1024.0, ggml_cuda_host_cache.size() + 1);
+            ggml_cuda_host_cache.push_back({ptr, it->second});
+            while (ggml_cuda_host_cache.size() > 2) {
+                void * old = ggml_cuda_host_cache.front().ptr;
+                ggml_cuda_host_cache.erase(ggml_cuda_host_cache.begin());
+                ggml_cuda_host_block_size.erase(old);
+                CUDA_CHECK(cudaFreeHost(old));
+            }
+            return;
+        }
+    }
+    CUDA_CHECK(cudaFreeHost(ptr));
+}
+
 static void ggml_backend_cuda_host_buffer_free_buffer(ggml_backend_buffer_t buffer) {
-    CUDA_CHECK(cudaFreeHost(buffer->context));
+    ggml_cuda_host_free(buffer->context);
 }
 
 static void * ggml_cuda_host_malloc(size_t size) {
@@ -1325,6 +1368,34 @@ static void * ggml_cuda_host_malloc(size_t size) {
         return nullptr;
     }
 
+    const bool big = ggml_cuda_host_cache_on() && size >= GGML_CUDA_HOST_CACHE_MIN;
+    if (big) {
+        std::lock_guard<std::mutex> lock(ggml_cuda_host_cache_mtx);
+        size_t best = ggml_cuda_host_cache.size();
+        for (size_t i = 0; i < ggml_cuda_host_cache.size(); i++) {
+            const auto & b = ggml_cuda_host_cache[i];
+            if (b.size >= size && b.size / 2 <= size && (best == ggml_cuda_host_cache.size() || b.size < ggml_cuda_host_cache[best].size)) {
+                best = i;
+            }
+        }
+        if (best < ggml_cuda_host_cache.size()) {
+            void * ptr = ggml_cuda_host_cache[best].ptr;
+            GGML_LOG_DEBUG("%s: %.1f MiB of pinned memory from a waiting block of %.1f MiB\n", __func__,
+                    size / 1024.0 / 1024.0, ggml_cuda_host_cache[best].size / 1024.0 / 1024.0);
+            ggml_cuda_host_cache.erase(ggml_cuda_host_cache.begin() + best);
+            return ptr;
+        }
+        // no waiting block fits: give them all back before a new one, so the cache never raises the pinned peak. The
+        // scheduler's reserve grows its host buffer in two steps (1643.5 MiB, then 1659.5 MiB at -ub 8192): keeping the
+        // first next to the second ran the card out of memory at the head yield's probe at load - the pinned memory of
+        // the WDDM budget is shared with the 44 GB host tier (which comes through here too and is never freed)
+        for (const auto & b : ggml_cuda_host_cache) {
+            ggml_cuda_host_block_size.erase(b.ptr);
+            CUDA_CHECK(cudaFreeHost(b.ptr));
+        }
+        ggml_cuda_host_cache.clear();
+    }
+
     void * ptr = nullptr;
     cudaError_t err = cudaMallocHost((void **) &ptr, size);
     if (err != cudaSuccess) {
@@ -1334,6 +1405,10 @@ static void * ggml_cuda_host_malloc(size_t size) {
                            size / 1024.0 / 1024.0, cudaGetErrorString(err));
         return nullptr;
     }
+    if (big) {
+        std::lock_guard<std::mutex> lock(ggml_cuda_host_cache_mtx);
+        ggml_cuda_host_block_size[ptr] = size;
+    }
 
     return ptr;
 }
