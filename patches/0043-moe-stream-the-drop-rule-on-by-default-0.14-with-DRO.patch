+// C13, substitute (SiegeLadder theory C13, the user's idea of 18.10; see subst in the header): what each routed expert of
+// the call is to it, in llama_moe_stream_layer::subst_mark
+enum : uint8_t {
+    MOE_C13_NONE = 0,
+    MOE_C13_DROP = 1, // on the drive and light: the drop rule's
+    MOE_C13_NEED = 2, // on the drive and heavy: its pairs look for a substitute
+    MOE_C13_SUB  = 3, // the substitute of some pair (routed by another token of the call, or not routed at all)
+    MOE_C13_WAIT = 4, // on the drive and heavy, with a pair that found no substitute: the call waits for it
+    MOE_C13_GONE = 5, // on the drive and heavy, every pair substituted: out of the call, read into the host tier for later
+};
+
+struct moe_c13_counts {
+    int64_t n_pairs    = 0; // pairs given a substitute
+    int64_t n_vram     = 0; // of those, by an expert resident in VRAM
+    int64_t n_l2       = 0; // by one whole in the host tier
+    int64_t n_none     = 0; // pairs that needed one and found no held candidate
+    int64_t n_inflight = 0; // mode 2: replaced pairs whose expert was a drive load under way (it had a slot)
+    double  share      = 0.0; // the sum of the replaced pairs' shares of their token's routing weight
+};
+
+// C13's decision, made by the remap under mgr->mtx in place of the drop rule's (moe_stream_remap_impl). Each routed expert
+// of the call that is on the drive (on_drive: no slot and not whole in the host tier; mode 2 also a slot still loading from
+// the drive) is dropped when light (drop_share below thr, which is 0 with the drop rule off), as the drop rule does, and
+// otherwise needs a substitute. Each of its pairs, the token's best-scoring routed expert first, takes the expert of the
+// same token with the highest selection score that is held - resident in VRAM, or whole in the host tier (in_l2) - and is
+// neither one of the token's own k, nor on the drive in this call, nor a substitute in the token already. The token's
+// scores are sorted lazily, 16 at a time, and tested in that order, so has() runs only until the first held one. A
+// substitute that needs a slot of its own joins only while the call's experts fit the layer's slots. The host tier's lock
+// nests inside mgr->mtx, as in the drop rule. Fills sl.dropped, sl.subst (per pair, -1 = none; empty when no pair got
+// one), sl.subst_added (the substitutes no token routed), sl.subst_gone and sl.subst_mark; returns whether a heavy expert
+// keeps a pair with no substitute - the call then still waits for the drive.
+template <typename OnDrive, typename InL2>
+static bool moe_c13_decide_locked(llama_moe_stream_layer & sl, const int32_t * ids, const float * w, const float * sel,
+        int64_t k, int64_t n_tok, float thr, const OnDrive & on_drive, const InL2 & in_l2, moe_c13_counts & cnt) {
+    const int64_t n = k*n_tok;
+    const int64_t E = sl.n_expert;
+    GGML_ASSERT(k > 0 && k <= 64);
+
+    auto & mark = sl.subst_mark;
+    mark.assign((size_t) E, MOE_C13_NONE);
+    sl.subst.assign((size_t) n, -1);
+
+    bool any_need = false;
+    for (const int32_t e : sl.uniq) {
+        if (!on_drive(e)) {
+            continue;
+        }
+        if (sl.drop_share[e] < thr) {
+            sl.dropped.push_back(e);
+            mark[e] = MOE_C13_DROP;
+        } else {
+            mark[e] = MOE_C13_NEED;
+            any_need = true;
+        }
+    }
+    if (!any_need) {
+        sl.subst.clear();
+        return false;
+    }
+
+    // the call's experts must fit the layer's slots (the remap aborts past that, and uniq.size() <= n_slots holds here). The
+    // dropped leave the call - or, when DROP_ALL takes the drops back, the substitutions go with them - so a substitute that
+    // needs a slot of its own may join while room lasts; the routed experts it frees are not counted (a bound, not the count)
+    size_t room = sl.n_slots - std::min<size_t>(sl.n_slots, sl.uniq.size() - sl.dropped.size());
+
+    auto & order = sl.subst_order;
+    order.resize((size_t) E);
+    for (int64_t t = 0; t < n_tok; t++) {
+        const int32_t * tid  = ids + t*k;
+        const float   * srow = sel + t*E;
+        uint64_t todo = 0; // the token's pairs that need a substitute
+        for (int64_t j = 0; j < k; j++) {
+            if (mark[tid[j]] == MOE_C13_NEED) {
+                todo |= 1ull << j;
+            }
+        }
+        if (todo == 0) {
+            continue;
+        }
+        // the token's experts by selection score, best first: NaN as -inf (a strict weak order for the sort), ties by id
+        auto key = [srow](int32_t c) {
+            const float v = srow[c];
+            return std::isnan(v) ? -INFINITY : v;
+        };
+        auto better = [&key](int32_t x, int32_t y) {
+            const float kx = key(x);
+            const float ky = key(y);
+            return kx > ky || (kx == ky && x < y);
+        };
+        for (int64_t c = 0; c < E; c++) {
+            order[c] = (int32_t) c;
+        }
+        size_t n_sorted = 0; // order[0, n_sorted) is sorted and holds the best n_sorted
+        size_t pos      = 0; // the next candidate to test; every pair of the token goes on from where the last one stopped
+        double s_tok    = 0.0;
+        for (int64_t j = 0; j < k; j++) {
+            s_tok += w[t*k + j];
+        }
+        while (todo != 0) {
+            int64_t j = -1;
+            for (int64_t jj = 0; jj < k; jj++) {
+                if (((todo >> jj) & 1) && (j < 0 || better(tid[jj], tid[j]))) {
+                    j = jj;
+                }
+            }
+            todo &= ~(1ull << j);
+
+            int32_t cand      = -1;
+            bool    cand_vram = false;
+            while (cand < 0) {
+                if (pos == n_sorted) {
+                    if (n_sorted == (size_t) E) {
+                        break;
+                    }
+                    const size_t to = std::min<size_t>((size_t) E, n_sorted + 16);
+                    std::partial_sort(order.begin() + n_sorted, order.begin() + to, order.end(), better);
+                    n_sorted = to;
+                }
+                const int32_t c = order[pos++];
+                if (!(key(c) > -INFINITY)) {
+                    pos = n_sorted = (size_t) E; // masked out (expert groups), and so is the rest: no candidate left
+                    break;
+                }
+                bool own = false;
+                for (int64_t jj = 0; jj < k && !own; jj++) {
+                    own = tid[jj] == c;
+                }
+                if (own || (mark[c] != MOE_C13_NONE && mark[c] != MOE_C13_SUB)) {
+                    continue; // one of the token's own, or on the drive in this call
+                }
+                if (room == 0 && mark[c] != MOE_C13_SUB && !sl.touched[c]) {
+                    continue; // would need a slot of its own, and the call has none left
+                }
+                const auto it = sl.expert_slot.find(c);
+                if (it != sl.expert_slot.end() && sl.slot_state[it->second] == LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+                    cand      = c;
+                    cand_vram = true;
+                } else if (in_l2(c)) {
+                    cand      = c; // whole in the host tier: a bus copy (into its slot, if it is loading - from RAM)
+                }
+            }
+            if (cand < 0) {
+                cnt.n_none++;
+                continue;
+            }
+            if (mark[cand] != MOE_C13_SUB && !sl.touched[cand]) {
+                room--;
+                sl.subst_added.push_back(cand);
+            }
+            mark[cand] = MOE_C13_SUB;
+            sl.subst[t*k + j] = cand;
+            cnt.n_pairs++;
+            (cand_vram ? cnt.n_vram : cnt.n_l2)++;
+            cnt.share += s_tok > 0.0 ? w[t*k + j]/s_tok : 1.0;
+            if (sl.expert_slot.count(tid[j])) {
+                cnt.n_inflight++;
+            }
+        }
+    }
+
+    // a heavy expert with a pair left still waits for the drive; one whose every pair has a substitute leaves the call
+    bool waits = false;
+    for (int64_t i = 0; i < n; i++) {
+        if (sl.subst[i] < 0 && (mark[ids[i]] == MOE_C13_NEED || mark[ids[i]] == MOE_C13_WAIT)) {
+            mark[ids[i]] = MOE_C13_WAIT;
+            waits = true;
+        }
+    }
+    for (const int32_t e : sl.uniq) {
+        if (mark[e] == MOE_C13_NEED) {
+            mark[e] = MOE_C13_GONE;
+            sl.subst_gone.push_back(e);
+        }
+    }
+    if (cnt.n_pairs == 0) {
+        sl.subst.clear();
+    }
+    return waits;
+}
