+// C13's weight multipliers (see subst_w in the header), once the call's substitutions stand: subst_f for runahead's
+// approximate pass, and drop_mask - the exact path's, already holding the drop rule's - on the tokens with a substitute.
+// SUBST_W=0 leaves both at 1 on a substituted pair: the substitute takes the routed expert's weight. SUBST_W=1 gives it its
+// own unbiased probability, the token renormalised over its new set (or, without norm_w, p_sub/p_orig of the routed
+// expert's weight, the other pairs unchanged); the drop rule's multipliers of such a token are made again on the
+// substituted weights - 0 on a dropped pair, and with DROP_RENORM the kept ones scaled back up to the token's full weight.
+// A token whose probabilities do not allow it (a p that is 0 or not finite) keeps SUBST_W=0's. Every subst_f is > 0.
+static void moe_c13_weights_locked(const llama_moe_stream & mgr, llama_moe_stream_layer & sl, const int32_t * ids,
+        const float * w, const float * probs, int64_t k, int64_t n_tok) {
+    const int64_t E = sl.n_expert;
+    sl.subst_f.assign((size_t) (k*n_tok), 1.0f);
+    if (mgr.subst_w != 1) {
+        return;
+    }
+    float f[64];
+    GGML_ASSERT(k <= 64);
+    for (int64_t t = 0; t < n_tok; t++) {
+        const int32_t * tid  = ids + t*k;
+        const int32_t * tsub = sl.subst.data() + t*k;
+        const float   * prow = probs + t*E;
+        bool any = false;
+        for (int64_t j = 0; j < k; j++) {
+            any = any || tsub[j] >= 0;
+        }
+        if (!any) {
+            continue;
+        }
+        double S  = 0.0; // the token's routed experts
+        double S2 = 0.0; // its experts after the substitution
+        for (int64_t j = 0; j < k; j++) {
+            S  += prow[tid[j]];
+            S2 += tsub[j] >= 0 ? prow[tsub[j]] : prow[tid[j]];
+        }
+        bool ok = std::isfinite(S) && std::isfinite(S2) && S > 0.0 && S2 > 0.0;
+        for (int64_t j = 0; j < k && ok; j++) {
+            if (tsub[j] >= 0) {
+                const double po = prow[tid[j]];
+                const double ps = prow[tsub[j]];
+                f[j] = po > 0.0 ? (float) (sl.subst_norm ? (ps*S)/(po*S2) : ps/po) : 0.0f;
+            } else {
+                f[j] = sl.subst_norm ? (float) (S/S2) : 1.0f;
+            }
+            ok = std::isfinite(f[j]) && f[j] > 0.0f;
+        }
+        if (!ok) {
+            continue;
+        }
+        float s      = 0.0f;
+        float s_drop = 0.0f;
+        for (int64_t j = 0; j < k; j++) {
+            const float wj = w[t*k + j]*f[j];
+            s += wj;
+            if (tsub[j] < 0 && sl.touched[tid[j]] >= 2) {
+                s_drop += wj;
+            }
+        }
+        const float r = mgr.drop_renorm && s_drop > 0.0f && s > s_drop ? s/(s - s_drop) : 1.0f;
+        for (int64_t j = 0; j < k; j++) {
+            sl.subst_f[t*k + j]   = f[j];
+            sl.drop_mask[t*k + j] = tsub[j] < 0 && sl.touched[tid[j]] >= 2 ? 0.0f : f[j]*r;
+        }
+    }
+}
