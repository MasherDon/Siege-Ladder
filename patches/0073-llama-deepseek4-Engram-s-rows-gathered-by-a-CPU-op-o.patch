+++ b/src/llama-graph.h
@@ -738,6 +738,25 @@ public:
 
     std::vector<ggml_tensor *> kv; // per engram layer: F32 [n_hash_cols*head_dim, n_tokens]
 
+    // SiegeLadder G23 step 2 (on by default, LLAMA_ENGRAM_LATE=0 - off; decode-sized ubatches): an engram layer's rows are gathered by a CPU op
+    // of the graph right before the first reader of that layer (lookup), not in set_input. With the graph reused (G23)
+    // nothing stood between the read-ahead (G26) and set_input any more; now the layers before the engram layer give
+    // the page faults their time back. set_input then only writes the history and keeps the ubatch for the ops; the
+    // first op joins the read-ahead
+    bool late = false;
+    const llama_ubatch * late_ub = nullptr; // the ubatch of the current compute (set_input), null in a reserve
+    struct late_fill {
+        llm_graph_input_engram * inp = nullptr;
+        uint32_t                 e   = 0;
+    };
+    std::vector<late_fill>     late_ud; // [engram_n_layer], the fill ops' userdata (sized once at build: stable)
+    std::vector<ggml_tensor *> late_t;  // [engram_n_layer], the fill ops, made at the first reader
+    // the lookup tensor of engram layer e for the graph: kv[e] (a graph input) or, with late, its fill op
+    ggml_tensor * lookup(ggml_context * ctx, uint32_t e);
+    // the rows of engram layer e for ubatch ub into dst (F32 [n_hash_cols*head_dim, n_tokens])
+    void fill_layer(uint32_t e, float * dst, const llama_ubatch & ub);
+    void fill_op(uint32_t e, ggml_tensor * dst);
+
     const llama_hparams & hparams;
     const llama_model   & model;
 
