 void llm_graph_input_engram::set_input(const llama_ubatch * ubatch) {
+    if (late) {
+        // G23 step 2: the history now, the rows in the graph's fill ops - the first of them joins the read-ahead
+        late_ub = nullptr;
+        if (kv.empty() || ubatch == nullptr || ubatch->token == nullptr) {
+            return;
+        }
+        auto * cache = mctx->get_kv();
+        GGML_ASSERT(cache != nullptr && cache->engram_enabled());
+        const int32_t * token_map = (const int32_t *) model.engram_token_map->data;
+        for (uint32_t i = 0; i < ubatch->n_tokens; ++i) {
+            cache->engram_set(ubatch->seq_id[i][0], ubatch->pos[i], token_map[ubatch->token[i]]);
+        }
+        late_ub = ubatch;
+        return;
+    }
     if (ahead.joinable()) {
         // G26: the rows faulted in ahead (read_ahead); what is left of that wait is on the graph's path
         llama_moe_stream_nvtx_push("engram_wait");
@@ -260,6 +275,47 @@ void llm_graph_input_engram::set_input(const llama_ubatch * ubatch) {
     auto * cache = mctx->get_kv();
     GGML_ASSERT(cache != nullptr && cache->engram_enabled());
 
+    const int32_t * token_map = (const int32_t *) model.engram_token_map->data;
+    const uint32_t  n_tokens  = ubatch->n_tokens;
+    const size_t    row       = (size_t) hparams.engram_n_hash_cols*hparams.engram_head_dim;
+
+    // the whole batch goes into the history first: an n-gram inside the batch looks back at
+    // tokens of this same batch
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        cache->engram_set(ubatch->seq_id[i][0], ubatch->pos[i], token_map[ubatch->token[i]]);
+    }
+
+    std::vector<float> buf(row*n_tokens);
+
+    // H4. These rows are random reads over a 189 GiB mapping, issued one at a time on the
+    // thread the graph is waiting on. The addresses come from the token ids alone, so nothing
+    // about them has to wait for anything -- which is the whole reason this is worth timing.
+    static int64_t t_engram_us  = 0;
+    static int64_t n_engram_row = 0;
+    static int64_t n_engram_set = 0;
+    const int64_t t0_engram = ggml_time_us();
+    const llama_moe_stream_nvtx_range nvtx_engram("engram"); // SiegeLadder G26: its share of set_inputs under Nsight
+
+    for (uint32_t e = 0; e < hparams.engram_n_layer; ++e) {
+        fill_layer(e, buf.data(), *ubatch);
+        ggml_backend_tensor_set(kv[e], buf.data(), 0, row*n_tokens*sizeof(float));
+    }
+
+    t_engram_us  += ggml_time_us() - t0_engram;
+    n_engram_row += (int64_t) hparams.engram_n_layer * n_tokens * hparams.engram_n_hash_cols;
+    n_engram_set++;
+    if ((n_engram_set % 64) == 0) {
+        LLAMA_LOG_DEBUG("engram: %" PRId64 " us over %" PRId64 " set_input calls, %" PRId64 " rows "
+                "(%.3f ms per call, %.1f us per row)\n",
+                t_engram_us, n_engram_set, n_engram_row,
+                t_engram_us/1000.0/n_engram_set, (double) t_engram_us/n_engram_row);
+    }
+}
