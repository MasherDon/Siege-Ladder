+void llm_graph_input_engram::fill_op(uint32_t e, ggml_tensor * dst) {
+    if (ahead.joinable()) {
+        // G26: what is left of the read-ahead - here, after the layers before this one
+        llama_moe_stream_nvtx_push("engram_wait");
+        ahead.join();
