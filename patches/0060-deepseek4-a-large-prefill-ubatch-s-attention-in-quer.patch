 }
 
+// SiegeLadder P13 (models/deepseek4.cpp, build_attention_impl): the attention of a big prefill ubatch in chunks of
+// queries, each with its own window rows of the ring and its own compressed width.
+//   LLAMA_DSV4_ATTN_QCHUNK=nq          chunks of at most nq queries, as equal as possible (0 = off, the default)
+//   LLAMA_DSV4_ATTN_QCHUNK_MIN=m       only ubatches of at least m tokens (default 2*nq)
+//   LLAMA_DSV4_ATTN_QCHUNK_IDENTITY=1  the check of the gather and the masks: every ubatch of at least _MIN tokens
+//                                      (default 2) takes one chunk with all n_kv ring rows in ring order and the full
+//                                      compressed widths, so its K and masks equal the old concatenations bit for bit,
+//                                      and the logits must equal those of the attention of before
+// Only one sequence without coupled tokens, FlashAttention, causal attention, standard SWA and an f16 / q8_0 / q4_0
+// cache (their gather round trip is exact, as on the sparse decode path); any other ubatch keeps the attention of before
+struct dsv4_p13_env {
+    int64_t nq       = 0;
+    int64_t n_min    = 0;
+    bool    identity = false;
+};
+
+static const dsv4_p13_env & dsv4_p13_get_env() {
+    static const dsv4_p13_env env = [] {
+        dsv4_p13_env e;
+
+        const char * s = getenv("LLAMA_DSV4_ATTN_QCHUNK");
+        e.nq = s != nullptr ? std::max<int64_t>(0, (int64_t) atoll(s)) : 0;
+        if (e.nq > 0 && e.nq < 256) {
+            // every chunk adds ~25 nodes per layer and a FlashAttention call; below 256 queries it only costs
+            LLAMA_LOG_WARN("%s: SiegeLadder P13: LLAMA_DSV4_ATTN_QCHUNK=%lld raised to 256\n", __func__, (long long) e.nq);
+            e.nq = 256;
+        }
+
+        s = getenv("LLAMA_DSV4_ATTN_QCHUNK_IDENTITY");
+        e.identity = s != nullptr && atoi(s) != 0;
+
+        s = getenv("LLAMA_DSV4_ATTN_QCHUNK_MIN");
+        e.n_min = s != nullptr ? std::max<int64_t>(0, (int64_t) atoll(s)) : 0;
+        if (e.n_min == 0) {
+            e.n_min = e.identity ? 2 : 2*e.nq;
+        }
+        e.n_min = std::max<int64_t>(2, e.n_min);
+
+        if (e.identity) {
+            LLAMA_LOG_WARN("%s: SiegeLadder P13 identity mode (LLAMA_DSV4_ATTN_QCHUNK_IDENTITY=1): ubatches of %lld+ "
+                    "tokens attend in one chunk over the gathered ring and the full compressed widths - a check of the "
+                    "gather and the masks, bitwise against the attention of before, not a speed-up\n",
+                    __func__, (long long) e.n_min);
+        } else if (e.nq > 0) {
+            LLAMA_LOG_INFO("%s: SiegeLadder P13: ubatches of %lld+ tokens attend in chunks of at most %lld queries "
+                    "(LLAMA_DSV4_ATTN_QCHUNK)\n", __func__, (long long) e.n_min, (long long) e.nq);
+        }
+
+        return e;
+    }();
+
+    return env;
+}
+
+// the chunk plan of a ubatch: its shapes only (the rows and the mask are set_input's). The same at graph build, in
+// can_reuse and - from the same cells - at set_input
+static llm_graph_input_dsv4::p13_plan dsv4_p13_build_plan(
+        const llama_cparams & cparams,
+        const llama_hparams & hparams,
+        const llama_kv_cache_dsv4_context * mctx,
+        const llama_ubatch & ubatch) {
+    llm_graph_input_dsv4::p13_plan plan;
+
+    const dsv4_p13_env & env = dsv4_p13_get_env();
+    if (env.nq <= 0 && !env.identity) {
+        return plan;
+    }
+
+    const int64_t nt = ubatch.n_tokens;
+    if (nt < env.n_min || !cparams.flash_attn || !cparams.causal_attn || hparams.use_alibi || ubatch.is_pos_2d() ||
+            hparams.swa_type != LLAMA_SWA_TYPE_STANDARD || hparams.n_swa == 0) {
+        return plan;
+    }
+
+    const llama_kv_cache_dsv4_raw_context * raw = mctx->get_raw();
+
+    const ggml_type type_k = raw->get_type_k();
+    if (type_k != GGML_TYPE_F16 && type_k != GGML_TYPE_Q8_0 && type_k != GGML_TYPE_Q4_0) {
+        return plan;
+    }
+
+    const auto & plan_csa = mctx->get_csa_plan(ubatch);
+    const auto & plan_hca = mctx->get_hca_plan(ubatch);
+    if (plan_csa.n_stream != 1 || plan_hca.n_stream != 1) {
+        return plan;
+    }
+
+    // the reserve graph has neither cells nor positions behind its ubatch: it takes the full compressed widths
+    const bool reserve = mctx->is_reserve();
+    if (!reserve) {
+        if (ubatch.n_seqs_unq != 1 || (int64_t) raw->get_n_write() != nt) {
+            return plan;
+        }
+        for (int64_t i = 0; i < nt; ++i) {
+            if (ubatch.n_seq_id[i] != 1 || ubatch.pos[i] < 0) {
+                return plan;
+            }
+        }
+    }
+
+    const int64_t n_chunk = env.identity ? 1 : (nt + env.nq - 1)/env.nq;
+
+    // a ubatch runs chunks as equal as possible, at most nq each; the reserve graph runs chunks of exactly nq, the
+    // widest any ubatch can get (balanced chunks of a smaller ubatch reach nq: 2 x 1665 at nq 1665 against 4 x 1536
+    // at -ub 6144), so its window rows, FlashAttention outputs and masks bound every chunk the buffers will see
+    std::vector<int64_t> t0(n_chunk + 1);
+    int64_t n_max = 0;
+    for (int64_t c = 0; c <= n_chunk; ++c) {
+        t0[c] = reserve && !env.identity ? std::min<int64_t>(c*env.nq, nt) : c*nt/n_chunk;
+        if (c > 0) {
+            n_max = std::max<int64_t>(n_max, t0[c] - t0[c - 1]);
+        }
+    }
+
+    // a chunk of n consecutive positions needs n + n_swa - 1 window rows; FlashAttention with the 512-wide head takes
+    // K only in multiples of 256 (anything else sends it to the CPU)
+    const int64_t raw_len = env.identity ? (int64_t) raw->get_n_kv() : GGML_PAD(n_max + (int64_t) hparams.n_swa - 1, 256);
+    if (raw_len <= 0 || raw_len % 256 != 0) {
+        return plan;
+    }
+
+    if (!reserve && !env.identity) {
+        // the window rows of a chunk are the cells of its sequence from its first position - (n_swa - 1) to its last.
+        // Positions with gaps can make more of them than raw_len: such a ubatch keeps the attention of before
+        const llama_seq_id     seq_id = ubatch.seq_id[0][0];
+        const llama_kv_cells & cells  = raw->get_cells(seq_id);
+
+        for (int64_t c = 0; c < n_chunk; ++c) {
+            llama_pos p_lo = ubatch.pos[t0[c]];
+            llama_pos p_hi = p_lo;
+            for (int64_t i = t0[c]; i < t0[c + 1]; ++i) {
+                p_lo = std::min(p_lo, ubatch.pos[i]);
+                p_hi = std::max(p_hi, ubatch.pos[i]);
+            }
+            p_lo -= (llama_pos) hparams.n_swa - 1;
+
+            int64_t n_rows = 0;
+            for (uint32_t j = 0; j < cells.size(); ++j) {
+                if (!cells.is_empty(j) && cells.seq_has(j, seq_id)) {
+                    const llama_pos p0 = cells.pos_get(j);
+                    n_rows += p0 >= p_lo && p0 <= p_hi ? 1 : 0;
+                }
+            }
+            if (n_rows > raw_len) {
+                static bool warned = false;
+                if (!warned) {
+                    warned = true;
+                    LLAMA_LOG_WARN("%s: SiegeLadder P13: a chunk of a %lld-token ubatch needs %lld window rows, more than "
+                            "its %lld - positions with gaps; such ubatches attend as before\n", __func__,
+                            (long long) nt, (long long) n_rows, (long long) raw_len);
+                }
+                return plan;
+            }
+        }
+    }
+
+    // the compressed columns of a chunk: up to its widest query, padded to 256 like the plan's own n_kv; a column past
+    // a query's n_visible is masked for it anyway, so the narrower K drops only -inf entries
+    const auto widths = [&](const llama_kv_cache_dsv4_context::comp_plan & cp) {
+        std::vector<int64_t> w(n_chunk, 0);
+        if (cp.n_kv <= 0) {
+            return w;
+        }
+        for (int64_t c = 0; c < n_chunk; ++c) {
+            if (env.identity || reserve) {
+                w[c] = cp.n_kv;
+                continue;
+            }
+            GGML_ASSERT((int64_t) cp.n_visible.size() == nt);
+            int64_t n_vis = 0;
+            for (int64_t i = t0[c]; i < t0[c + 1]; ++i) {
+                n_vis = std::max<int64_t>(n_vis, cp.n_visible[i]);
+            }
+            w[c] = std::min<int64_t>(cp.n_kv, std::max<int64_t>(256, GGML_PAD(n_vis, 256)));
+        }
+        return w;
+    };
+
+    plan.w_csa    = widths(plan_csa);
+    plan.w_hca    = widths(plan_hca);
+    plan.n_chunk  = n_chunk;
+    plan.raw_len  = raw_len;
+    plan.identity = env.identity;
+    plan.t0       = std::move(t0);
+
+    return plan;
+}
+
+static std::string dsv4_p13_list(const std::vector<int64_t> & values) {
+    std::ostringstream ss;
+    ss << "[";
+    for (size_t i = 0; i < values.size(); ++i) {
+        if (i > 0) {
+            ss << ", ";
+        }
+        ss << values[i];
+    }
+    ss << "]";
+    return ss.str();
+}
+
+// the rows and the mask of the chunks: for each chunk the cells of its window - sorted by position, padded with a real
+// row masked for every query - or, in the identity mode, cells 0 .. n_kv - 1 of the ring as the old raw view had them;
+// the mask follows the rules of the whole-ring mask (llama_kv_cache::set_input_kq_mask, causal, standard SWA)
+static void dsv4_p13_set_input(const llm_graph_input_dsv4 & inp, const llama_ubatch & ubatch) {
+    const auto & plan = inp.p13;
+    if (plan.n_chunk == 0 || !inp.p13_rows || !inp.p13_rows->buffer || !inp.p13_mask || !inp.p13_mask->buffer) {
+        return;
+    }
+
+    const int64_t nt      = ubatch.n_tokens;
+    const int64_t raw_len = plan.raw_len;
+
+    GGML_ASSERT(plan.t0.back() == nt);
+    GGML_ASSERT(inp.p13_rows->type == GGML_TYPE_I32 && inp.p13_rows->ne[0] == raw_len*plan.n_chunk);
+    GGML_ASSERT(inp.p13_mask->type == GGML_TYPE_F16 && inp.p13_mask->ne[0] == raw_len && inp.p13_mask->ne[1] == nt);
+    GGML_ASSERT(ggml_backend_buffer_is_host(inp.p13_rows->buffer));
+    GGML_ASSERT(ggml_backend_buffer_is_host(inp.p13_mask->buffer));
+
+    const llama_kv_cache_dsv4_raw_context * raw = inp.mctx->get_raw();
+
+    const llama_seq_id     seq_id = ubatch.seq_id[0][0];
+    const llama_kv_cells & cells  = raw->get_cells(seq_id);
+    const int64_t          off    = (int64_t) raw->get_stream()*raw->get_size();
+    const llama_pos        n_swa  = (llama_pos) inp.p13_n_swa;
+
+    int32_t     * rows = (int32_t     *) inp.p13_rows->data;
+    ggml_fp16_t * mask = (ggml_fp16_t *) inp.p13_mask->data;
+
+    const ggml_fp16_t f16_zero = llama_cast<ggml_fp16_t>(0.0f);
+    const ggml_fp16_t f16_ninf = llama_cast<ggml_fp16_t>(-INFINITY);
+
+    std::vector<uint32_t>  cell    (raw_len, 0);
+    std::vector<llama_pos> cell_pos(raw_len, -1); // -1: padding, an empty cell or another sequence's - masked for all
+    std::vector<std::pair<llama_pos, uint32_t>> found;
+
+    for (int64_t c = 0; c < plan.n_chunk; ++c) {
+        const int64_t i0 = plan.t0[c];
+        const int64_t i1 = plan.t0[c + 1];
+
+        int64_t n_rows = 0;
+        if (plan.identity) {
+            GGML_ASSERT(raw_len <= (int64_t) cells.size());
+            for (int64_t r = 0; r < raw_len; ++r) {
+                cell[r] = (uint32_t) r;
+            }
+            n_rows = raw_len;
+        } else {
+            llama_pos p_lo = ubatch.pos[i0];
+            llama_pos p_hi = p_lo;
+            for (int64_t i = i0; i < i1; ++i) {
+                p_lo = std::min(p_lo, ubatch.pos[i]);
+                p_hi = std::max(p_hi, ubatch.pos[i]);
+            }
+            p_lo -= n_swa - 1;
+
+            found.clear();
+            for (uint32_t j = 0; j < cells.size(); ++j) {
+                if (!cells.is_empty(j) && cells.seq_has(j, seq_id)) {
+                    const llama_pos p0 = cells.pos_get(j);
+                    if (p0 >= p_lo && p0 <= p_hi) {
+                        found.emplace_back(p0, j);
+                    }
+                }
+            }
+            GGML_ASSERT((int64_t) found.size() <= raw_len && "P13: more window rows than the plan has room for");
+            std::sort(found.begin(), found.end());
+
+            n_rows = (int64_t) found.size();
+            for (int64_t r = 0; r < n_rows; ++r) {
+                cell[r] = found[r].second;
+            }
+        }
+
+        for (int64_t r = 0; r < raw_len; ++r) {
+            if (r < n_rows) {
+                const uint32_t j = cell[r];
+                rows[c*raw_len + r] = (int32_t) (off + j);
+                cell_pos[r] = !cells.is_empty(j) && cells.seq_has(j, seq_id) ? cells.pos_get(j) : -1;
+            } else {
+                rows[c*raw_len + r] = (int32_t) (off + (n_rows > 0 ? cell[0] : 0));
+                cell_pos[r] = -1;
+            }
+        }
+
+        // a cell of the token's sequence, not after it, inside its window: p1 - p0 < n_swa (is_masked_swa, standard)
+        for (int64_t i = i0; i < i1; ++i) {
+            const llama_pos p1 = ubatch.pos[i];
+            ggml_fp16_t * m = mask + i*raw_len;
+            for (int64_t r = 0; r < raw_len; ++r) {
+                const llama_pos p0 = cell_pos[r];
+                m[r] = p0 >= 0 && p0 <= p1 && p1 - p0 < n_swa ? f16_zero : f16_ninf;
+            }
+        }
+    }
+
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        std::vector<int64_t> n_tok(plan.n_chunk);
+        for (int64_t c = 0; c < plan.n_chunk; ++c) {
+            n_tok[c] = plan.t0[c + 1] - plan.t0[c];
+        }
+        LLAMA_LOG_INFO("%s: SiegeLadder P13%s: the first ubatch so planned - %lld tokens in %lld chunk(s) (nq = %lld): "
+                "tokens %s, window rows per chunk %lld (of %u ring cells), compressed columns CSA %s, HCA %s\n",
+                __func__, plan.identity ? " identity mode" : "", (long long) nt, (long long) plan.n_chunk,
+                (long long) dsv4_p13_get_env().nq, dsv4_p13_list(n_tok).c_str(), (long long) raw_len,
+                raw->get_size(), dsv4_p13_list(plan.w_csa).c_str(), dsv4_p13_list(plan.w_hca).c_str());
+    }
+}
+
 void llm_graph_input_dsv4_raw::set_input(const llama_ubatch * ubatch) {
     if (self_k_idxs && self_k_idxs->buffer) {
         mctx->set_input_k_idxs(self_k_idxs);
@@ -1287,6 +1599,8 @@ void llm_graph_input_dsv4::set_input(const llama_ubatch * ubatch) {
     if (inp_lid.k_rot && inp_lid.k_rot->buffer) {
         mctx->get_lid()->set_input_k_rot(inp_lid.k_rot);
     }
+
+    dsv4_p13_set_input(*this, *ubatch);
 }
 
 bool llm_graph_input_dsv4::can_reuse(const llm_graph_params & params) {
@@ -1316,6 +1630,9 @@ bool llm_graph_input_dsv4::can_reuse(const llm_graph_params & params) {
     res &= dsv4_can_reuse_comp_input(inp_hca, plan_hca, params.ubatch.n_tokens, n_stream);
     res &= dsv4_can_reuse_comp_input(inp_lid, plan_lid, params.ubatch.n_tokens, n_stream);
 
+    // SiegeLadder P13: the chunks are graph structure (views, widths, how many FlashAttention calls)
+    res &= dsv4_p13_build_plan(params.cparams, params.hparams, mctx, params.ubatch) == p13;
+
     return res;
 }
 
@@ -4113,6 +4430,36 @@ llm_graph_input_dsv4 * llm_graph_context::build_inp_dsv4() const {
     inp->inp_hca.k_rot = mctx_cur->get_hca()->build_input_k_rot(ctx0);
     inp->inp_lid.k_rot = mctx_cur->get_lid()->build_input_k_rot(ctx0);
 
+    // SiegeLadder P13: the chunk plan of this ubatch and its two inputs (off by default: no tensors, the graph of before)
+    inp->p13       = dsv4_p13_build_plan(cparams, hparams, mctx_cur, ubatch);
+    inp->p13_n_swa = hparams.n_swa;
+    if (inp->p13.n_chunk > 0) {
+        inp->p13_rows = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, inp->p13.raw_len*inp->p13.n_chunk);
+        ggml_set_input(inp->p13_rows);
+        ggml_set_name(inp->p13_rows, "dsv4_p13_rows");
+
+        inp->p13_mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F16, inp->p13.raw_len, ubatch.n_tokens);
+        ggml_set_input(inp->p13_mask);
+        ggml_set_name(inp->p13_mask, "dsv4_p13_kq_mask");
+
+        // the chunks' views of the input masks, once per graph (see p13_mask_c)
+        const auto & p13 = inp->p13;
+        for (int64_t c = 0; c < p13.n_chunk; ++c) {
+            const int64_t i0 = p13.t0[c];
+            const int64_t n  = p13.t0[c + 1] - i0;
+
+            ggml_tensor * m = inp->p13_mask;
+            inp->p13_mask_c.push_back(p13.n_chunk == 1 ? m :
+                    ggml_view_2d(ctx0, m, p13.raw_len, n, m->nb[1], (size_t) i0*m->nb[1]));
+
+            ggml_tensor * h = inp->inp_hca.kq_mask;
+            if (h != nullptr && p13.w_hca[c] > 0) {
+                inp->p13_hca_c.push_back(p13.n_chunk == 1 && p13.w_hca[c] == h->ne[0] ? h :
+                        ggml_view_2d(ctx0, h, p13.w_hca[c], n, h->nb[1], (size_t) i0*h->nb[1]));
+            }
+        }
+    }
+
     return (llm_graph_input_dsv4 *) res->add_input(std::move(inp));
 }
 
diff --git a/src/llama-graph.h b/src/llama-graph.h
index b64cdba..12fd2eb 100644
