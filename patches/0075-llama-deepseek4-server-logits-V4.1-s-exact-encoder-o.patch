diff --git a/src/llama-hparams.cpp b/src/llama-hparams.cpp
index 846d4c6..4ed0019 100644
--- a/src/llama-hparams.cpp
+++ b/src/llama-hparams.cpp
@@ -281,6 +281,39 @@ uint32_t llama_hparams::n_layer() const {
     return n_layer_all - n_layer_nextn;
 }
 
+// SiegeLadder P4 (docs/v41 theories, row P4; design - docs/v41/p4-design.md). A DSV4 layer reads the compressed caches of
+// the last KV source at or before it (dsv4_kv_src_layer; the index keys too), and only a source writes any: so from the last
+// source on, the only state a layer leaves for other positions is its own window ring. A layer at position p attends over
+// its ring at p - (n_swa - 1) .. p (is_masked_swa, standard), written from the layer below at those positions; k layers
+// after the source the chain reaches back k*(n_swa - 1). With the source's caches and its own ring row written for every
+// position, the decoder's work is needed only at positions >= q - reach for a logit at q, and >= c - reach for the state
+// left after the first c positions (the rings at c - (n_swa - 1) .. c - 1). V4.1: source 20, 19 layers after it, n_swa 128
+// - 2413 positions
+int32_t llama_hparams::dsv4_dec_first() const {
+    if (!dsv4_v41 || n_swa == 0 || swa_type != LLAMA_SWA_TYPE_STANDARD) {
+        return -1;
+    }
+    int32_t src = -1;
+    for (uint32_t il = 0; il < n_layer(); ++il) {
+        if (!is_swa(il)) {
+            return -1; // a raw cache of every position: its rows would be needed everywhere
+        }
+        if (dsv4_is_kv_source[il]) {
+            src = (int32_t) il;
+        }
+    }
+    // the source's attention input collapses with the mix the FFN before it carried: it needs one
+    return src > 0 ? src : -1;
+}
+
+int32_t llama_hparams::dsv4_dec_reach() const {
+    const int32_t src = dsv4_dec_first();
+    if (src < 0) {
+        return 0;
+    }
+    return ((int32_t) n_layer() - 1 - src)*((int32_t) n_swa - 1);
+}
+
 bool llama_hparams::use_mrope() const {
     return rope_sections[0] > 0 && rope_sections[1] > 0;
 }
diff --git a/src/llama-hparams.h b/src/llama-hparams.h
index 69a7eca..a7b1056 100644
--- a/src/llama-hparams.h
+++ b/src/llama-hparams.h
