+            int32_t       reach = model.hparams.dsv4_dec_reach();
+            const char *  why   = nullptr;
+            if (model.arch != LLM_ARCH_DEEPSEEK41 || first < 0 || reach <= 0) {
+                why = "the model is not V4.1's causal encoder-decoder";
+            } else if (cparams.embeddings || cparams.embeddings_nextn || cparams.ctx_type != LLAMA_CONTEXT_TYPE_DEFAULT) {
+                why = "embedding and MTP contexts read the last layer's state of every position";
+            } else if (std::getenv("LLAMA_DSV41_NO_HC_THREAD") != nullptr) {
+                why = "LLAMA_DSV41_NO_HC_THREAD (a measurement) collapses each sublayer with its own mix";
+            }
+            // on by default: another model needs no word about it
+            if (why != nullptr && !p4_asked && model.arch != LLM_ARCH_DEEPSEEK41) {
+                why = nullptr;
+            } else if (why != nullptr) {
+                LLAMA_LOG_WARN("%s: SiegeLadder P4 (LLAMA_DSV4_ENC_ONLY) is off: %s\n", __func__, why);
+            } else {
+                // a test of the bound only: below the model's reach the decoder starts too late and the logits differ
+                if (const char * r = std::getenv("LLAMA_DSV4_ENC_ONLY_REACH")) {
+                    const int32_t v = std::max(0, atoi(r));
+                    if (v < reach) {
+                        LLAMA_LOG_WARN("%s: SiegeLadder P4: LLAMA_DSV4_ENC_ONLY_REACH=%d is below the decoder's reach %d - "
+                                "NOT EXACT, a test of the bound\n", __func__, v, reach);
+                    }
+                    reach = v;
+                }
+                if (const char * m = std::getenv("LLAMA_DSV4_ENC_ONLY_MIN")) {
