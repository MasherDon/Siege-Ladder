         ggml_status status;
 
         const auto * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx.get(), status);
+        cparams.dsv4_enc_only = false;
 
         if (!res) {
             // the last ubatch failed or was aborted -> remove all positions of that ubatch from the memory module
@@ -2534,6 +2651,14 @@ int llama_context::decode(const llama_batch & batch_inp) {
         n_tokens_prev  += ubatch.n_tokens;
     } while (mctx->next());
 
+    if (p4_ub_call > 0) {
+        p4_n_ubatch += p4_ub_call;
+        p4_n_tokens += p4_tok_call;
+        LLAMA_LOG_INFO("%s: SiegeLadder P4: %lld of %lld ubatches (%lld of %u tokens) ran the encoder only (%lld / %lld "
+                "since the start)\n", __func__, (long long) p4_ub_call, (long long) n_ub_call, (long long) p4_tok_call,
+                n_tokens_all, (long long) p4_n_ubatch, (long long) p4_n_tokens);
+    }
+
     // SiegeLadder P1: this call had outputs while the head was out - it comes back and computes them now
     if (cparams.head_out && !p1_groups.empty()) {
         if (!p1_leave()) {
@@ -4210,6 +4335,10 @@ uint32_t llama_n_ubatch(const llama_context * ctx) {
     return ctx->n_ubatch();
 }
 
+bool llama_dsv4_enc_only(const llama_context * ctx) {
+    return ctx->p4_active();
+}
