         subst = std::min(2, std::max(0, atoi(p)));
@@ -2049,6 +2074,9 @@ void llama_moe_stream::p11_read_ahead_locked(const llama_moe_stream_layer & sl)
     if (next == nullptr) {
         return; // the last streamed layer: the next ubatch's first layer is left to its own waves
     }
+    if (graph_last_moe >= 0 && next->il > graph_last_moe) {
+        return; // SiegeLadder P4: an encoder-only graph - the next layer it runs is the next ubatch's first, as above
+    }
     // its slot table is stale (the pool has moved on), so unlike speculate_locked nothing is skipped as resident in VRAM;
     // a slab already in the host tier the worker skips
     const size_t n_w = next->weights.size();
@@ -3128,6 +3156,13 @@ void llama_moe_stream::print_stats(const char * role) const {
                     stats.n_drop_late_pairs, stats.n_drop_late_exp, stats.n_drop_late_calls);
         }
     }
+    if (g4_probe > 0) {
+        LLAMA_LOG_WARN("%s: %smoe stream: G4 probe %d (lossy): %" PRId64 " experts to the stand-in lane in %" PRId64 " calls; "
