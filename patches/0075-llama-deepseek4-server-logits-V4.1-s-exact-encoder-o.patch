+                p4_dec_start.assign(LLAMA_MAX_SEQ, -1);
+                LLAMA_LOG_WARN("%s: SiegeLadder P4: a ubatch of >= %u tokens more than %d positions before the first "
+                        "position its call hands back (an output, or the call's end) runs layers 0-%d and layer %d's "
+                        "cache writes only\n", __func__, p4_min, p4_reach, first - 1, first);
+            }
+        }
+
         sched_reserve();
 
         // P1: the -ub buffers are reserved only when the first long prompt comes. Probe them now, with the head
@@ -728,6 +771,10 @@ void llama_context::sched_reserve() {
 
     sched_need_reserve = false;
 
+    // SiegeLadder P4: the worst case is the whole model - never an encoder-only graph (decode sets the flag around one
+    // ubatch's build only; this keeps a flag left by a throw out of the reserve)
+    cparams.dsv4_enc_only = false;
+
     LLAMA_LOG_INFO("%s: reserving ...\n", __func__);
 
     synchronize();
@@ -979,6 +1026,29 @@ uint32_t llama_context::n_ubatch_reserve() const {
     return (p1_ub_small > 0 && !cparams.head_out && !p1_full) ? p1_ub_small : cparams.n_ubatch;
 }
 
+// SiegeLadder P4: a ubatch runs the encoder only when it has no output and every position of every sequence it holds lies
+// below that sequence's p4_dec_start (set per call in decode). The decoder state it leaves behind - the window rings of
+// layers 21-39 at its positions - is stale, and the call's own full ubatches after it overwrite every part of it that a
+// logit or the call's final state can reach: a decoder layer d layers past the first reads its ring back (n_swa - 1)
+// positions per layer, d*(n_swa - 1) in all, and the first decoder layer's ring and caches are written here too
+bool llama_context::p4_enc_only(const llama_ubatch & ubatch) const {
+    if (p4_reach <= 0 || ubatch.n_tokens < p4_min) {
+        return false;
+    }
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        if (ubatch.output[i]) {
+            return false;
+        }
+        for (int32_t s = 0; s < ubatch.n_seq_id[i]; ++s) {
+            const llama_seq_id seq = ubatch.seq_id[i][s];
+            if (seq < 0 || seq >= (llama_seq_id) p4_dec_start.size() || ubatch.pos[i] >= p4_dec_start[seq]) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
 void llama_context::p1_enter() {
     if (sched) {
         ggml_backend_sched_synchronize(sched.get());
@@ -2194,6 +2264,38 @@ int llama_context::decode(const llama_batch & batch_inp) {
     const uint32_t n_tokens_all  = balloc->get_n_tokens();
     const uint32_t n_outputs_all = balloc->get_n_outputs();
 
+    // SiegeLadder P4: per sequence, the first position this call must hand back exact - its first output, or the end of
+    // the call when it has none before that (the state it leaves for the next call, a checkpoint, a slot file) - less the
+    // decoder's reach. A ubatch below it in every sequence it holds runs the encoder only (p4_enc_only); from the first
+    // ubatch at or past it on, the whole model. A layer input past the encoder, wanted for every position, keeps it off
+    if (p4_reach > 0) {
+        std::fill(p4_dec_start.begin(), p4_dec_start.end(), -1);
+        // (the MTP drafter reads the last layer's hidden state of every position: such a call runs the whole model)
+        bool p4_call = !output_all && !cparams.embeddings_nextn;
+        for (size_t il = (size_t) model.hparams.dsv4_dec_first() + 1; p4_call && il < cparams.embeddings_layer_inp.size(); ++il) {
+            p4_call = !cparams.embeddings_layer_inp[il];
+        }
+        if (p4_call) {
+            const llama_batch & b = balloc->get_batch();
+            std::vector<llama_pos> first_out(LLAMA_MAX_SEQ, std::numeric_limits<llama_pos>::max());
+            std::vector<llama_pos> end(LLAMA_MAX_SEQ, -1);
+            for (int32_t i = 0; i < b.n_tokens; ++i) {
+                for (int32_t s = 0; s < b.n_seq_id[i]; ++s) {
+                    const llama_seq_id seq = b.seq_id[i][s];
+                    if (b.logits[i]) {
+                        first_out[seq] = std::min(first_out[seq], b.pos[i]);
+                    }
+                    end[seq] = std::max(end[seq], b.pos[i] + 1);
+                }
+            }
+            for (int s = 0; s < LLAMA_MAX_SEQ; ++s) {
+                if (end[s] >= 0) {
+                    p4_dec_start[s] = std::min(first_out[s], end[s]) - p4_reach;
+                }
+            }
+        }
+    }
+
     // SiegeLadder P9: the expert stream's host tier holds what a prompt touches while it runs; a long call begins the
     // holding (anew from position 0), a few short calls in a row end it - llama_moe_stream::batch_begin
     if (auto * ms = model.moe_stream()) {
@@ -2342,8 +2444,14 @@ int llama_context::decode(const llama_batch & batch_inp) {
     int64_t n_outputs_prev = 0;
     int64_t n_tokens_prev  = 0;
 
+    // SiegeLadder P4: this call's encoder-only ubatches and their tokens
+    int64_t p4_ub_call  = 0;
+    int64_t p4_tok_call = 0;
+    int64_t n_ub_call   = 0;
+
     do {
         const auto & ubatch = mctx->get_ubatch();
+        n_ub_call++;
 
         // count the outputs in this ubatch
         {
@@ -2361,9 +2469,18 @@ int llama_context::decode(const llama_batch & batch_inp) {
             n_outputs = n_outputs_new;
         }
 
+        // SiegeLadder P4: this ubatch's graph - the encoder only, or the whole model. Set for its build and reset at once,
+        // so that no reserve and no other graph ever sees it
+        cparams.dsv4_enc_only = p4_enc_only(ubatch);
+        if (cparams.dsv4_enc_only) {
+            p4_ub_call++;
+            p4_tok_call += ubatch.n_tokens;
+        }
