+        // slot of its token - a token's top pair is never dropped outside the VRAM_ONLY measurements, which runahead
+        // does not run with
+        const int64_t k = dst->ne[0]; // [n_expert_used, n_tokens]
+        for (int64_t i = 0; i < n; i++) {
+            if (out[i] >= 0) {
+                continue;
+            }
+            const int64_t t0 = (i/k)*k;
+            for (int64_t j = t0; j < t0 + k; j++) {
+                if (out[j] >= 0) {
+                    out[i] = out[j];
+                    break;
+                }
+            }
+            GGML_ASSERT(out[i] >= 0);
+        }
+    }
     mgr->fence_slots_locked(*sl, out, (size_t) n);
 }
 
