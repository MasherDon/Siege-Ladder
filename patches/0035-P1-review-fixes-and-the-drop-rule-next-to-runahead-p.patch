+void llama_moe_stream_exact_mask(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+    auto * sl = (llama_moe_stream_layer *) userdata;
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+    float * out = (float *) dst->data;
+    const int64_t n = ggml_nelements(dst);
+    std::lock_guard<std::mutex> lk(sl->mgr->mtx);
+    if ((int64_t) sl->exact_mask.size() == n) {
+        std::memcpy(out, sl->exact_mask.data(), (size_t) n*sizeof(float));
+    } else {
+        std::fill(out, out + n, 1.0f);
+    }
