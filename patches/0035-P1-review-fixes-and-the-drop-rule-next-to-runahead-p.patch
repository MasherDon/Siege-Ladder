+bool llama_model::head_pin() const {
+    if (!head_yield_ready()) {
+        return true;
+    }
+    if (pimpl->head_released && !head_restore()) {
+        return false;
+    }
+    pimpl->head_pins++;
+    return true;
+}
+
+void llama_model::head_unpin() const {
+    if (pimpl->head_pins > 0) {
+        pimpl->head_pins--;
+    }
+}
+
+bool llama_model::head_pinned() const {
+    return pimpl->head_pins > 0;
+}
+
 void llama_model::head_release() const {
-    if (!head_yield_ready() || pimpl->head_released) {
+    if (!head_yield_ready() || pimpl->head_released || pimpl->head_pins > 0) {
         return;
     }
