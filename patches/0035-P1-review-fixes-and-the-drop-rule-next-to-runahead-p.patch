     const int32_t * ids = sl->ra_ids.data();
     for (int64_t i = 0; i < n; i++) {
+        if (sl->touched[ids[i]] == 2) {
+            out[i] = -1; // dropped by the first half (the drop rule): given a kept slot of its token below
+            continue;
+        }
         const int32_t s = sl->expert_slot.at(ids[i]);
