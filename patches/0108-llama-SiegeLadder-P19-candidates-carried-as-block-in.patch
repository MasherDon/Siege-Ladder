+void llama_context::lm_reserve_probe_at_load(
+        const llama_memory_context_i * mctx, uint32_t n_tokens, uint32_t n_seqs, uint32_t n_outputs,
+        const std::vector<size_t> & full_buf_sizes) {
+    const int32_t n_layer = model.hparams.n_layer();
+    const int32_t dec     = model.hparams.dsv4_dec_first();
+    std::vector<std::pair<int32_t, int32_t>> groups;
+    for (int32_t l0 = 0; l0 < n_layer;) {
+        int32_t l1 = l0 + lm_k;
+        if (l0 < dec && l1 > dec) {
+            l1 = dec;
+        } else {
+            l1 = std::min(l1, n_layer);
+        }
+        groups.emplace_back(l0, l1);
+        l0 = l1;
+    }
+
+    // Worst C7 for reserve: full decoder MoE in the segment (no bound), same as sched_reserve's whole-model graph
+    const int32_t yoco_worst_lo  = -1;
+    const int32_t yoco_worst_cut = 0;
+
+    LLAMA_LOG_INFO("%s: layer-major reserve probe at load k=%d n_tokens=%u n_ctx=%u n_seqs=%u n_outputs=%u "
+            "(LLAMA_DSV4_LAYER_MAJOR_RESERVE)\n",
+            __func__, lm_k, n_tokens, cparams.n_ctx, n_seqs, n_outputs);
+
+    if (auto * ms = model.moe_stream()) {
+        size_t min_layer = SIZE_MAX;
+        size_t max_layer = 0;
+        uint64_t sum_layer = 0;
+        uint32_t n_streamed = 0;
+        for (const auto & sl : ms->layers) {
+            if (!sl) {
+                continue;
+            }
+            size_t nbytes = 0;
+            for (const auto & wt : sl->weights) {
+                nbytes += wt.nb_expert * (size_t) sl->n_expert;
+            }
+            LLAMA_LOG_INFO("%s: layer-major moe layer il=%d n_expert=%u n_weights=%zu expert_bytes=%.2f MiB\n",
+                    __func__, sl->il, sl->n_expert, sl->weights.size(), nbytes / 1048576.0);
+            min_layer = std::min(min_layer, nbytes);
+            max_layer = std::max(max_layer, nbytes);
+            sum_layer += nbytes;
+            n_streamed++;
+        }
+        if (n_streamed > 0) {
+            LLAMA_LOG_INFO("%s: layer-major moe expert_bytes streamed_layers=%u min=%.2f MiB max=%.2f MiB avg=%.2f MiB\n",
+                    __func__, n_streamed, min_layer / 1048576.0, max_layer / 1048576.0,
+                    (sum_layer / n_streamed) / 1048576.0);
+        }
+    }
+
+    size_t max_seg = 0;
+    for (const auto & gr : groups) {
+        const size_t sz = lm_measure_lm_segment_cuda0(n_tokens, n_seqs, n_outputs, gr.first, gr.second, false,
+                yoco_worst_lo, yoco_worst_cut, mctx);
+        LLAMA_LOG_INFO("%s: layer-major reserve probe l0=%d l1=%d enc_only=0 yoco_lo=%d yoco_cut=%d cuda0=%.2f MiB\n",
+                __func__, gr.first, gr.second, yoco_worst_lo, yoco_worst_cut, sz / 1048576.0);
+        max_seg = std::max(max_seg, sz);
+    }
+    if (dec > 0) {
+        const size_t sz = lm_measure_lm_segment_cuda0(n_tokens, n_seqs, n_outputs, 0, dec, true, yoco_worst_lo,
+                yoco_worst_cut, mctx);
+        LLAMA_LOG_INFO("%s: layer-major reserve probe l0=0 l1=%d enc_only=1 yoco_lo=%d yoco_cut=%d cuda0=%.2f MiB\n",
+                __func__, dec, yoco_worst_lo, yoco_worst_cut, sz / 1048576.0);
+        max_seg = std::max(max_seg, sz);
+    }
+
+    size_t full_cuda0 = 0;
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend_ptrs[i]);
+        if (dev != nullptr && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            const char * name = ggml_backend_dev_name(dev);
+            if (name != nullptr && std::strstr(name, "CUDA0") != nullptr) {
+                full_cuda0 = i < full_buf_sizes.size() ? full_buf_sizes[i] : 0;
+                break;
+            }
+        }
+    }
+
+    LLAMA_LOG_INFO("%s: layer-major reserve probe max segment cuda0=%.2f MiB vs sched_reserve full cuda0=%.2f MiB\n",
+            __func__, max_seg / 1048576.0, full_cuda0 / 1048576.0);
+}
+
+size_t llama_context::lm_measure_lm_segment_cuda0(
+        uint32_t n_tokens, uint32_t n_seqs, uint32_t n_outputs,
+        int32_t lm_l0, int32_t lm_l1, bool enc_only, int32_t yoco_lo, int32_t yoco_cut,
+        const llama_memory_context_i * mctx) {
+    const int32_t save_lm_l0  = cparams.dsv4_lm_l0;
+    const int32_t save_lm_l1  = cparams.dsv4_lm_l1;
+    const bool    save_enc    = cparams.dsv4_enc_only;
+    const int32_t save_yoco_lo  = cparams.dsv4_yoco_lo;
+    const int32_t save_yoco_cut = cparams.dsv4_yoco_cut;
+    auto * yoco_ms = yoco_k > 0 ? model.moe_stream() : nullptr;
+    const int64_t save_c7_row0  = yoco_ms ? yoco_ms->c7_row0 : 0;
+    const int32_t save_c7_layer0 = yoco_ms ? yoco_ms->c7_layer0 : -1;
+    const int32_t save_c7_layer1 = yoco_ms ? yoco_ms->c7_layer1 : -1;
+
+    // a segment past layer 0 reads the carried state as inputs, and one before the last layer exports it: the shapes
+    // llama_context::decode carries (the candidates as block indices, L020), with no bytes behind them - sizes only
+    using lm_carry = llama_cparams::llama_dsv4_lm_carry;
+    lm_carry fake_in;
+    lm_carry fake_out;
+    if (lm_l0 > 0) {
+        const auto & hp = model.hparams;
+        static char no_bytes; // the builder wants a host pointer; set_inputs, which would read it, never runs here
+        auto set = [&](int k, ggml_type type, int64_t ne0, int64_t ne1) {
+            fake_in.v[k].host  = &no_bytes;
+            fake_in.v[k].type  = type;
+            fake_in.v[k].ne[0] = ne0;
+            fake_in.v[k].ne[1] = ne1;
+            fake_in.v[k].ne[2] = 1;
+            fake_in.v[k].ne[3] = 1;
+        };
+        set(lm_carry::H, GGML_TYPE_F32, hp.n_embd, hp.dsv4_hc_mult);
+        fake_in.v[lm_carry::H].ne[2] = n_tokens;
+        set(lm_carry::HC, GGML_TYPE_F32, hp.dsv4_hc_mult, n_tokens);
+        bool src_before = false;
+        for (int32_t il = 0; il < lm_l0 && il < (int32_t) hp.n_layer(); ++il) {
+            src_before = src_before || hp.dsv4_is_index_source[il];
+        }
+        if (src_before && hp.indexer_top_k > 0) {
+            set(lm_carry::TOPK, GGML_TYPE_I32, hp.indexer_top_k, n_tokens);
+        }
+        if (hp.dsv4_candidate_source_layer >= 0 && lm_l0 > hp.dsv4_candidate_source_layer &&
+                hp.dsv4_candidate_block_size > 0 && hp.dsv4_candidate_topk_blocks > 0 &&
+                (int64_t) cparams.n_ctx/2/hp.dsv4_candidate_block_size > (int64_t) hp.dsv4_candidate_topk_blocks) {
+            set(lm_carry::CAND, GGML_TYPE_I32, hp.dsv4_candidate_topk_blocks, n_tokens);
+        }
+    }
+
+    cparams.dsv4_lm_l0        = lm_l0;
+    cparams.dsv4_lm_l1        = lm_l1;
+    cparams.dsv4_enc_only     = enc_only;
+    cparams.dsv4_lm_carry_in  = lm_l0 > 0 ? &fake_in : nullptr;
+    cparams.dsv4_lm_carry_out = lm_l1 < (int32_t) model.hparams.n_layer() ? &fake_out : nullptr;
+    cparams.dsv4_yoco_lo      = yoco_lo;
+    cparams.dsv4_yoco_cut     = yoco_cut;
+    if (yoco_ms) {
+        yoco_ms->c7_row0   = 0;
+        yoco_ms->c7_layer0 = model.hparams.dsv4_dec_first();
+        yoco_ms->c7_layer1 = yoco_cut > 0 ? model.hparams.dsv4_dec_first() + 1 : -1;
+    }
+
+    const size_t max_nodes = graph_max_nodes(n_tokens);
+    llm_graph_result tmp_res(max_nodes);
+    ggml_backend_sched_ptr tmp_sched(
+            ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(), backend_ptrs.size(), max_nodes,
+                    cparams.pipeline_parallel, cparams.op_offload));
+
+    ggml_backend_sched_ptr save_sched = std::move(sched);
+    sched                             = std::move(tmp_sched);
+
+    if (n_tokens % n_seqs != 0) {
+        n_tokens = ((n_tokens + (n_seqs - 1)) / n_seqs) * n_seqs;
+    }
+
