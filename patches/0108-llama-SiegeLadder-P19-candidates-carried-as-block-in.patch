+    const int32_t save_yoco_lo_build  = cparams.dsv4_yoco_lo;
+    const int32_t save_yoco_cut_build = cparams.dsv4_yoco_cut;
+    if (yoco_k > 0 && n_tokens > 1 && !yoco_nobound) {
+        cparams.dsv4_yoco_lo = 0;
+    }
+    cparams.dsv4_yoco_cut = 0;
+
+    const auto gparams = graph_params(&tmp_res, ubatch, mctx, ctx_type_to_graph_type(cparams.ctx_type));
+    cparams.dsv4_yoco_lo  = save_yoco_lo_build;
+    cparams.dsv4_yoco_cut = save_yoco_cut_build;
+
+    tmp_res.reset();
+    ggml_cgraph * gf = model.build_graph(gparams);
+    this->n_outputs  = save_n_outputs;
+
+    std::vector<size_t> sizes(backend_ptrs.size(), 0);
+    if (gf != nullptr) {
+        ggml_backend_sched_reserve_size(sched.get(), gf, sizes.data());
+    }
+
+    sched = std::move(save_sched);
+
+    cparams.dsv4_lm_l0        = save_lm_l0;
+    cparams.dsv4_lm_l1        = save_lm_l1;
+    cparams.dsv4_enc_only     = save_enc;
+    cparams.dsv4_yoco_lo      = save_yoco_lo;
+    cparams.dsv4_yoco_cut     = save_yoco_cut;
+    cparams.dsv4_lm_carry_in  = nullptr;
+    cparams.dsv4_lm_carry_out = nullptr;
+    if (yoco_ms) {
+        yoco_ms->c7_row0   = save_c7_row0;
+        yoco_ms->c7_layer0 = save_c7_layer0;
+        yoco_ms->c7_layer1 = save_c7_layer1;
+    }
+
+    size_t cuda0 = 0;
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend_ptrs[i]);
+        if (dev != nullptr && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            cuda0 = sizes[i];
+            break;
+        }
+    }
+    return cuda0;
+}
