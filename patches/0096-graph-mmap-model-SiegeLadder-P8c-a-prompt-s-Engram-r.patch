+
+bool llama_read_scattered(const std::string (&paths)[2], std::vector<llama_scatter_piece> & pieces, int n_thr, int qd) {
+#ifdef _WIN32
+    constexpr uint64_t SEC = 4096;
+    if (pieces.empty()) {
+        return true;
+    }
+    n_thr = std::max(1, n_thr);
+    qd    = std::min(std::max(1, qd), (int) MAXIMUM_WAIT_OBJECTS);
+
+    // the pieces of one sector together: a sector is read once, its pieces copied out of it
+    std::sort(pieces.begin(), pieces.end(), [](const llama_scatter_piece & a, const llama_scatter_piece & b) {
+        return a.file != b.file ? a.file < b.file : a.off < b.off;
+    });
+    std::vector<size_t> sec0; // the first piece of each sector, then pieces.size()
+    for (size_t i = 0; i < pieces.size(); ++i) {
+        const uint64_t s = pieces[i].off & ~(SEC - 1);
+        GGML_ASSERT(pieces[i].file < 2 && (pieces[i].off - s) + pieces[i].len <= SEC);
+        if (i == 0 || pieces[i].file != pieces[i - 1].file || s != (pieces[i - 1].off & ~(SEC - 1))) {
+            sec0.push_back(i);
+        }
+    }
+    sec0.push_back(pieces.size());
+    const size_t n_sec = sec0.size() - 1;
+
+    std::atomic<bool> ok { true };
+    std::vector<std::thread> ths;
+    ths.reserve(n_thr);
+    for (int t = 0; t < n_thr; ++t) {
+        ths.emplace_back([&, t] {
+            HANDLE h[2] = { INVALID_HANDLE_VALUE, INVALID_HANDLE_VALUE };
+            for (int f = 0; f < 2; ++f) {
+                if (!paths[f].empty()) {
+                    h[f] = CreateFileA(paths[f].c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                            OPEN_EXISTING, FILE_FLAG_OVERLAPPED | FILE_FLAG_NO_BUFFERING, NULL);
+                }
+            }
+            uint8_t * buf = (uint8_t *) _aligned_malloc((size_t) SEC*qd, (size_t) SEC);
+            std::vector<OVERLAPPED> ov(qd);
+            std::vector<HANDLE>     ev(qd, NULL);
+            std::vector<size_t>     sec_of(qd, 0);
+            bool ready = buf != nullptr;
+            for (int q = 0; q < qd && ready; ++q) {
+                ev[q] = CreateEventA(NULL, TRUE, FALSE, NULL);
+                ready = ev[q] != NULL;
+            }
+            if (!ready) {
+                ok = false;
+            }
+            size_t next = (size_t) t; // this thread's sectors: t, t + n_thr, ...
+            // start the next read of this thread into slot q; false when there is none left (or a read failed)
+            auto issue = [&](int q) -> bool {
+                if (!ok || next >= n_sec) {
+                    return false;
+                }
+                const size_t j = next;
+                next += (size_t) n_thr;
+                const llama_scatter_piece & p = pieces[sec0[j]];
+                if (h[p.file] == INVALID_HANDLE_VALUE) {
+                    ok = false;
+                    return false;
+                }
+                const uint64_t off = p.off & ~(SEC - 1);
+                std::memset(&ov[q], 0, sizeof(OVERLAPPED));
+                ov[q].Offset     = (DWORD) off;
+                ov[q].OffsetHigh = (DWORD) (off >> 32);
+                ov[q].hEvent     = ev[q];
+                sec_of[q] = j;
+                if (!ReadFile(h[p.file], buf + (size_t) q*SEC, (DWORD) SEC, NULL, &ov[q]) && GetLastError() != ERROR_IO_PENDING) {
+                    ok = false;
+                    return false;
+                }
+                return true;
+            };
+            std::vector<HANDLE> wait_ev;
+            std::vector<int>    wait_q;
+            for (int q = 0; q < qd && ready; ++q) {
+                if (!issue(q)) {
+                    break;
+                }
+                wait_ev.push_back(ev[q]);
+                wait_q.push_back(q);
+            }
+            // reap: copy each finished sector's pieces out and reuse its slot; after a failure no new read starts, the
+            // ones in flight are still waited for (they write into buf)
+            while (!wait_ev.empty()) {
+                const DWORD r = WaitForMultipleObjects((DWORD) wait_ev.size(), wait_ev.data(), FALSE, INFINITE);
+                if (r >= WAIT_OBJECT_0 + wait_ev.size()) {
+                    ok = false;
+                    for (size_t i = 0; i < wait_ev.size(); ++i) { // the slots' reads still owe their completion
+                        DWORD got = 0;
+                        GetOverlappedResult(h[pieces[sec0[sec_of[wait_q[i]]]].file], &ov[wait_q[i]], &got, TRUE);
+                    }
+                    break;
+                }
+                const size_t i = r - WAIT_OBJECT_0;
+                const int    q = wait_q[i];
+                const size_t j = sec_of[q];
+                DWORD got = 0;
+                if (!GetOverlappedResult(h[pieces[sec0[j]].file], &ov[q], &got, FALSE)) {
+                    ok = false;
+                    got = 0;
+                }
+                const uint64_t base = pieces[sec0[j]].off & ~(SEC - 1);
+                for (size_t k = sec0[j]; k < sec0[j + 1]; ++k) {
+                    const uint64_t in = pieces[k].off - base;
+                    if (in + pieces[k].len <= got) {
+                        std::memcpy(pieces[k].dst, buf + (size_t) q*SEC + in, pieces[k].len);
+                    } else {
+                        ok = false;
+                    }
+                }
+                if (!issue(q)) {
+                    wait_ev[i] = wait_ev.back();
+                    wait_q[i]  = wait_q.back();
+                    wait_ev.pop_back();
+                    wait_q.pop_back();
+                }
+            }
+            for (HANDLE e : ev) {
+                if (e != NULL) {
+                    CloseHandle(e);
+                }
+            }
+            for (HANDLE x : h) {
+                if (x != INVALID_HANDLE_VALUE) {
+                    CloseHandle(x);
+                }
+            }
+            if (buf != nullptr) {
+                _aligned_free(buf);
+            }
+        });
+    }
+    for (auto & th : ths) {
+        th.join();
+    }
+    return ok;
+#else
+    GGML_UNUSED(paths); GGML_UNUSED(pieces); GGML_UNUSED(n_thr); GGML_UNUSED(qd);
+    return false;
+#endif
+}
