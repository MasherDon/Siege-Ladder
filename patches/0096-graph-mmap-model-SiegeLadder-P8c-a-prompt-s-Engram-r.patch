 #include <cstdint>
 #include <memory>
+#include <string>
 #include <vector>
 #include <cstdio>
 
@@ -104,3 +105,17 @@ size_t llama_path_max();
 // needs any of them, so the alternative is one fault at a time on the thread that is waited
 // on. Best effort by definition: a failure just means the reads happen the slow way.
 void llama_prefetch_ranges(void * const * addrs, const size_t * sizes, size_t n);
+
+// SiegeLadder P8c: many small scattered reads from up to two files straight into memory, through unbuffered overlapped
+// I/O - n_thr threads, each with its own handles and qd reads in flight - instead of page faults on a mapping (one
+// PrefetchVirtualMemory keeps ~0.3M 4 KB reads a second in flight, the drive does 1.2-1.5M; runs.md 4.235-4.237). Piece i
+// copies len bytes at offset off of paths[file] to dst and must not cross a 4 KB boundary; each 4 KB sector is read once
+// for all its pieces. The pieces are reordered. False when a file does not open or a read fails - then some dst may be
+// unwritten, and the caller reads the slow way (Windows only; elsewhere always false)
+struct llama_scatter_piece {
+    uint64_t  off;
+    uint32_t  len;
+    uint32_t  file; // 0 or 1
+    uint8_t * dst;
+};
+bool llama_read_scattered(const std::string (&paths)[2], std::vector<llama_scatter_piece> & pieces, int n_thr, int qd);
