@@ -9,6 +9,8 @@
 #include <stdexcept>
 #include <cerrno>
 #include <algorithm>
+#include <atomic>
+#include <thread>
 
 #ifdef __has_include
     #if __has_include(<unistd.h>)
@@ -1257,3 +1259,146 @@ void llama_prefetch_ranges(void * const * addrs, const size_t * sizes, size_t n)
     GGML_UNUSED(addrs); GGML_UNUSED(sizes);
 #endif
