 void ggml_cuda_op_xielu(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 
 void ggml_cuda_op_unary_mul(ggml_backend_cuda_context & ctx, ggml_tensor * unary_node, ggml_tensor * mul_node);
@@ -112,3 +115,11 @@ __device__ __forceinline__ float ggml_cuda_op_swiglu_oai_single(float x, float g
     out_glu = out_glu * (1.0f + g);
     return out_glu;
 }
+
+// SiegeLadder: the arithmetic of op_clamp(g, -limit, limit), op_clamp(x, -INFINITY, limit), then unary_gated op_silu -
+// the same expressions, so the result is bitwise that of the three separate kernels
+__device__ __forceinline__ float ggml_cuda_op_swiglu_lim_single(float x, float g, float limit) {
+    const float a = fminf(fmaxf(x, -INFINITY), limit);
+    const float b = fminf(fmaxf(g, -limit), limit);
+    return ggml_cuda_op_silu_single(a) * b;
+}
