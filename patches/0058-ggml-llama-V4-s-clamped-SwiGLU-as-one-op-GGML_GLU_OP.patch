+// SiegeLadder: op_params [glu op, swapped = 0, limit (f32), skip_id], src[2] - the ids or NULL
+struct ggml_tensor * ggml_swiglu_lim_split(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        float                 limit) {
+    GGML_ASSERT(b != NULL);
+    struct ggml_tensor * result = ggml_glu_impl(ctx, a, b, GGML_GLU_OP_SWIGLU_LIM, false);
+    ggml_set_op_params_f32(result, 2, limit);
+    ggml_set_op_params_i32(result, 3, 0);
+
+    return result;
+}
+
+struct ggml_tensor * ggml_swiglu_lim_split_ids(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        float                 limit,
+        struct ggml_tensor  * ids,
+        int32_t               skip_id) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(ids->ne[0] == a->ne[1] && ids->ne[1] == a->ne[2] && a->ne[3] == 1);
+    struct ggml_tensor * result = ggml_swiglu_lim_split(ctx, a, b, limit);
+    ggml_set_op_params_i32(result, 3, skip_id);
+    result->src[2] = ids;
+
+    return result;
+}
