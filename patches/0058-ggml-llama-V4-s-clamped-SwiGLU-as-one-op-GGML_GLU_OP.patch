+// SiegeLadder: swiglu_lim - DeepSeek V4's clamped SwiGLU in one pass (ggml_swiglu_lim_split). Without ids: element-wise
+// like the gated kernels. With ids (ggml_swiglu_lim_split_ids, a prefill wave): one block per row (pair), rows whose id
+// is skip_id return at once - a wave computes only its own pairs instead of the whole ubatch
+
+static __global__ void swiglu_lim_kernel(const float * x, const float * g, float * dst, const int64_t k, const int64_t n,
+        const int64_t o0, const int64_t o1, const float limit) {
+    const int64_t i = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+
+    if (i >= k) {
+        return;
+    }
+
+    const int64_t j0 = (i / n) * o0 + (i % n);
+    const int64_t j1 = (i / n) * o1 + (i % n);
+
+    dst[i] = ggml_cuda_op_swiglu_lim_single(x[j0], g[j1], limit);
+}
+
+static __global__ void swiglu_lim_ids_kernel(const float * x, const float * g, float * dst, const int64_t n,
+        const int64_t o0, const int64_t o1, const int64_t od, const char * ids, const int64_t ne1, const size_t ids_nb0,
+        const size_t ids_nb1, const int32_t skip_id, const float limit) {
+    const int64_t row = blockIdx.x;
+    const int64_t i1  = row % ne1;
+    const int64_t i2  = row / ne1;
+
+    if (*(const int32_t *) (ids + i1*ids_nb0 + i2*ids_nb1) == skip_id) {
+        return;
+    }
+
+    const float * xr = x   + row*o0;
+    const float * gr = g   + row*o1;
+          float * dr = dst + row*od;
+    for (int64_t c = threadIdx.x; c < n; c += blockDim.x) {
+        dr[c] = ggml_cuda_op_swiglu_lim_single(xr[c], gr[c], limit);
+    }
+}
+
+void ggml_cuda_op_swiglu_lim(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+    cudaStream_t stream = ctx.stream();
+
+    GGML_ASSERT(src1 != nullptr);
+    GGML_ASSERT(ggml_is_contiguous_1(src0) && ggml_is_contiguous_1(src1));
+    GGML_ASSERT(src0->nb[0] == sizeof(float) && src1->nb[0] == sizeof(float));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(src0, src1) && ggml_are_same_shape(src0, dst));
+
+    const float   limit   = ggml_get_op_params_f32(dst, 2);
+    const int32_t skip_id = ggml_get_op_params_i32(dst, 3);
+
+    const int64_t nc = src0->ne[0];
+    const int64_t o0 = src0->nb[1] / sizeof(float);
+    const int64_t o1 = src1->nb[1] / sizeof(float);
+
+    if (ids == nullptr) {
+        const int64_t k          = ggml_nelements(dst);
+        const int64_t num_blocks = (k + CUDA_GLU_BLOCK_SIZE - 1) / CUDA_GLU_BLOCK_SIZE;
+        swiglu_lim_kernel<<<num_blocks, CUDA_GLU_BLOCK_SIZE, 0, stream>>>(
+                (const float *) src0->data, (const float *) src1->data, (float *) dst->data, k, nc, o0, o1, limit);
+        return;
+    }
+
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(ids->ne[0] == src0->ne[1] && ids->ne[1] == src0->ne[2] && src0->ne[3] == 1);
+    const int64_t nr = ggml_nrows(src0);
+    if (nr == 0) {
+        return;
+    }
+    swiglu_lim_ids_kernel<<<(unsigned int) nr, CUDA_GLU_BLOCK_SIZE, 0, stream>>>(
+            (const float *) src0->data, (const float *) src1->data, (float *) dst->data, nc, o0, o1, dst->nb[1] / sizeof(float),
+            (const char *) ids->data, src0->ne[1], ids->nb[0], ids->nb[1], skip_id, limit);
+}
+
