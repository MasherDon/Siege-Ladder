+// ggml_compute_forward_swiglu_lim (SiegeLadder): silu(min(a, limit)) * clamp(b, -limit, limit); with src[2] (ids) the
+// rows whose id is skip_id are left alone
+
+static void ggml_compute_forward_swiglu_lim_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+
+    GGML_ASSERT(src1 != nullptr);
+    GGML_ASSERT(ggml_is_contiguous_1(src0));
+    GGML_ASSERT(ggml_is_contiguous_1(src1));
+    GGML_ASSERT(ggml_is_contiguous_1(dst));
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t nc = src0->ne[0];
+    const int64_t nr = ggml_nrows(src0);
+
+    GGML_ASSERT(dst->ne[0] == nc);
+    GGML_ASSERT(ggml_nrows(dst) == nr);
+
+    const float   limit   = ggml_get_op_params_f32(dst, 2);
+    const int32_t skip_id = ggml_get_op_params_i32(dst, 3);
+
+    // rows per thread
+    const int64_t dr = (nr + nth - 1)/nth;
+
+    // row range for this thread
+    const int64_t ir0 = dr*ith;
+    const int64_t ir1 = MIN(ir0 + dr, nr);
+
+    for (int64_t ir = ir0; ir < ir1; ir++) {
+        if (ids) {
+            const int64_t i1 = ir % src0->ne[1];
+            const int64_t i2 = ir / src0->ne[1];
+            const int32_t id = *(const int32_t *) ((const char *) ids->data + i1*ids->nb[0] + i2*ids->nb[1]);
+            if (id == skip_id) {
+                continue;
+            }
+        }
+        const float * x = (const float *) ((const char *) src0->data + ir*src0->nb[1]);
+        const float * g = (const float *) ((const char *) src1->data + ir*src1->nb[1]);
+        float       * y = (float       *) ((char       *) dst->data  + ir*dst->nb[1]);
+
+        for (int64_t k = 0; k < nc; k++) {
+            const float a = std::min(x[k], limit);
+            const float b = std::clamp(g[k], -limit, limit);
+            y[k] = a / (1.0f + expf(-a)) * b;
+        }
+    }
+}
+
+static void ggml_compute_forward_swiglu_lim(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    switch (src0->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_swiglu_lim_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
