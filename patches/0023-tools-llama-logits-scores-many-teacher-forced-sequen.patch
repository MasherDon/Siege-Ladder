From d4456a931f29610ef731ba2ea9621ef0a681e0ce Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:15:07 +0000
Subject: [PATCH 23/91] tools : llama-logits scores many teacher-forced
 sequences with one model load (--score-file), tokenizes with the vocabulary
 only (--tokenize-file)

For ds4's official-continuation check (antirez/ds4, gguf-tools/quality-testing): per target position
the target log-probability, the argmax, the log-sum-exp, the top ids and the log-probabilities of
requested ids, in double precision as ds4's score_official. Also -t, --moe-stream-direct and the
server's `Ns` slot syntax for --moe-stream-cache.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/logits/logits.cpp | 475 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 468 insertions(+), 7 deletions(-)

diff --git a/tools/logits/logits.cpp b/tools/logits/logits.cpp
index f5f9d0b..5e20226 100644
--- a/tools/logits/logits.cpp
+++ b/tools/logits/logits.cpp
@@ -7,6 +7,26 @@
 // so a mismatch is visible without opening the file. Token ids can be given directly with
 // --tokens, which is what a cross-implementation comparison needs: the two tokenizers must
 // not be part of what is being compared.
+//
+// Two batch services for ds4's official-continuation check (antirez/ds4, gguf-tools/quality-testing):
+// the caller renders the prompts, checks the API token bytes and computes every metric; this tool
+// only tokenizes and runs forward passes, with one model load for all cases.
+//
+//   --tokenize-file F  vocabulary only, no weights. Each line of F: <tag>\t<t|p|v>\t<hex of the text>
+//                      (t = plain text, p = parse special tokens, v = list the whole vocabulary).
+//                      Writes <tag>\t<n>\t<ids>\t<hex of each token's bytes> per line, comma-separated;
+//                      v writes one line per vocabulary entry: <tag>\t1\t<id>\t<hex>.
+//   --score-file F     teacher forcing. Each line of F:
+//                      <case>\t<prompt ids>\t<target ids>[\t<ids per target position, ';' between positions>]
+//                      Per case the memory is cleared, the prompt is decoded (calls of up to 2048 tokens,
+//                      logits only at its last position), then the target goes in one token per call;
+//                      --score-batch decodes the prompt and the target together instead (-ub sets the graph
+//                      size either way; the default here is -ub 1, the generation path). Per target
+//                      position i, to -o:
+//                      <case>\t<i>\t<target>\t<target lp>\t<argmax>\t<argmax lp>\t<logsumexp>\t<top ids>\t<id:lp,...>
+//                      lp is the log-softmax of the raw logits in double precision and the argmax is the
+//                      first maximum (ds4's local_logits()); the top ids are ordered by logit, ties to the
+//                      lower id (ds4's local_top_ids()); a non-finite logit stops the run, as in ds4.
 
 #include "llama.h"
 #include "llama-ext.h"
@@ -14,9 +34,13 @@
 #include "ggml-backend.h"
 
 #include <algorithm>
+#include <cmath>
+#include <cstdint>
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <fstream>
+#include <limits>
 #include <string>
 #include <vector>
 
@@ -102,25 +126,392 @@ static bool dump_cb(struct ggml_tensor * t, bool ask, void * user_data) {
     return true;
 }
 
+static int hex_nibble(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+// text travels as hex: prompts and API pieces hold tabs, newlines and partial UTF-8
+static bool from_hex(const std::string & hex, std::string & out) {
+    out.clear();
+    if (hex.size() % 2) return false;
+    out.reserve(hex.size() / 2);
+    for (size_t i = 0; i < hex.size(); i += 2) {
+        const int hi = hex_nibble(hex[i]);
+        const int lo = hex_nibble(hex[i + 1]);
+        if (hi < 0 || lo < 0) return false;
+        out.push_back((char) (hi*16 + lo));
+    }
+    return true;
+}
+
+static std::string to_hex(const std::string & s) {
+    static const char dig[] = "0123456789abcdef";
+    std::string out;
+    out.reserve(2*s.size());
+    for (const char ch : s) {
+        const unsigned char c = (unsigned char) ch;
+        out.push_back(dig[c >> 4]);
+        out.push_back(dig[c & 15]);
+    }
+    return out;
+}
+
+static std::vector<std::string> split_on(const std::string & s, char sep) {
+    std::vector<std::string> out;
+    size_t pos = 0;
+    for (;;) {
+        const size_t k = s.find(sep, pos);
+        if (k == std::string::npos) {
+            out.push_back(s.substr(pos));
+            return out;
+        }
+        out.push_back(s.substr(pos, k - pos));
+        pos = k + 1;
+    }
+}
+
+static std::vector<llama_token> ids_from_csv(const std::string & s) {
+    std::vector<llama_token> out;
+    for (const std::string & f : split_on(s, ',')) {
+        if (!f.empty()) {
+            out.push_back((llama_token) atoi(f.c_str()));
+        }
+    }
+    return out;
+}
+
+static bool read_line(std::ifstream & in, std::string & line) {
+    if (!std::getline(in, line)) {
+        return false;
+    }
+    while (!line.empty() && (line.back() == '\r' || line.back() == '\n')) {
+        line.pop_back();
+    }
+    return true;
+}
+
+// the bytes a token stands for, as ds4's ds4_token_text(): byte-level pieces decoded, control
+// tokens as their text
+static std::string piece_bytes(const llama_vocab * vocab, llama_token id) {
+    std::string buf(64, '\0');
+    int n = llama_token_to_piece(vocab, id, &buf[0], (int32_t) buf.size(), 0, true);
+    if (n < 0) {
+        buf.assign((size_t) -n, '\0');
+        n = llama_token_to_piece(vocab, id, &buf[0], (int32_t) buf.size(), 0, true);
+    }
+    buf.resize(n > 0 ? (size_t) n : 0);
+    return buf;
+}
+
+static bool tokenize_text(const llama_vocab * vocab, const std::string & text, bool parse_special,
+        std::vector<llama_token> & out) {
+    out.clear();
+    if (text.empty()) {
+        return true;
+    }
+    int n = llama_tokenize(vocab, text.data(), (int32_t) text.size(), nullptr, 0, false, parse_special);
+    if (n == std::numeric_limits<int32_t>::min()) {
+        return false;
+    }
+    n = n < 0 ? -n : n;
+    if (n == 0) {
+        return true;
+    }
+    out.resize((size_t) n);
+    const int got = llama_tokenize(vocab, text.data(), (int32_t) text.size(), out.data(), n, false, parse_special);
+    if (got < 0) {
+        return false;
+    }
+    out.resize((size_t) got);
+    return true;
+}
+
+static int run_tokenize(const llama_vocab * vocab, const std::string & in_path, const std::string & out_path) {
+    std::ifstream in(in_path, std::ios::binary);
+    if (!in) {
+        fprintf(stderr, "cannot read %s\n", in_path.c_str());
+        return 1;
+    }
+    FILE * out = fopen(out_path.c_str(), "wb");
+    if (!out) {
+        fprintf(stderr, "cannot write %s\n", out_path.c_str());
+        return 1;
+    }
+
+    std::string line, text, row;
+    std::vector<llama_token> ids;
+    int n_lines = 0;
+    while (read_line(in, line)) {
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        const std::vector<std::string> cols = split_on(line, '\t');
+        const char mode = cols.size() == 3 && cols[1].size() == 1 ? cols[1][0] : '?';
+        if (mode == 'v') {
+            const int n_vocab = llama_vocab_n_tokens(vocab);
+            for (int id = 0; id < n_vocab; id++) {
+                row = cols[0] + "\t1\t" + std::to_string(id) + "\t" + to_hex(piece_bytes(vocab, id)) + "\n";
+                fwrite(row.data(), 1, row.size(), out);
+            }
+            n_lines++;
+            continue;
+        }
+        if ((mode != 't' && mode != 'p') || !from_hex(cols[2], text) ||
+                !tokenize_text(vocab, text, mode == 'p', ids)) {
+            fprintf(stderr, "tokenize: cannot handle the line for '%s'\n", cols[0].c_str());
+            fclose(out);
+            return 1;
+        }
+        row = cols[0] + "\t" + std::to_string(ids.size()) + "\t";
+        for (size_t i = 0; i < ids.size(); i++) {
+            row += (i ? "," : "") + std::to_string(ids[i]);
+        }
+        row += "\t";
+        for (size_t i = 0; i < ids.size(); i++) {
+            row += (i ? "," : "") + to_hex(piece_bytes(vocab, ids[i]));
+        }
+        row += "\n";
+        fwrite(row.data(), 1, row.size(), out);
+        n_lines++;
+    }
+    if (fclose(out) != 0) {
+        fprintf(stderr, "cannot write %s\n", out_path.c_str());
+        return 1;
+    }
+    printf("logits: %d tokenize lines -> %s\n", n_lines, out_path.c_str());
+    return 0;
+}
+
+struct score_job {
+    std::string                           id;
+    std::vector<llama_token>              prompt;
+    std::vector<llama_token>              target;
+    std::vector<std::vector<llama_token>> extra; // per target position: ids whose log-probability is wanted
+};
+
+static bool read_score_jobs(const std::string & path, std::vector<score_job> & jobs) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        fprintf(stderr, "cannot read %s\n", path.c_str());
+        return false;
+    }
+    std::string line;
+    while (read_line(in, line)) {
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        const std::vector<std::string> cols = split_on(line, '\t');
+        if (cols.size() < 3 || cols.size() > 4) {
+            fprintf(stderr, "score: bad line for '%s'\n", cols[0].c_str());
+            return false;
+        }
+        score_job j;
+        j.id     = cols[0];
+        j.prompt = ids_from_csv(cols[1]);
+        j.target = ids_from_csv(cols[2]);
+        j.extra.resize(j.target.size());
+        if (cols.size() == 4 && !cols[3].empty()) {
+            const std::vector<std::string> per_pos = split_on(cols[3], ';');
+            if (per_pos.size() != j.target.size()) {
+                fprintf(stderr, "score: %s has %zu id lists for %zu target tokens\n",
+                        j.id.c_str(), per_pos.size(), j.target.size());
+                return false;
+            }
+            for (size_t i = 0; i < per_pos.size(); i++) {
+                j.extra[i] = ids_from_csv(per_pos[i]);
+            }
+        }
+        if (j.prompt.empty() || j.target.empty()) {
+            fprintf(stderr, "score: %s has an empty prompt or target\n", j.id.c_str());
+            return false;
+        }
+        jobs.push_back(std::move(j));
+    }
+    return !jobs.empty();
+}
+
+static bool score_row(const float * lg, int n_vocab, const score_job & j, size_t i, int n_top, std::string & row) {
+    float mx   = 0.0f;
+    int   best = -1;
+    for (int t = 0; t < n_vocab; t++) {
+        if (!std::isfinite(lg[t])) {
+            return false;
+        }
+        if (best < 0 || lg[t] > mx) {
+            mx   = lg[t];
+            best = t;
+        }
+    }
+    double sum = 0.0;
+    for (int t = 0; t < n_vocab; t++) {
+        sum += std::exp((double) lg[t] - (double) mx);
+    }
+    const double lse = (double) mx + std::log(sum);
+
+    std::vector<int>   top ((size_t) n_top, -1);
+    std::vector<float> vals((size_t) n_top, -std::numeric_limits<float>::infinity());
+    for (int t = 0; t < n_vocab; t++) {
+        const float v = lg[t];
+        if (top[n_top - 1] >= 0 && v <= vals[n_top - 1]) {
+            continue;
+        }
+        int k = n_top - 1;
+        while (k > 0 && (top[k - 1] < 0 || v > vals[k - 1])) {
+            top[k]  = top[k - 1];
+            vals[k] = vals[k - 1];
+            k--;
+        }
+        top[k]  = t;
+        vals[k] = v;
+    }
+
+    char num[48];
+    auto put_lp = [&](llama_token t) {
+        const double lp = t >= 0 && t < n_vocab ? (double) lg[t] - lse : std::numeric_limits<double>::quiet_NaN();
+        snprintf(num, sizeof(num), "%.17g", lp);
+        row += num;
+    };
+    const llama_token target = j.target[i];
+    row = j.id + "\t" + std::to_string(i) + "\t" + std::to_string(target) + "\t";
+    put_lp(target);
+    row += "\t" + std::to_string(best) + "\t";
+    put_lp(best);
+    snprintf(num, sizeof(num), "\t%.17g\t", lse);
+    row += num;
+    for (int k = 0; k < n_top && top[k] >= 0; k++) {
+        row += (k ? "," : "") + std::to_string(top[k]);
+    }
+    row += "\t";
+    for (size_t k = 0; k < j.extra[i].size(); k++) {
+        row += (k ? "," : "") + std::to_string(j.extra[i][k]) + ":";
+        put_lp(j.extra[i][k]);
+    }
+    row += "\n";
+    return true;
+}
+
+static int run_score(llama_context * ctx, const llama_vocab * vocab, const std::vector<score_job> & jobs,
+        bool batch_mode, int n_top, const std::string & out_path) {
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+    FILE * out = fopen(out_path.c_str(), "wb");
+    if (!out) {
+        fprintf(stderr, "cannot write %s\n", out_path.c_str());
+        return 1;
+    }
+    const char * head = "# case\tpos\ttarget\ttarget_lp\targmax\targmax_lp\tlogsumexp\ttop_ids\tid_lp\n";
+    fwrite(head, 1, strlen(head), out);
+
+    const int n_batch = (int) llama_n_batch(ctx);
+    llama_batch batch = llama_batch_init(n_batch, 0, 1);
+    auto put = [&](int k, llama_token tok, llama_pos pos, bool want) {
+        batch.token[k]     = tok;
+        batch.pos[k]       = pos;
+        batch.n_seq_id[k]  = 1;
+        batch.seq_id[k][0] = 0;
+        batch.logits[k]    = want ? 1 : 0;
+    };
+
+    int rc = 0;
+    int64_t n_eval = 0;
+    std::string row;
+    // the logits of batch index k are the prediction for target token i
+    auto emit = [&](const score_job & j, int k, int i) -> int {
+        const float * lg = llama_get_logits_ith(ctx, k);
+        if (!lg || !score_row(lg, n_vocab, j, (size_t) i, n_top, row)) {
+            fprintf(stderr, "score: %s: no logits or a non-finite logit at target token %d\n", j.id.c_str(), i);
+            return 1;
+        }
+        fwrite(row.data(), 1, row.size(), out);
+        return 0;
+    };
+    const int64_t t_start = ggml_time_us();
+    for (size_t c = 0; c < jobs.size() && rc == 0; c++) {
+        const score_job & j = jobs[c];
+        const int n_prompt = (int) j.prompt.size();
+        const int n_target = (int) j.target.size();
+        llama_memory_clear(llama_get_memory(ctx), true);
+        const int64_t t0 = ggml_time_us();
+
+        // decoded first: the prompt, and with --score-batch every target token but the last. Position p
+        // predicts target token p - (n_prompt - 1). Calls of at most n_batch tokens; the outputs of a
+        // call are read before the next call overwrites them.
+        const int n_first = n_prompt + (batch_mode ? n_target - 1 : 0);
+        for (int off = 0; off < n_first && rc == 0; off += n_batch) {
+            const int n = std::min(n_batch, n_first - off);
+            batch.n_tokens = n;
+            for (int k = 0; k < n; k++) {
+                const int p = off + k;
+                put(k, p < n_prompt ? j.prompt[p] : j.target[p - n_prompt], p, p >= n_prompt - 1);
+            }
+            if (llama_decode(ctx, batch) != 0) {
+                fprintf(stderr, "score: %s: decode failed at position %d\n", j.id.c_str(), off);
+                rc = 1;
+                break;
+            }
+            n_eval += n;
+            for (int p = std::max(off, n_prompt - 1); p < off + n && rc == 0; p++) {
+                rc = emit(j, p - off, p - (n_prompt - 1));
+            }
+        }
+        const int64_t t1 = ggml_time_us();
+
+        // the rest of the target, one token per call: the generation path (the last token is never fed)
+        for (int i = n_first - n_prompt + 1; i < n_target && rc == 0; i++) {
+            batch.n_tokens = 1;
+            put(0, j.target[i - 1], n_prompt + i - 1, true);
+            if (llama_decode(ctx, batch) != 0) {
+                fprintf(stderr, "score: %s: decode failed at target token %d\n", j.id.c_str(), i - 1);
+                rc = 1;
+                break;
+            }
+            n_eval++;
+            rc = emit(j, 0, i);
+        }
+        fflush(out);
+        const int64_t t2 = ggml_time_us();
+        fprintf(stderr, "score: %s %zu/%zu | prompt %d, target %d | prompt %.2f s, case %.2f s | %.2f tok/s so far\n",
+                j.id.c_str(), c + 1, jobs.size(), n_prompt, n_target, (t1 - t0)/1e6, (t2 - t0)/1e6,
+                n_eval/((t2 - t_start)/1e6));
+    }
+    llama_batch_free(batch);
+    if (fclose(out) != 0) {
+        fprintf(stderr, "cannot write %s\n", out_path.c_str());
+        rc = 1;
+    }
+    return rc;
+}
+
 static void uso(const char * exe) {
     printf("usage: %s -m model.gguf [-p prompt | --tokens 1,2,3] -o out.bin\n", exe);
