             // Its weight multipliers come out of a second op right after it, on the same host split.
-            ggml_tensor * args[3] = { ids_cont, ggml_is_contiguous(weights) ? weights : ggml_cont(ctx0, weights), nullptr };
-            int n_args = 2;
+            ggml_tensor * args[3] = { nullptr, nullptr, nullptr };
+            int n_args = 0;
+            add_ids_weights(args, n_args);
             if (pred_next != nullptr) {
                 args[n_args++] = ggml_cont(ctx0, pred_next);
             }
@@ -2605,6 +2625,13 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
                     moe_a = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, n_tokens), 0.0f);
                 } else {
                     ggml_tensor * e_a = build_expert_gemms(cur, ra_ids, nullptr);
+                    // SiegeLadder G21: the pairs off the card skip these GEMMs (the first half gives them the skip id)
+                    // and the down GEMM zeroes their rows - only when the pipeline ends in that GEMM itself, as for the
+                    // prefill waves: a bias, scale or LoRA term after it would land on the zeroed rows
+                    msl->ra_skip_ok = msl->mgr->ra_skip && msl->mgr->skip_capable && e_a->op == GGML_OP_MUL_MAT_ID;
+                    if (msl->ra_skip_ok) {
+                        e_a->op_params[2] = 1;
+                    }
                     e_a = ggml_mul(ctx0, e_a, ggml_mul(ctx0, weights, ra_mask));
                     cb(e_a, "ffn_moe_weighted_approx", il);
                     moe_a = ggml_view_2d(ctx0, e_a, n_embd, n_tokens, e_a->nb[2], 0);
