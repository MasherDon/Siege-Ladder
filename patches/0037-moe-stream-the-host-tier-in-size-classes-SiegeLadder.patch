-            ggml_tensor * iargs[2] = { ids_cont, nullptr };
-            int n_iargs = 1;
+            ggml_tensor * iargs[2] = { nullptr, nullptr };
+            int n_iargs = 0;
             if (msl->mgr->drop_w > 0.0f) {
-                iargs[n_iargs++] = ggml_is_contiguous(weights) ? weights : ggml_cont(ctx0, weights);
+                add_ids_weights(iargs, n_iargs);
+            } else {
