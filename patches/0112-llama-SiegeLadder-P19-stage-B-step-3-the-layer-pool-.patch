+void llama_moe_stream::p19_lm_pool_shrink(const char * reason, size_t sc, int layer, size_t ub) {
+    if (!p19_lm_pool_active || !p11_active) return;
+    std::unique_lock<std::mutex> lk(mtx);
+    moe_p11_quiesce_locked(*this, lk);
+    const uint32_t P = p19_lm_base_slots;
+    LLAMA_LOG_WARN("%s: P19 LM pool shrink reason=%s sc=%zu layer=%d ub=%zu hits=%" PRId64 " miss=%" PRId64 "\n",
+            __func__, reason, sc, layer, ub, stats.n_hit - p19_lm_hits0, stats.n_miss - p19_lm_miss0);
+        std::vector<const ggml_tensor *> widest;
+        for (const auto & sl : layers) {
+            if (!sl) {
+                continue;
+            }
+            widest.resize(sl->weights.size(), nullptr);
+            for (size_t w = 0; w < sl->weights.size(); w++) {
+                const ggml_tensor * a = sl->weights[w].cache;
+                if (widest[w] == nullptr || a->nb[2] > widest[w]->nb[2]) {
+                    widest[w] = a;
+                }
+            }
+        }
+        for (auto & sl : layers) {
+            if (sl) for (auto & wt : sl->weights) {
+                wt.cache->data = nullptr;
+                wt.cache->buffer = nullptr;
+            }
+        }
+        p11_buf.reset();
+        p11_ctx.reset();
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead()*(widest.size() + 1),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        p11_ctx.reset(ggml_init(params));
+        std::vector<ggml_tensor *> pool;
+        for (const ggml_tensor * c : widest) {
+            ggml_tensor * t = ggml_new_tensor_3d(p11_ctx.get(), c->type, c->ne[0], c->ne[1], P);
+            pool.push_back(t);
+        }
+        ggml_backend_buffer_type_t buft = ctxs[0].first;
+        p11_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(p11_ctx.get(), buft));
+        if (!p11_buf) GGML_ABORT("P19 pool restore failed");
+        ggml_backend_buffer_set_usage(p11_buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_backend_dev_t dev = compute_backend != nullptr ? ggml_backend_get_device(compute_backend) : nullptr;
+        for (auto & sl : layers) {
+            if (!sl) {
+                continue;
+            }
+            for (size_t w = 0; w < sl->weights.size(); w++) {
+                ggml_tensor * c = sl->weights[w].cache;
+                c->ne[2]  = P;
+                c->nb[3]  = c->nb[2] * P;
+                c->data   = pool[w]->data;
+                c->buffer = pool[w]->buffer;
+            }
+            p11_reset_layer_locked(*sl, P); // the replacement buffer is empty
+            if (slot_fence && dev != nullptr) {
+                if (sl->slot_up_event.size() < P) {
+                    const size_t n0 = sl->slot_up_event.size();
+                    sl->slot_up_event.resize(P, nullptr);
+                    sl->slot_up_seq.resize(P, 0);
+                    for (size_t s = n0; s < P; s++) {
+                        sl->slot_up_event[s] = ggml_backend_event_new(dev);
+                    }
+                }
+            }
+        }
+    p19_lm_pool_active = false;
+    p19_lm_pool_shrunk = true;
+    p19_lm_last_il = -1;
+}
 void llama_moe_stream::p19_lm_pool_end() {
-    if (!p19_lm_pool_active) {
+    if (!p19_lm_pool_active && !p19_lm_pool_shrunk) {
         return;
     }
     const int64_t hits  = stats.n_hit - p19_lm_hits0;
     const int64_t miss  = stats.n_miss - p19_lm_miss0;
     const int64_t bytes = io[0].bytes.load() - p19_lm_io_bytes0;
     if (p11_active) {
+        if (p19_lm_pool_shrunk) {
+            LLAMA_LOG_INFO("%s: P19 LM pool (call end) shrunk: slots=%u plan=%u hits=%" PRId64 " miss=%" PRId64 " demand_io_bytes=%" PRId64 " kept_tables=%" PRId64 "\n", __func__, p19_lm_base_slots, plan_slots, hits, miss, bytes, p19_lm_keep_tables);
+            p19_lm_pool_shrunk = false;
+            return;
+        }
+
         // p1_leave -> p11_leave restores p11_saved_slots and the per-layer cache; only clear planning state
         LLAMA_LOG_INFO("%s: P19 LM pool (call end): slots=%u plan=%u hits=%" PRId64 " miss=%" PRId64 " demand_io_bytes=%" PRId64
                 " kept_tables=%" PRId64 " (delta vs call start; compare POOL off on the same prompt)\n", __func__,
diff --git a/src/llama-moe-stream.h b/src/llama-moe-stream.h
index 31efb81..ca5ebae 100644
--- a/src/llama-moe-stream.h
+++ b/src/llama-moe-stream.h
@@ -661,6 +661,8 @@ struct llama_moe_stream {
     int64_t  p19_lm_keep_tables   = 0;  // wave-0 entries that kept their table (layer-major pool hits possible)
     // target_slots: 0 = auto from DXGI; seg_reserve_bytes = margin for segment graphs (POOL_MARGIN + peak sched buf)
     bool p19_lm_pool_begin(uint32_t target_slots, size_t seg_reserve_bytes, size_t margin_mib);
+    bool p19_lm_pool_shrunk = false;
+    void p19_lm_pool_shrink(const char * reason, size_t sc, int layer, size_t ub);
     void p19_lm_pool_end(); // shrink to p19_lm_base_slots; no-op when p11_leave will restore the cache
     // SiegeLadder P4: the last layer whose experts the latest graph build runs (-1: every layer) - an encoder-only ubatch
     // stops before the first decoder layer's FFN, and nothing reads ahead into a layer it will not run. Set at graph build
