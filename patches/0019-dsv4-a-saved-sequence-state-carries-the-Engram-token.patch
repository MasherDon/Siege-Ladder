From 4b03bfa273b80088b7fc9b5542840aeddaa997f6 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Thu, 15 Oct 2026 18:58:50 +0000
Subject: [PATCH 19/92] dsv4 : a saved sequence state carries the Engram token
 history

A slot restored into another process found the history before the restore point
as ENGRAM_NONE and padded the next tokens' n-grams, so its answer drifted from
the live one. One id per position is written after the compressed K rows; the
state version goes to 2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-kv-cache-dsv4.cpp | 39 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/src/llama-kv-cache-dsv4.cpp b/src/llama-kv-cache-dsv4.cpp
index 4e79657..6f14039 100644
--- a/src/llama-kv-cache-dsv4.cpp
+++ b/src/llama-kv-cache-dsv4.cpp
@@ -43,7 +43,8 @@ static std::pair<uint32_t, uint32_t> dsv4_comp_ratios(const llama_model & model)
 }
 
 static constexpr uint32_t DSV4_STATE_MAGIC         = 0x34565344; // DSV4
-static constexpr uint32_t DSV4_STATE_VERSION       = 1;
+// 2: a full state also carries the Engram token history (see state_write)
+static constexpr uint32_t DSV4_STATE_VERSION       = 2;
 static constexpr uint32_t DSV4_STATE_MODE_FULL     = 0;
 static constexpr uint32_t DSV4_STATE_MODE_PARTIAL  = 1;
 static constexpr uint32_t DSV4_K_CACHE_STATE_VER   = 2;
@@ -1681,6 +1682,18 @@ void llama_kv_cache_dsv4::state_write(llama_io_write_i & io, llama_seq_id seq_id
         dsv4_state_write_k_cache(io, kv_csa.get(), seq_id, flags, n_rows_csa);
         dsv4_state_write_k_cache(io, kv_hca.get(), seq_id, flags, n_rows_hca);
         dsv4_state_write_k_cache(io, kv_lid.get(), seq_id, flags, n_rows_lid);
+
+        // The Engram n-grams of the next tokens look back at the tokens before them. A state restored into
+        // another process (a slot file) would find them ENGRAM_NONE and pad those n-grams, so the history
+        // travels with the cache: one id per position.
+        const uint32_t n_hist = engram_hist.empty() ? 0 : seq_id >= 0
+            ? (uint32_t) std::min<int64_t>((int64_t) pos_max + 1, engram_hist_size)
+            : (uint32_t) engram_hist.size();
+        io.write(&n_hist, sizeof(n_hist));
+        if (n_hist > 0) {
+            const size_t base = seq_id >= 0 ? (size_t) seq_id*engram_hist_size : 0;
+            io.write(engram_hist.data() + base, (size_t) n_hist*sizeof(int32_t));
+        }
     }
 
     csa_state->state_write(io, seq_id, flags, rs_idx);
@@ -1723,6 +1736,30 @@ void llama_kv_cache_dsv4::state_read(llama_io_read_i & io, llama_seq_id seq_id,
         dsv4_state_read_k_cache(io, kv_csa.get(), seq_id, flags);
         dsv4_state_read_k_cache(io, kv_hca.get(), seq_id, flags);
         dsv4_state_read_k_cache(io, kv_lid.get(), seq_id, flags);
+
+        uint32_t n_hist = 0;
+        io.read(&n_hist, sizeof(n_hist));
+        if (seq_id >= 0) {
+            if (n_hist > engram_hist_size) {
+                throw std::runtime_error("DSV4 state Engram history longer than the cache");
+            }
+            if (!engram_hist.empty()) {
+                int32_t * dst = engram_hist.data() + (size_t) seq_id*engram_hist_size;
+                std::fill(dst, dst + engram_hist_size, ENGRAM_NONE);
+                if (n_hist > 0) {
+                    io.read(dst, (size_t) n_hist*sizeof(int32_t));
+                }
+            } else if (n_hist > 0) {
+                throw std::runtime_error("DSV4 state carries an Engram history this cache does not keep");
+            }
+        } else {
+            if (n_hist != engram_hist.size()) {
+                throw std::runtime_error("DSV4 state Engram history size mismatch");
+            }
+            if (n_hist > 0) {
+                io.read(engram_hist.data(), (size_t) n_hist*sizeof(int32_t));
+            }
+        }
     }
 
     csa_state->state_read(io, seq_id, flags);
