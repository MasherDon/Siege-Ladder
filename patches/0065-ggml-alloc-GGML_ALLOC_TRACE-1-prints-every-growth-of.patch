From 86f43796d6f022060b0b31992a03a93514c41951 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:15:13 +0000
Subject: [PATCH 65/92] ggml-alloc : GGML_ALLOC_TRACE=1 prints every growth of
 a chunk's high-water mark (SiegeLadder P17, step 0)

The tensor that set it, its op and size, and the free space left in holes behind the tail at that moment; the
allocator's address tells the buffer types apart. Off unless the variable is set. SiegeLadder runs.md 4.114: the 32K
prefill buffer at -ub 6144 / 12288 is set by layers 0-1 (hc streams, wq_b's output and the q concat, the GLU, the down
output and its weighted copy) with 1.2-2.5 GB of holes, none of which takes the next large tensor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-alloc.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 3bda9ab..bfe8971 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -300,6 +300,25 @@ static struct buffer_address ggml_dyn_tallocr_alloc(struct ggml_dyn_tallocr * al
     }
 #endif
 
+    // SiegeLadder P17, step 0 (GGML_ALLOC_TRACE=1): every growth of a chunk's high-water mark - the tensor that set it, and
+    // the free space left behind the tail at that moment (holes); %p tells the allocators (one per buffer type) apart
+    {
+        static int trace = -1;
+        if (trace < 0) {
+            const char * e = getenv("GGML_ALLOC_TRACE");
+            trace = e != NULL && atoi(e) != 0;
+        }
+        if (trace && addr.offset + size > chunk->max_size) {
+            size_t holes = 0;
+            for (int i = 0; i < chunk->n_free_blocks - 1; i++) {
+                holes += chunk->free_blocks[i].size;
+            }
+            GGML_LOG_WARN("alloc trace %p: chunk %d max %.1f -> %.1f MiB by %s (%s, %.2f MiB), holes %.1f MiB in %d blocks\n",
+                (const void *) alloc, addr.chunk, chunk->max_size / 1048576.0, (addr.offset + size) / 1048576.0,
+                tensor->name, ggml_op_desc(tensor), size / 1048576.0, holes / 1048576.0, chunk->n_free_blocks - 1);
+        }
+    }
+
     chunk->max_size = MAX(chunk->max_size, addr.offset + size);
 
     return addr;
