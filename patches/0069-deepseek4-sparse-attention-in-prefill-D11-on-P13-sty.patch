+bool llm_graph_dsv4_sparse_prefill() {
+    return dsv4_p13_get_env().sparse;
+}
+
+// SiegeLadder D10: the cell of every position p_lo .. p_hi of the sequence in the window ring (cell_of[p - p_lo]); false
+// when one is missing or held twice - then some query's window would need a mask, and the ubatch does not go sparse
+static bool dsv4_sparse_window_cells(
+        const llama_kv_cells & cells,
+        llama_seq_id seq_id,
+        llama_pos p_lo,
+        llama_pos p_hi,
+        std::vector<int32_t> & cell_of) {
+    if (p_lo < 0 || p_hi < p_lo) {
+        return false;
+    }
+
+    cell_of.assign((size_t) (p_hi - p_lo + 1), -1);
+    for (uint32_t j = 0; j < cells.size(); ++j) {
+        if (cells.is_empty(j) || !cells.seq_has(j, seq_id)) {
+            continue;
+        }
+        const llama_pos p = cells.pos_get(j);
+        if (p < p_lo || p > p_hi) {
+            continue;
+        }
+        int32_t & c = cell_of[p - p_lo];
+        if (c >= 0) {
+            return false;
+        }
+        c = (int32_t) j;
+    }
+    for (const int32_t c : cell_of) {
+        if (c < 0) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+// SiegeLadder D10: may this ubatch attend sparsely? Its positions are consecutive; every query sees at least n_sel
+// compressed positions in both groups, so every one of the indexer's n_sel picks is a position it sees (the indexer's
+// scores of the others are -inf, as are the candidate filter's, which keeps every visible block while it has room)
+// and the gathered picks need no mask; and the window of every query, its n_swa positions up to its own, is in the ring
+static bool dsv4_sparse_eligible(
+        const llama_hparams & hparams,
+        const llama_kv_cache_dsv4_raw_context * raw,
+        const llama_kv_cache_dsv4_context::comp_plan & plan_csa,
+        const llama_kv_cache_dsv4_context::comp_plan & plan_hca,
+        bool hca_picks,
+        const llama_ubatch & ubatch,
+        int64_t n_sel) {
+    const int64_t nt = ubatch.n_tokens;
+    if (nt <= 0 || (int64_t) plan_csa.n_visible.size() != nt || (hca_picks && (int64_t) plan_hca.n_visible.size() != nt)) {
+        return false;
+    }
+    for (int64_t i = 0; i < nt; ++i) {
+        if (ubatch.pos[i] != ubatch.pos[0] + (llama_pos) i || plan_csa.n_visible[i] < n_sel ||
+                (hca_picks && plan_hca.n_visible[i] < n_sel)) {
+            return false;
+        }
+    }
+
+    const llama_seq_id seq_id = ubatch.seq_id[0][0];
+    std::vector<int32_t> cell_of;
+    return dsv4_sparse_window_cells(raw->get_cells(seq_id), seq_id,
+            ubatch.pos[0] - (llama_pos) hparams.n_swa + 1, ubatch.pos[nt - 1], cell_of);
+}
+
 // the chunk plan of a ubatch: its shapes only (the rows and the mask are set_input's). The same at graph build, in
 // can_reuse and - from the same cells - at set_input
 static llm_graph_input_dsv4::p13_plan dsv4_p13_build_plan(
@@ -1314,12 +1424,15 @@ static llm_graph_input_dsv4::p13_plan dsv4_p13_build_plan(
     llm_graph_input_dsv4::p13_plan plan;
 
     const dsv4_p13_env & env = dsv4_p13_get_env();
-    if (env.nq <= 0 && !env.identity) {
+    if (env.nq <= 0 && !env.identity && !env.sparse) {
         return plan;
     }
 
-    const int64_t nt = ubatch.n_tokens;
-    if (nt < env.n_min || !cparams.flash_attn || !cparams.causal_attn || hparams.use_alibi || ubatch.is_pos_2d() ||
+    // P13 as configured, or D10 (which brings its own chunks): with neither possible for this ubatch, nothing changes
+    const int64_t nt     = ubatch.n_tokens;
+    const bool    p13_on = (env.nq > 0 || env.identity) && nt >= env.n_min;
+    const bool    sp_on  = env.sparse && nt >= env.sp_min;
+    if ((!p13_on && !sp_on) || !cparams.flash_attn || !cparams.causal_attn || hparams.use_alibi || ubatch.is_pos_2d() ||
             hparams.swa_type != LLAMA_SWA_TYPE_STANDARD || hparams.n_swa == 0) {
         return plan;
     }
@@ -1350,7 +1463,26 @@ static llm_graph_input_dsv4::p13_plan dsv4_p13_build_plan(
         }
     }
 
-    const int64_t n_chunk = env.identity ? 1 : (nt + env.nq - 1)/env.nq;
+    // SiegeLadder D10: does this ubatch attend sparsely? The reserve graph has no positions behind it: it takes the sparse
+    // plan, and llama_context::sched_reserve reserves a second time with cparams.dsv4_reserve_dense - the plan of a
+    // ubatch that cannot - so the buffers hold the larger of the two graphs. The picks must cover CSA, and HCA where that
+    // group goes through the indexer too (V4.1; V4's HCA flavour attends to all its positions and keeps P13's chunks)
+    const int64_t n_sel     = (int64_t) hparams.indexer_top_k;
+    const bool    hca_picks = !mctx->get_comp_overlap();
+    bool sparse = false;
+    if (sp_on && n_sel > 0 && plan_csa.n_kv >= n_sel && (!hca_picks || plan_hca.n_kv >= n_sel)) {
+        sparse = reserve ? !cparams.dsv4_reserve_dense :
+                dsv4_sparse_eligible(hparams, raw, plan_csa, plan_hca, hca_picks, ubatch, n_sel);
+    }
+    if (!sparse && !p13_on) {
+        return plan;
+    }
+
+    // a sparse ubatch runs its own chunks of Qc queries; P13's identity mode is never sparse (dsv4_p13_get_env)
+    const int64_t nq       = sparse ? env.sp_qc : env.nq;
+    const bool    identity = !sparse && env.identity;
+
+    const int64_t n_chunk = identity ? 1 : (nt + nq - 1)/nq;
 
