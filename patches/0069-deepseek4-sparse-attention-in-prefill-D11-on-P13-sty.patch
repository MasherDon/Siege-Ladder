+// A ubatch attends sparsely when P13's conditions hold, its positions are consecutive, every query sees at least top-k
+// compressed positions in both groups (positions >= 1023 on V4.1: then every pick is a position it sees) and its whole
+// window is in the ring; any other ubatch - the first ~1024 positions of a sequence - takes P13 as configured above, or
+// the attention of before when P13 is off
 struct dsv4_p13_env {
     int64_t nq       = 0;
     int64_t n_min    = 0;
     bool    identity = false;
+
+    bool    sparse   = false; // SiegeLadder D10
