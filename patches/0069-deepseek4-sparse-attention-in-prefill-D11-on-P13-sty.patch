+// GGML_OP_GET_ROWS with an F16 result (SiegeLadder D10, ggml_get_rows_f16): the sparse prefill gathers K rows of an
+// f16 / q8_0 / q4_0 cache as F16 for flash attention - one rounding to f16 on either backend, so the rows match exactly
+struct test_get_rows_f16 : public test_case {
+    const ggml_type type;
+    const int n; // cols
+    const int m; // rows
+    const int r; // rows to get
+
+    std::string vars() override {
+        return VARS_TO_STR4(type, n, m, r);
+    }
+
