-const uint8_t * llama_moe_stream_l2::find(uint16_t file_idx, size_t offs, size_t len, size_t * out_slot) {
+// P9: hold / unhold a slot for the running prompt (see scan in the header); under the tier's lock
+void llama_moe_stream_l2::hold_locked(size_t s, int32_t il) {
+    entry & e = entries[s];
+    if (!scan || e.gen == scan_gen || il < 0 || (uint32_t) il >= scan_layers) {
+        return;
+    }
+    pool & p = pool_of(s);
+    if (s >= p.ring_first || p.held_by_layer[il] >= p.quota) {
+        return; // the ring is never held, and a layer holds its share at most
+    }
+    e.gen = scan_gen;
+    e.il  = (int16_t) il;
+    p.held_by_layer[il]++;
+    p.n_held++;
+    size_t held = 0;
+    for (const pool & q : pools) {
+        held += q.n_held;
+    }
+    n_scan_held_max = std::max(n_scan_held_max, held);
+}
+
+void llama_moe_stream_l2::unhold_locked(size_t s) {
+    entry & e = entries[s];
+    if (scan && e.gen == scan_gen && e.il >= 0) {
+        pool & p = pool_of(s);
+        p.held_by_layer[e.il]--;
+        p.n_held--;
+    }
+    e.gen = 0;
+    e.il  = -1;
+}
+
+void llama_moe_stream_l2::begin_scan() {
+    L2_LOCK(*this);
+    if (!scan_on || scan || scan_layers == 0) {
+        return;
+    }
+    scan = true;
+    if (++scan_gen == 0) {
+        scan_gen = 1; // 0 means held by none
+    }
+    for (pool & p : pools) {
+        p.n_held = 0;
+        std::fill(p.held_by_layer.begin(), p.held_by_layer.end(), 0u);
+    }
+    n_scan_prompts++;
+}
+
+void llama_moe_stream_l2::end_scan() {
+    L2_LOCK(*this);
+    scan = false;
+}
+
+const uint8_t * llama_moe_stream_l2::find(uint16_t file_idx, size_t offs, size_t len, size_t * out_slot, int32_t il) {
