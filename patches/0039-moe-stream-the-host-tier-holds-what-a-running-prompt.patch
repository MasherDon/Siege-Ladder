+                    continue;
+                }
+                index.erase(e.key);
+                n_evict++;
+                p->n_evict++;
+            }
+            e.key  = key;
+            e.len  = (uint32_t) len;
+            e.head = 0;
+            e.pins = 0;
+            e.ref  = 0;
+            e.gen  = 0;
+            e.il   = -1;
+            e.st   = LOADING;
+            index[key] = s;
+            hand       = lo + (s - lo + 1) % cnt;
+            return s;
         }
-        e.key  = key;
-        e.len  = (uint32_t) len;
-        e.head = 0;
-        e.pins = 0;
-        e.ref  = 0;
-        e.st   = LOADING;
