+void ggml_compute_forward_prefix_mask(const ggml_compute_params * params, ggml_tensor * dst) {
+    const int32_t * visible = (const int32_t *) dst->src[0]->data;
+    const int64_t rows = ggml_nelements(dst->src[0]);
+    const int64_t width = dst->ne[0];
+    GGML_ASSERT(ggml_is_contiguous(dst) && ggml_is_contiguous(dst->src[0]));
+    for (int64_t row = params->ith; row < rows; row += params->nth) {
+        for (int64_t j = 0; j < width; ++j) {
+            if (dst->type == GGML_TYPE_F16) {
+                ((uint16_t *) dst->data)[row*width + j] = j < visible[row] ? 0x0000 : 0xfc00;
+            } else {
+                GGML_ASSERT(dst->type == GGML_TYPE_F32);
+                ((float *) dst->data)[row*width + j] = j < visible[row] ? 0.0f : -INFINITY;
+            }
+        }
+    }
+}
+
