+    char * end = nullptr;
+    unsigned long long mib = env ? strtoull(env, &end, 10) : 1024;
+    if (env && (*env == '-' || end == env || *end || mib > SIZE_MAX / 1048576)) mib = 0;
+    p->limit = (size_t) mib * 1048576;
+    l034_cache = p;
