--- a/ggml/src/ggml-cuda/fill.cu
+++ b/ggml/src/ggml-cuda/fill.cu
@@ -3,6 +3,26 @@
 
 #define CUDA_FILL_BLOCK_SIZE 256
 
+template <typename T>
+static __global__ void prefix_mask_kernel(T * dst, const int32_t * visible, int64_t width, int64_t count) {
+    const int64_t i = (int64_t) blockDim.x * blockIdx.x + threadIdx.x;
+    if (i < count) {
+        dst[i] = i % width < visible[i / width] ? (T) 0.0f : (T) (-INFINITY);
+    }
+}
+
+void ggml_cuda_op_prefix_mask(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_is_contiguous(dst) && ggml_is_contiguous(dst->src[0]));
+    const int64_t n = ggml_nelements(dst);
+    const int64_t blocks = (n + CUDA_FILL_BLOCK_SIZE - 1) / CUDA_FILL_BLOCK_SIZE;
+    if (dst->type == GGML_TYPE_F16) {
+        prefix_mask_kernel<<<blocks, CUDA_FILL_BLOCK_SIZE, 0, ctx.stream()>>>((half *) dst->data, (const int32_t *) dst->src[0]->data, dst->ne[0], n);
+    } else {
+        GGML_ASSERT(dst->type == GGML_TYPE_F32);
+        prefix_mask_kernel<<<blocks, CUDA_FILL_BLOCK_SIZE, 0, ctx.stream()>>>((float *) dst->data, (const int32_t *) dst->src[0]->data, dst->ne[0], n);
+    }
+}
+
 template <typename T>
 static __global__ void fill_kernel(T * dst, const int64_t k, const T value) {
     const int64_t i = (int64_t)blockDim.x * blockIdx.x + threadIdx.x;
