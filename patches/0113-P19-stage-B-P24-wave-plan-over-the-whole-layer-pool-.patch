+    std::map<std::string, sample> samples;
+};
+static thread_local dsv4_mask_cache * l034_cache = nullptr;
+void l034_begin() {
+    const char * m = getenv("LLAMA_DSV4_LAYER_MAJOR_INPUT_CACHE");
+    int mode = m ? atoi(m) : 0;
+    const char * cost = getenv("LLAMA_DSV4_LAYER_MAJOR_COST");
+    if (mode != 1 && mode != 2 && !(cost && atoi(cost) == 2)) return;
