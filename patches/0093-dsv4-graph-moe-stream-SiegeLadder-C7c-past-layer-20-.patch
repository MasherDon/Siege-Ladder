+                            first + 1, (long long) yoco_cut_min);
+                }
             }
         }
 
@@ -2593,6 +2607,7 @@ int llama_context::decode(const llama_batch & batch_inp) {
     // SiegeLadder C7: this call's ubatches with the bound in their graph, and the decoder rows C7b left without experts
     int64_t yoco_ub_call  = 0;
     int64_t yoco_row_call = 0;
+    int64_t yoco_cut_call = 0; // C7c: the rows cut out after the first decoder layer
 
     do {
         const auto & ubatch = mctx->get_ubatch();
@@ -2625,18 +2640,33 @@ int llama_context::decode(const llama_batch & batch_inp) {
         // SiegeLadder C7: this ubatch's bound (its graph's masks; none with NOBOUND) and C7b's first row whose decoder
         // experts load - set for its build and run and reset at once, like P4's flag
         int64_t yoco_row0 = 0;
-        cparams.dsv4_yoco_lo = -1;
+        cparams.dsv4_yoco_lo  = -1;
+        cparams.dsv4_yoco_cut = 0;
         if (yoco_k > 0 && !cparams.dsv4_enc_only) {
             const int32_t lo = yoco_ubatch_lo(ubatch, yoco_row0);
             cparams.dsv4_yoco_lo = yoco_nobound ? -1 : lo;
             yoco_row0 = yoco_rows ? yoco_row0 : 0;
             yoco_ub_call  += lo >= 0 ? 1 : 0;
             yoco_row_call += yoco_row0;
+            // C7c: the graph drops C7b's rows after the first decoder layer - with the bound in it (the rows left must not
+            // see the decoder windows of the dropped ones, which are never written), and no output among them
+            if (yoco_cut && cparams.dsv4_yoco_lo >= 0 && yoco_row0 > 0 &&
+                    (int64_t) ubatch.n_tokens - yoco_row0 >= yoco_cut_min) {
+                bool out_before = false;
+                for (int64_t i = 0; i < yoco_row0 && !out_before; ++i) {
+                    out_before = ubatch.output[i] != 0;
+                }
+                if (!out_before) {
+                    cparams.dsv4_yoco_cut = (int32_t) yoco_row0;
+                    yoco_cut_call += yoco_row0;
+                }
+            }
         }
         auto * yoco_ms = yoco_k > 0 ? model.moe_stream() : nullptr;
         if (yoco_ms) {
             yoco_ms->c7_row0   = yoco_row0;
             yoco_ms->c7_layer0 = model.hparams.dsv4_dec_first();
+            yoco_ms->c7_layer1 = cparams.dsv4_yoco_cut > 0 ? model.hparams.dsv4_dec_first() + 1 : -1;
         }
 
         ggml_status status;
@@ -2644,8 +2674,10 @@ int llama_context::decode(const llama_batch & batch_inp) {
         const auto * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx.get(), status);
         cparams.dsv4_enc_only = false;
         cparams.dsv4_yoco_lo  = -1;
+        cparams.dsv4_yoco_cut = 0;
         if (yoco_ms) {
-            yoco_ms->c7_row0 = 0;
+            yoco_ms->c7_row0   = 0;
+            yoco_ms->c7_layer1 = -1;
         }
 
         if (!res) {
@@ -2828,8 +2860,10 @@ int llama_context::decode(const llama_batch & batch_inp) {
         for (int s = 0; s < LLAMA_MAX_SEQ; ++s) {
             if (yoco_lo[s] >= 0) {
                 LLAMA_LOG_INFO("%s: SiegeLadder C7: sequence %d - the decoder from position %d of a call ending at %u tokens; "
-                        "%lld ubatch(es) with the bound in the graph, %lld decoder rows without routed experts (C7b)\n",
-                        __func__, s, (int) yoco_lo[s], n_tokens_all, (long long) yoco_ub_call, (long long) yoco_row_call);
+                        "%lld ubatch(es) with the bound in the graph, %lld decoder rows without routed experts (C7b)%s\n",
+                        __func__, s, (int) yoco_lo[s], n_tokens_all, (long long) yoco_ub_call, (long long) yoco_row_call,
+                        yoco_cut ? (", " + std::to_string(yoco_cut_call) + " of them cut out after layer " +
+                                std::to_string(model.hparams.dsv4_dec_first()) + " (C7c)").c_str() : "");
             }
         }
     }
@@ -3270,13 +3304,17 @@ ggml_cgraph * llama_context::graph_reserve(
     auto * res = gf_res_reserve.get();
 
     // SiegeLadder C7: a prompt ubatch may carry the decoder layers' masks with the bound - reserve with them in the graph
-    const int32_t save_yoco_lo = cparams.dsv4_yoco_lo;
+    // (and C7c's cut never: the reserve ubatch's output is its row 0, and every row through the decoder bounds the buffers)
+    const int32_t save_yoco_lo  = cparams.dsv4_yoco_lo;
+    const int32_t save_yoco_cut = cparams.dsv4_yoco_cut;
     if (yoco_k > 0 && n_tokens > 1 && !yoco_nobound) {
         cparams.dsv4_yoco_lo = 0;
     }
+    cparams.dsv4_yoco_cut = 0;
 
     const auto gparams = graph_params(res, ubatch, mctx, ctx_type_to_graph_type(cparams.ctx_type));
-    cparams.dsv4_yoco_lo = save_yoco_lo;
+    cparams.dsv4_yoco_lo  = save_yoco_lo;
+    cparams.dsv4_yoco_cut = save_yoco_cut;
 
     res->reset();
 
diff --git a/src/llama-context.h b/src/llama-context.h
index b25ac4c..d28ca3c 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -392,6 +392,12 @@ private:
     bool     yoco_mask    = false;         // LLAMA_DSV4_YOCO_MODE=mask: the bound alone - no skips at all (the check's reference)
     bool     yoco_nobound = false;         // LLAMA_DSV4_YOCO_NOBOUND=1: the skips without the bound (a negative control)
     bool     yoco_rows    = true;          // LLAMA_DSV4_YOCO_ROWS=0: no C7b
+    // C7c (on by default with C7b since 26.10, LLAMA_DSV4_YOCO_CUT=0 - off; SiegeLadder runs.md 4.234-4.235): the ubatch
+    // holding C7b's rows goes on from layer dsv4_dec_first() + 1 with its rows from
+    // the first one past the bound only (cparams.dsv4_yoco_cut) - the decoder of the rows before it is never computed.
+    // Layer dsv4_dec_first() keeps every row: its cache writes are the compressed attention of every position
+    bool     yoco_cut     = false;
+    int64_t  yoco_cut_min = 64;            // rows the cut must leave (fewer: C7b alone; a one-row tail would look like decode)
     std::vector<llama_pos> yoco_lo;        // [LLAMA_MAX_SEQ] for the current call, -1 = not active
