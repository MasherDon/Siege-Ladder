+                // C7c (on by default with C7b since 26.10, LLAMA_DSV4_YOCO_CUT=0 - off): C7b's rows are cut out of the
+                // graph after the first decoder layer - only with the bound and C7b, so never in MODE=mask or NOBOUND.
+                // Lossless against C7b: against C7 computed exactly at -ub 1 it is no farther than C7b (|d log p| 0.011
+                // against 0.018 on dense / P13 / sparse prompts; SiegeLadder runs.md 4.235); agent turns read -14%
+                const char * cu = std::getenv("LLAMA_DSV4_YOCO_CUT");
+                yoco_cut = yoco_rows && !yoco_nobound && (cu == nullptr || atoi(cu) != 0);
+                if (const char * cm = std::getenv("LLAMA_DSV4_YOCO_CUT_MIN")) {
+                    yoco_cut_min = std::max<int64_t>(2, (int64_t) atoll(cm));
+                }
                 yoco_lo.assign(LLAMA_MAX_SEQ, -1);
                 LLAMA_LOG_WARN("%s: SiegeLadder C7 (lossy%s): the decoder (layers %d-%u) of a call keeps its last %d "
                         "positions - %s%s%s\n", __func__, y_asked ? "" : "; on by default, LLAMA_DSV4_YOCO=0 - off", first,
@@ -618,6 +627,11 @@ llama_context::llama_context(
                         "a lower bound on their raw windows, whole ubatches below it run the encoder only",
                         yoco_rows ? "; the decoder rows below it load and compute no routed experts (C7b)" : "",
                         !yoco_mask && p4_reach <= 0 ? " (P4 is off: no ubatch skips the decoder)" : "");
+                if (yoco_cut) {
