diff --git a/src/llama-cparams.h b/src/llama-cparams.h
index 6d5770a..df38696 100644
--- a/src/llama-cparams.h
+++ b/src/llama-cparams.h
@@ -58,6 +58,9 @@ struct llama_cparams {
     // SiegeLadder C7 (LLAMA_DSV4_YOCO=K): this ubatch's decoder bound - its rows at or past it see the raw window of
     // layers 20-39 only from it on (llama_context::yoco_lo); -1 - no bound in this ubatch's graph
     int32_t dsv4_yoco_lo    = -1;
+    // SiegeLadder C7c (LLAMA_DSV4_YOCO_CUT): the first row of this ubatch that layers dsv4_dec_first() + 1 on and the head
+    // run - the rows before it are C7b's rows without consequence, whose decoder nothing reads; 0 - every row
+    int32_t dsv4_yoco_cut   = 0;
     // SiegeLadder D12: the compute buffers hold the non-sparse plan only for positions below this (0 - for all)
     uint32_t dsv4_dense_cap = 0;
 
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index e68cdbc..ae12a8c 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -604,11 +604,16 @@ void llm_graph_input_out_ids::set_input(const llama_ubatch * ubatch) {
 
     GGML_ASSERT(ubatch->output);
 
+    // SiegeLadder C7c: a DSV4 graph cut at row dsv4_yoco_cut gathers its outputs from the rows past the cut only (0 for
+    // every other graph; llama_context cuts no ubatch with an output before the cut)
+    const int32_t row0 = cparams.dsv4_yoco_cut;
+
     int n_outputs = 0;
 
     for (int i = 0; i < n_tokens; ++i) {
         if (ubatch->output[i]) {
-            data[n_outputs++] = i;
+            GGML_ASSERT(i >= row0);
+            data[n_outputs++] = i - row0;
         }
     }
 }
@@ -1675,18 +1680,33 @@ static llm_graph_input_dsv4::p13_plan dsv4_p13_build_plan(
     const int64_t nq       = sparse ? env.sp_qc : env.nq;
     const bool    identity = !sparse && env.identity;
 
-    const int64_t n_chunk = identity ? 1 : (nt + nq - 1)/nq;
+    // SiegeLadder C7c (cparams.dsv4_yoco_cut): the decoder past its first layer runs the rows from the cut only - the plan
+    // gets a chunk boundary there, so that the decoder's chunks are its last ones (llm_graph_input_dsv4::c7c_chunk0). Only
+    // the chunk holding the cut is split: every other chunk - and so the encoder's attention of its rows - stays as without
+    // the cut. The identity mode (one chunk of every row) leaves such a ubatch the attention of before; the reserve graph
+    // has no cut
+    const int64_t cut = reserve ? 0 : (int64_t) cparams.dsv4_yoco_cut;
+    if (cut > 0 && identity) {
+        return plan;
+    }
+    GGML_ASSERT(cut >= 0 && cut < nt);
+
+    const int64_t n_chunk0 = identity ? 1 : (nt + nq - 1)/nq;
 
     // a ubatch runs chunks as equal as possible, at most nq each; the reserve graph runs chunks of exactly nq, the
     // widest any ubatch can get (balanced chunks of a smaller ubatch reach nq: 2 x 1665 at nq 1665 against 4 x 1536
     // at -ub 6144), so its window rows, FlashAttention outputs and masks bound every chunk the buffers will see
-    std::vector<int64_t> t0(n_chunk + 1);
+    std::vector<int64_t> t0(n_chunk0 + 1);
+    for (int64_t c = 0; c <= n_chunk0; ++c) {
+        t0[c] = reserve && !identity ? std::min<int64_t>(c*nq, nt) : c*nt/n_chunk0;
+    }
+    if (cut > 0 && std::find(t0.begin(), t0.end(), cut) == t0.end()) {
+        t0.insert(std::upper_bound(t0.begin(), t0.end(), cut), cut);
+    }
+    const int64_t n_chunk = (int64_t) t0.size() - 1;
     int64_t n_max = 0;
-    for (int64_t c = 0; c <= n_chunk; ++c) {
-        t0[c] = reserve && !identity ? std::min<int64_t>(c*nq, nt) : c*nt/n_chunk;
-        if (c > 0) {
-            n_max = std::max<int64_t>(n_max, t0[c] - t0[c - 1]);
-        }
+    for (int64_t c = 1; c <= n_chunk; ++c) {
+        n_max = std::max<int64_t>(n_max, t0[c] - t0[c - 1]);
     }
 
     // a chunk of n consecutive positions needs n + n_swa - 1 window rows; FlashAttention with the 512-wide head takes
@@ -5187,6 +5207,45 @@ llm_graph_input_dsv4 * llm_graph_context::build_inp_dsv4() const {
         }
     }
 
+    // SiegeLadder C7c: the views the layers past the cut read (see c7c_cut), once per graph. llama_context cuts only a
+    // ubatch with the bound in its graph - one sequence, one stream, one write row per token
+    if (cparams.dsv4_yoco_cut > 0 && !mctx_cur->is_reserve()) {
+        const int64_t cut = cparams.dsv4_yoco_cut;
+        const int64_t ntc = (int64_t) ubatch.n_tokens - cut;
+        GGML_ASSERT(inp->c7_built && ntc > 0 && "C7c: a cut without C7's bound in the graph");
+        const auto rows = [&](ggml_tensor * t) -> ggml_tensor * {
+            if (t == nullptr) {
+                return nullptr;
+            }
+            GGML_ASSERT(t->ne[1] == (int64_t) ubatch.n_tokens && t->ne[2] == 1 && t->ne[3] == 1);
+            return ggml_view_4d(ctx0, t, t->ne[0], ntc, 1, 1, t->nb[1], t->nb[2], t->nb[3], (size_t) cut*t->nb[1]);
+        };
+        inp->c7c_cut = cut;
+        inp->c7c_hca = inp->inp_hca;
+        inp->c7c_hca.kq_mask  = rows(inp->inp_hca.kq_mask);
+        inp->c7c_hca.lid_mask = inp->inp_hca.lid_mask == inp->inp_hca.kq_mask ? inp->c7c_hca.kq_mask :
+                rows(inp->inp_hca.lid_mask);
+        inp->c7c_hca.cand_pin = rows(inp->inp_hca.cand_pin);
+
+        ggml_tensor * ki = inp->inp_raw->self_k_idxs;
+        GGML_ASSERT(ki != nullptr && ki->ne[0] == (int64_t) ubatch.n_tokens);
+        inp->c7c_k_idxs = ggml_view_1d(ctx0, ki, ntc, (size_t) cut*ki->nb[0]);
+
+        const auto & p13 = inp->p13;
+        if (p13.n_chunk == 0) {
+            inp->c7c_raw_mask = rows(inp->c7_raw_mask);
+        } else {
+            int64_t c0 = 0;
+            while (c0 < p13.n_chunk && p13.t0[c0] < cut) {
+                c0++;
+            }
+            GGML_ASSERT(c0 < p13.n_chunk && p13.t0[c0] == cut && "C7c: the chunk plan has no boundary at the cut");
+            inp->c7c_chunk0   = c0;
+            inp->c7c_p13_rows = ggml_view_1d(ctx0, inp->p13_rows, p13.raw_len*(p13.n_chunk - c0),
+                    (size_t) (c0*p13.raw_len)*ggml_element_size(inp->p13_rows));
+        }
+    }
+
     return (llm_graph_input_dsv4 *) res->add_input(std::move(inp));
 }
 
