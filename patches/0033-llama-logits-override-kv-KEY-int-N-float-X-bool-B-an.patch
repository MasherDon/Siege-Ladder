     int   moe_slots = 0, n_threads = 0, n_top = 64;
     bool  moe_stream = false, add_bos = true, moe_direct = false, score_batch = false;
+    std::vector<llama_model_kv_override> kv_over;
+    ggml_type type_k = GGML_TYPE_F16, type_v = GGML_TYPE_F16;
 
     for (int i = 1; i < argc; i++) {
         const std::string a = argv[i];
@@ -559,6 +600,13 @@ int main(int argc, char ** argv) {
         }
         else if (a == "-ub")                   n_ubatch      = atoi(proximo("-ub").c_str());
         else if (a == "--no-bos")              add_bos       = false;
+        else if (a == "--override-kv") {
+            llama_model_kv_override o;
