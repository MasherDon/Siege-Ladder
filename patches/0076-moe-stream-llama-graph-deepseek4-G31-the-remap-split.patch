From e7229d701bf575522493875814cc6c9110a810b6 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Wed, 21 Oct 2026 05:15:57 +0000
Subject: [PATCH 76/92] moe-stream, llama-graph, deepseek4 : G31 - the remap
 split in two without runahead's pass (LLAMA_MOE_STREAM_G31=1; bit for bit,
 runs.md 4.145), G34 keys (LLAMA_MOE_STREAM_SPEC_WORKERS / SPEC_IDLE /
 DROP_SPEC), C14 probe E1 (LLAMA_MOE_STREAM_C14_Q / _N / _SEL / _SKIP / _DROP
 / _DEPTH) and C14 proper (LLAMA_MOE_STREAM_C14: deferred pairs not waited
 for, their GEMMs after the next layer's attention through c14_wait and reply
 record [2]), D14 counters (the E: copy's read latency,
 LLAMA_MOE_STREAM_SLOW_READ_MS) - all off by default (SiegeLadder seventeenth
 session)

---
 src/llama-graph.cpp      | 129 +++++++++-
 src/llama-moe-stream.cpp | 526 ++++++++++++++++++++++++++++++++++++---
 src/llama-moe-stream.h   | 110 +++++++-
 src/models/deepseek4.cpp |  51 ++++
 4 files changed, 773 insertions(+), 43 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 5a87858..c4142f3 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -3099,26 +3099,32 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     // ... and the card's copies of them: the same tensors, or the reply's (G22)
     ggml_tensor * ra_ids_dev  = nullptr;
     ggml_tensor * ra_mask_dev = nullptr;
+    // SiegeLadder G31 (LLAMA_MOE_STREAM_G31=1): this call's remap is split in two without runahead's pass - ra_ids is the
+    // first half's output then, and the expert GEMMs below run in two launches (decided with the remap's path below)
+    bool g31_split = false;
     // SiegeLadder G22 (on by default; LLAMA_MOE_STREAM_MBOX_REPLY=0 - off): the remap's answers - the slot ids and the
     // multipliers, CPU tensors - go back to the card through the layer's reply record k: an op on the remap's host
     // split writes them with the number of the post they answer, and ggml_mbox_read at the head of the next card split
     // gives the card its own copies, so that split has no input from the host (see llama_moe_stream_reply_0). Built
     // only where msl->rp_on is set
     auto rp_read = [&](int k, ggml_tensor * a, ggml_tensor * b, ggml_tensor ** a_dev, ggml_tensor ** b_dev) {
+        // SiegeLadder G31: its second half answers through record [1] the only post of the call, [0]
+        const int k_post = g31_split ? 0 : k;
         ggml_tensor * args[2] = { a, b };
         ggml_tensor * w = ggml_custom_4d(ctx0, GGML_TYPE_I32, 1, 1, 1, 1, args, b != nullptr ? 2 : 1,
-                k == 0 ? llama_moe_stream_reply_0 : llama_moe_stream_reply_1, 1, msl);
+                k == 0 ? llama_moe_stream_reply_0 : k_post == 0 ? llama_moe_stream_reply_1_g31 : llama_moe_stream_reply_1,
+                1, msl);
         ggml_build_forward_expand(gf, w);
         const int32_t off_b = (int32_t) (64 + GGML_PAD(ggml_nbytes(a), 64));
         GGML_ASSERT(off_b + (b != nullptr ? ggml_nbytes(b) : 0) <= LLAMA_MOE_STREAM_RP_REC_BYTES &&
                 "G22: the reply outgrows its record");
         void * err = (void *) msl->mgr->rp_err;
         *a_dev = ggml_mbox_read(ctx0, a->type, a->ne[0], a->ne[1], a->ne[2], a->ne[3], msl->rp_rec[k], 64,
-                msl->mb_rec[k], err, a->type == GGML_TYPE_I32 ? INT32_MAX : 0, msl->il*4 + k*2 + 1);
+                msl->mb_rec[k_post], err, a->type == GGML_TYPE_I32 ? INT32_MAX : 0, msl->il*4 + k*2 + 1);
         ggml_build_forward_expand(gf, *a_dev);
         if (b != nullptr) {
             *b_dev = ggml_mbox_read(ctx0, b->type, b->ne[0], b->ne[1], b->ne[2], b->ne[3], msl->rp_rec[k], off_b,
-                    msl->mb_rec[k], err, b->type == GGML_TYPE_I32 ? INT32_MAX : 0, msl->il*4 + k*2 + 2);
+                    msl->mb_rec[k_post], err, b->type == GGML_TYPE_I32 ? INT32_MAX : 0, msl->il*4 + k*2 + 2);
             ggml_build_forward_expand(gf, *b_dev);
         }
     };
@@ -3198,6 +3204,19 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
                 ggml_build_forward_expand(gf, msl->graph_shexp);
             }
         };
+        // SiegeLadder G31 (LLAMA_MOE_STREAM_G31=1, off by default; see g31 in llama_moe_stream): where the single remap
+        // would run at decode with the mailbox and its reply (G16 / G22), without C13 or a prediction to carry, and the
+        // expert pipeline ends in the down GEMM (skipped pairs, as the waves and G30) - the ctor leaves g31 off next to
+        // runahead, C13, the G4 probe and VRAM_ONLY=2
+        {
+            bool lora_down = false;
+            for (const auto & lora : *loras) {
+                lora_down = lora_down || lora.first->get_weight(down_exps) != nullptr;
+            }
+            g31_split = msl->mgr->g31 > 0 && !moe_runahead && msl->rp_on && n_tokens == 1 && !weight_before_ffn &&
+                    pred_next == nullptr && !c13 && n_expert_used == (int64_t) hparams.n_expert_used &&
+                    msl->mgr->skip_capable && down_exps_b == nullptr && down_exps_s == nullptr && !lora_down;
+        }
         if (moe_runahead && msl->mgr->runahead_k > 0 && n_tokens == 1 && !weight_before_ffn && pred_next == nullptr &&
                 n_expert_used == (int64_t) hparams.n_expert_used) {
             // the remap in two halves: the first queues the call's loads and returns at once with the slots of its
@@ -3227,6 +3246,23 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
                     llama_moe_stream_drop_mask, 1, msl);
             cb(ra_mask, "ffn_moe_runahead_mask", il);
             ggml_build_forward_expand(gf, ra_mask);
+        } else if (g31_split) {
+            // SiegeLadder G31, the first half: the remap up to its wait - the call's loads queued, the drop rule decided
+            // (its multipliers kept for the second half) - and at once the slots of the pairs resident now, the skip id
+            // for the others. No multipliers here: nothing is weighted before the second half
+            ggml_tensor * iargs[2] = { nullptr, nullptr };
+            int n_iargs = 0;
+            if (drop_path) {
+                add_ids_weights(iargs, n_iargs); // packed: rp_on needs the mailbox, and the mailbox the packing
+            } else {
+                iargs[n_iargs++] = ids_cont;
+            }
+            mb_post(0, iargs[0]);
+            mb_shexp();
+            ra_ids = ggml_custom_4d(ctx0, GGML_TYPE_I32, ids_cont->ne[0], ids_cont->ne[1], 1, 1, nullptr, 0,
+                    llama_moe_stream_remap_issue_g31_mb, 1, msl);
+            cb(ra_ids, "ffn_moe_topk_g31", il);
+            ggml_build_forward_expand(gf, ra_ids);
         } else if (drop_path && !weight_before_ffn) {
             // drop rule (LLAMA_MOE_STREAM_DROP_W, lossy, on by default since 18.10: 0.14 with DROP_ALL; DROP_W=0 is the
             // exact path): the remap also needs this call's
@@ -3536,7 +3572,34 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         }
     } else {
         ggml_tensor * e_rows = nullptr; // G30: the approximate pass's down output, which the exact GEMMs complete
-        if (ra_ids != nullptr) {
+        if (g31_split) {
+            // SiegeLadder G31: the expert GEMMs in two launches, without runahead's pass. The first runs on the first half's
+            // slots - the pairs resident when it ended; the others carry the skip id and their rows stay unwritten
+            // (op_params[2] stays 0: nothing reads them before the second launch writes them) - on a card split of its own,
+            // which the host launches before the second half sleeps on the call's loads: these GEMMs run while the copies
+            // fly. The second half gives those pairs the skip id and every other pair its slot - a pair the drop rule took
+            // out a kept slot of its token, as the single remap does - and its GEMMs write their rows into this output
+            // (ggml_mul_mat_id_into, G30). A row is the one the single launch computes: the same slot, input and kernel
+            // (MMVQ computes each pair in blocks of its own, the quantized input per row); the multipliers - the single
+            // remap's, moved to exact_mask - and the weighted sum below are unchanged
+            e_rows = build_expert_gemms(cur, ra_ids_dev, nullptr);
+            GGML_ASSERT(e_rows->op == GGML_OP_MUL_MAT_ID && "G31: the expert pipeline must end in the down GEMM");
+            cb(e_rows, "ffn_moe_down_first", il);
+            ggml_build_forward_expand(gf, e_rows); // before the second half in node order, so on a card split before it
+            ids_gemm = ggml_custom_4d(ctx0, GGML_TYPE_I32, ra_ids->ne[0], ra_ids->ne[1], 1, 1, &ra_ids, 1,
+                    llama_moe_stream_remap_wait_g31, 1, msl);
+            cb(ids_gemm, "ffn_moe_topk_stream", il);
+            ggml_build_forward_expand(gf, ids_gemm);
+            if (drop_path) {
+                // the drop rule's multipliers, on the second half's host split
+                drop_mask = ggml_custom_4d(ctx0, GGML_TYPE_F32, 1, ra_ids->ne[0], ra_ids->ne[1], 1, &ids_gemm, 1,
+                        llama_moe_stream_exact_mask, 1, msl);
+                cb(drop_mask, "ffn_moe_drop_mask", il);
+                ggml_build_forward_expand(gf, drop_mask);
+            }
+            rp_read(1, ids_gemm, drop_mask, &ids_gemm, &drop_mask);
+            cb(ids_gemm, "ffn_moe_topk_stream_reply", il);
+        } else if (ra_ids != nullptr) {
             // G2 runahead: the approximate routed output - the experts resident when the call came, the others at
             // weight 0 - summed like the exact one below; the model graph turns it into a prediction of the next
             // layer's experts, and the second half stages that, waits for this call's loads and gives the exact
@@ -3626,6 +3689,44 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         // G30: with the pass's rows reused, the exact GEMMs run the other pairs only (the reused ones carry the skip id;
         // gate / up leave their rows unwritten, the down GEMM in place into e_rows leaves the pass's)
         experts = build_expert_gemms(cur, ids_gemm, e_rows);
+
+        // SiegeLadder C14 (c14_q in llama_moe_stream): the model graph marked this layer c14_ok; a graph that cannot serve
+        // the pairs the remap would defer takes the mark back, and the remap (which reads it) defers none
+        if (msl != nullptr && msl->c14_ok) {
+            const bool c14_here = n_tokens == 1 && drop_mask != nullptr && !weight_before_ffn && ra_ids == nullptr &&
+                    !g31_split && (!msl->mgr->c14_real || (msl->rp_on && msl->mgr->skip_capable));
+            msl->c14_ok = c14_here;
+        }
+        if (msl != nullptr && msl->c14_ok && msl->mgr->c14_real) {
+            // C14 proper, the tail: built here, expanded by the model graph right after the next layer's attention. The host
+            // op c14_wait waits there for the deferred pairs' copies and writes their slots (the skip id for the other
+            // pairs) and multipliers into reply record [2]; the GEMMs read them, the rows of the pairs not deferred are
+            // zeroed (op_params[2] = 1, as runahead's pass), and the weighted sum delta joins that attention's residual.
+            // Nothing here is expanded: the record is read only after the op wrote it, so the expansion orders them
+            const int64_t k_used = ids_gemm->ne[0];
+            ggml_tensor * c14w = ggml_custom_4d(ctx0, GGML_TYPE_I32, k_used, n_tokens, 1, 1, nullptr, 0,
+                    llama_moe_stream_c14_wait, 1, msl);
+            cb(c14w, "ffn_moe_c14_wait", il);
+            const int32_t off_b = (int32_t) (64 + GGML_PAD(k_used*n_tokens*(int64_t) sizeof(int32_t), 64));
+            GGML_ASSERT(off_b + k_used*n_tokens*(int64_t) sizeof(float) <= LLAMA_MOE_STREAM_RP_REC_BYTES);
+            void * err = (void *) msl->mgr->rp_err;
+            ggml_tensor * ids_def = ggml_mbox_read(ctx0, GGML_TYPE_I32, k_used, n_tokens, 1, 1, msl->rp_rec[2], 64,
+                    msl->mb_rec[0], err, INT32_MAX, 1000000 + msl->il*4 + 1);
+            ggml_tensor * m_def = ggml_mbox_read(ctx0, GGML_TYPE_F32, 1, k_used, n_tokens, 1, msl->rp_rec[2], off_b,
+                    msl->mb_rec[0], err, 0, 1000000 + msl->il*4 + 2);
+            ggml_tensor * e_def = build_expert_gemms(cur, ids_def, nullptr);
+            GGML_ASSERT(e_def->op == GGML_OP_MUL_MAT_ID && "C14: the expert pipeline must end in the down GEMM");
+            e_def->op_params[2] = 1;
+            e_def = ggml_mul(ctx0, e_def, ggml_mul(ctx0, weights, m_def));
+            cb(e_def, "ffn_moe_weighted_c14", il);
+            ggml_tensor * delta = ggml_view_2d(ctx0, e_def, n_embd, n_tokens, e_def->nb[2], 0);
+            for (uint32_t i = 1; i < hparams.n_expert_used; ++i) {
+                delta = ggml_add(ctx0, delta, ggml_view_2d(ctx0, e_def, n_embd, n_tokens, e_def->nb[2], i*e_def->nb[1]));
+            }
+            msl->graph_c14_wait  = c14w;
+            msl->graph_c14_delta = ggml_cont(ctx0, delta);
+            cb(msl->graph_c14_delta, "ffn_moe_c14_delta", il);
+        }
     }
 
     if (!weight_before_ffn) {
@@ -3637,13 +3738,31 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         static const bool weight_inplace = getenv("LLAMA_MOE_WEIGHT_INPLACE") == nullptr ||
                 atoi(getenv("LLAMA_MOE_WEIGHT_INPLACE")) != 0;
         ggml_tensor * w = drop_mask != nullptr ? ggml_mul(ctx0, weights, drop_mask) : weights;
+        // SiegeLadder C14, probe E1 (c14_q in llama_moe_stream): the remap negated the multipliers of the pairs it deferred -
+        // the kept sum takes relu(m), the deferred one relu(-m), from the same rows; the model graph adds the deferred sum
+        // after the next layer's attention (graph_c14_delta)
+        ggml_tensor * e_c14 = nullptr;
+        if (msl != nullptr && msl->c14_ok && !msl->mgr->c14_real && drop_mask != nullptr && n_tokens == 1) {
+            w     = ggml_mul(ctx0, weights, ggml_relu(ctx0, drop_mask));
+            e_c14 = ggml_mul(ctx0, experts, ggml_mul(ctx0, weights, ggml_relu(ctx0, ggml_neg(ctx0, drop_mask))));
+            cb(e_c14, "ffn_moe_weighted_c14", il);
+        }
         // in place only into an op's output (the waves' in-place GEMMs make it a view of the first wave's), never a leaf
         const ggml_tensor * own = experts;
         while (own->view_src != nullptr) {
             own = own->view_src;
         }
-        experts = weight_inplace && own->op != GGML_OP_NONE ? ggml_mul_inplace(ctx0, experts, w) : ggml_mul(ctx0, experts, w);
+        experts = weight_inplace && e_c14 == nullptr && own->op != GGML_OP_NONE ? ggml_mul_inplace(ctx0, experts, w) :
+                ggml_mul(ctx0, experts, w);
         cb(experts, "ffn_moe_weighted", il);
+        if (e_c14 != nullptr) {
+            ggml_tensor * delta = ggml_view_2d(ctx0, e_c14, n_embd, n_tokens, e_c14->nb[2], 0);
+            for (uint32_t i = 1; i < hparams.n_expert_used; ++i) {
+                delta = ggml_add(ctx0, delta, ggml_view_2d(ctx0, e_c14, n_embd, n_tokens, e_c14->nb[2], i*e_c14->nb[1]));
+            }
+            msl->graph_c14_delta = ggml_cont(ctx0, delta);
+            cb(msl->graph_c14_delta, "ffn_moe_c14_delta", il);
+        }
     }
 
     ggml_build_forward_expand(gf, experts);
diff --git a/src/llama-moe-stream.cpp b/src/llama-moe-stream.cpp
index 9e4caed..3eb6f90 100644
--- a/src/llama-moe-stream.cpp
+++ b/src/llama-moe-stream.cpp
@@ -775,6 +775,20 @@ llama_moe_stream::llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n
     if (const char * p = std::getenv("LLAMA_MOE_STREAM_SPEC_QUEUE")) {
         spec_queue_max = (size_t) std::max(1, atoi(p));
     }
+    // SiegeLadder G34; see spec_workers in the header
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_SPEC_WORKERS")) {
+        spec_workers = std::max(1, atoi(p));
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_SPEC_IDLE")) {
+        spec_idle = atoi(p) != 0;
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_DROP_SPEC")) {
+        drop_spec = atoi(p) != 0;
+    }
+    // SiegeLadder D14; see slow_read_us in the header
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_SLOW_READ_MS")) {
+        slow_read_us = (int64_t) (std::max(0.0, std::strtod(p, nullptr))*1000.0);
+    }
     // A4b. Staging into VRAM slots ahead of the call; for now it takes the future from the oracle only.
     if (const char * p = std::getenv("LLAMA_MOE_STREAM_VRAM_AHEAD")) {
         vram_ahead = atoi(p);
@@ -960,6 +974,85 @@ llama_moe_stream::llama_moe_stream(uint32_t n_layer, uint32_t n_slots, int32_t n
                 drop_all ? "; DROP_ALL: a call in which a heavy expert still waits for the drive gives its drops and "
                            "substitutions back" : "");
     }
+    // SiegeLadder G31; see g31 in the header. Lossless: the same rows, multipliers and sum as the single remap
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_G31")) {
+        g31 = atoi(p) != 0 ? 1 : 0;
+    }
+    if (g31 > 0 && (runahead_k > 0 || subst > 0 || g4_probe > 0 || drop_vram_only == 2)) {
+        LLAMA_LOG_WARN("%s: moe stream: LLAMA_MOE_STREAM_G31 is ignored next to %s\n", __func__,
+                runahead_k > 0 ? "runahead (its remap is split already)" : subst > 0 ? "C13 (LLAMA_MOE_STREAM_SUBST)" :
+                g4_probe > 0 ? "the G4 probe" : "the drop rule's VRAM_ONLY=2");
+        g31 = 0;
+    }
+    if (g31 > 0) {
+        LLAMA_LOG_WARN("%s: moe stream: G31 on: at decode each streamed layer's remap is split in two without runahead's "
+                "pass - the expert GEMMs of the pairs resident at the first half run while the call's other copies fly, "
+                "the second half's GEMMs write the other rows into the same output\n", __func__);
+    }
+    // SiegeLadder C14, probe E1; see c14_q in the header. C14 proper (c14_real) takes the same keys but C14 for C14_Q
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14_Q")) {
+        c14_q = std::max(0.0f, (float) std::strtod(p, nullptr));
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14")) {
+        c14_q    = std::max(0.0f, (float) std::strtod(p, nullptr));
+        c14_real = c14_q > 0.0f;
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14_N")) {
+        c14_n = std::max(1, atoi(p));
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14_SEL")) {
+        c14_sel = std::strcmp(p, "light") == 0 ? 1 : std::strcmp(p, "tier") == 0 ? 2 : 0;
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14_SKIP")) {
+        c14_skip.clear();
+        for (const char * q = p; *q != '\0';) {
+            char * end = nullptr;
+            const long v = std::strtol(q, &end, 10);
+            if (end == q) {
+                break;
+            }
+            c14_skip.push_back((int32_t) v);
+            q = *end == ',' ? end + 1 : end;
+        }
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14_DROP")) {
+        c14_drop = atoi(p) != 0;
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_C14_DEPTH")) {
+        c14_depth = atoi(p) >= 2 ? 2 : 1;
+    }
+    if (c14_q > 0.0f && (drop_w <= 0.0f || runahead_k > 0 || subst > 0 || g4_probe > 0 || g31 > 0 ||
+                (c14_real && (!mailbox || c14_drop)))) {
+        LLAMA_LOG_WARN("%s: moe stream: LLAMA_MOE_STREAM_%s is ignored %s\n", __func__, c14_real ? "C14" : "C14_Q",
+                drop_w <= 0.0f ? "without the drop rule's path (DROP_W > 0; 1e-6 for the exact one)" :
+                runahead_k > 0 ? "next to runahead" : subst > 0 ? "next to C13" : g4_probe > 0 ? "next to the G4 probe" :
+                g31 > 0 ? "next to G31" : !mailbox ? "without the mailbox (G16)" : "with C14_DROP (that is the probe's)");
+        c14_q    = 0.0f;
+        c14_real = false;
+    }
+    if (c14_real && c14_depth != 1) {
+        LLAMA_LOG_WARN("%s: moe stream: C14 proper defers to the next layer's attention only (DEPTH 1)\n", __func__);
+        c14_depth = 1;
+    }
+    if (c14_q > 0.0f) {
+        std::string skip;
+        for (const int32_t il : c14_skip) {
+            skip += (skip.empty() ? "" : ",") + std::to_string(il);
+        }
+        if (c14_real) {
+            LLAMA_LOG_WARN("%s: moe stream: C14 on (lossy): up to %d of a one-token call's misses with a share under %.3f "
+                    "(%s first) are not waited for by their call - their GEMMs run after the next layer's attention, "
+                    "while its copies fly, and their sum joins its residual; layers %s never defer\n", __func__, c14_n,
+                    c14_q, c14_sel == 0 ? "the drive's" : c14_sel == 1 ? "the lightest" : "the host tier's only",
+                    skip.empty() ? "none" : skip.c_str());
+        } else {
+            LLAMA_LOG_WARN("%s: moe stream: C14 probe E1 (lossy): up to %d of a one-token call's misses with a share under "
+                    "%.3f (%s first) are summed apart and added after the next layer's %s%s; layers %s never defer\n",
+                    __func__, c14_n, c14_q, c14_sel == 0 ? "the drive's" : c14_sel == 1 ? "the lightest" :
+                    "the host tier's only", c14_depth >= 2 ? "FFN (DEPTH 2)" : "attention",
+                    c14_drop ? " - THROWN AWAY (C14_DROP=1)" : "", skip.empty() ? "none" : skip.c_str());
+        }
+    }
     if (const char * p = std::getenv("LLAMA_MOE_STREAM_SPEC_VRAM")) {
         spec_vram = std::strtol(p, nullptr, 10) != 0;
     }
