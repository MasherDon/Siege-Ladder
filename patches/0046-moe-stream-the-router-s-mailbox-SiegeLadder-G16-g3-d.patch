+    }
+    if (strcmp(name, "ggml_backend_cuda_host_device_ptr") == 0) {
+        return (void *)ggml_backend_cuda_host_device_ptr;
+    }
     return nullptr;
 }
 
diff --git a/ggml/src/ggml-cuda/mbox.cu b/ggml/src/ggml-cuda/mbox.cu
new file mode 100644
index 0000000..d96ec9e
--- /dev/null
+++ b/ggml/src/ggml-cuda/mbox.cu
@@ -0,0 +1,35 @@
+#include "mbox.cuh"
+
+// SiegeLadder G16, the router's mailbox. One block copies the payload (32-bit words, a few KB at most) into the record
+// in pinned host memory - the device reaches it through unified addressing - then a system-scope fence makes those
+// writes visible before thread 0 bumps the sequence word at the record's head. The host polls that word; once it has
+// moved, the payload is there. An increment, not a value fixed at capture, so every replay of a CUDA graph posts anew.
+static __global__ void k_mbox_post(const uint32_t * __restrict__ src, uint32_t * dst, const int n_words,
+        volatile uint32_t * seq) {
+    ggml_cuda_pdl_sync(); // the producer of src (top-k, the packed weights) must be done
+
+    for (int i = threadIdx.x; i < n_words; i += blockDim.x) {
+        dst[i] = src[i];
+    }
+    __threadfence_system();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        *seq = *seq + 1u;
+        __threadfence_system();
+    }
+}
+
+void ggml_cuda_op_mbox_post(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_nbytes(a) % 4 == 0);
+
+    void * rec;
+    memcpy(&rec, dst->op_params, sizeof(rec));
+    GGML_ASSERT(rec != nullptr);
+
+    const int n_words = (int) (ggml_nbytes(a) / 4);
+    k_mbox_post<<<1, 256, 0, ctx.stream()>>>((const uint32_t *) a->data, (uint32_t *) ((char *) rec + 64), n_words,
+            (volatile uint32_t *) rec);
+    CUDA_CHECK(cudaGetLastError());
+}
