+// a tensor header over record k's payload, shaped like the tensor the graph posted
+static ggml_tensor moe_mb_tensor(const llama_moe_stream_layer & sl, int k) {
+    ggml_tensor t;
+    std::memset(&t, 0, sizeof(t));
+    t.type = sl.mb_type[k];
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        t.ne[i] = sl.mb_ne[k][i];
+    }
+    t.nb[0] = ggml_type_size(t.type);
+    for (int i = 1; i < GGML_MAX_DIMS; i++) {
+        t.nb[i] = t.nb[i - 1]*t.ne[i - 1];
+    }
+    t.data = (char *) sl.mb_rec[k] + 64;
+    return t;
+}
