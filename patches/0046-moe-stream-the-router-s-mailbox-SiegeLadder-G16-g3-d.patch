+// ------------------------------------------------------------------------------------------------------------------
+// SiegeLadder G16, the router's mailbox (theories G16, g3-design.md step 1). The card posts the remap's inputs into a
+// pinned record (ggml_mbox_post: the payload, a system-scope fence, then the sequence word +1); the remap's CPU split
+// has no card input, so the scheduler neither synchronizes nor copies before it, and the card goes on - the shared
+// expert - while the host remaps. The host polls the sequence word. Under WDDM the queued card work may sit in the
+// command buffer until some call flushes it, so the poll flushes the compute stream at once and every millisecond.
+
+static void moe_mb_wait(llama_moe_stream & mgr, llama_moe_stream_layer & sl, int k) {
+    volatile uint32_t * seq  = (volatile uint32_t *) sl.mb_rec[k];
+    const uint32_t      want = sl.mb_seen[k] + 1u;
+    if ((int32_t) (*seq - want) < 0) {
+        const int64_t t0      = ggml_time_us();
+        int64_t       t_flush = t0;
+        if (mgr.stream_query != nullptr && mgr.compute_backend != nullptr) {
+            mgr.stream_query(mgr.compute_backend);
+            mgr.stats.n_mb_flush++;
+        }
+        while ((int32_t) (*seq - want) < 0) {
+            const int64_t now = ggml_time_us();
+            if (now - t_flush > 1000 && mgr.stream_query != nullptr && mgr.compute_backend != nullptr) {
+                mgr.stream_query(mgr.compute_backend);
+                mgr.stats.n_mb_flush++;
+                t_flush = now;
+            }
+            if (now - t0 > 30*1000*1000) {
+                GGML_ABORT("MoE mailbox (G16): layer %d, record %d: post %u never came (the record holds %u)",
+                        sl.il, k, want, *seq);
+            }
+#if defined(_M_X64) || defined(__x86_64__) || defined(_M_IX86) || defined(__i386__)
+            _mm_pause();
+#endif
+        }
+        mgr.stats.t_mb_wait_us += ggml_time_us() - t0;
+    }
+    std::atomic_thread_fence(std::memory_order_acquire);
+    sl.mb_seen[k] = want;
+    mgr.stats.n_mb_posts++;
+}
