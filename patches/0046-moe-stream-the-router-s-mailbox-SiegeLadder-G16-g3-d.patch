 static_assert(GGML_OP_POOL_COUNT == 2, "GGML_OP_POOL_COUNT != 2");
 
@@ -6503,6 +6505,24 @@ struct ggml_tensor * ggml_dsv4_hc_post(
     return result;
 }
 
+// SiegeLadder G16: the record pointer rides in op_params; the payload starts 64 bytes into the record
+struct ggml_tensor * ggml_mbox_post(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        void                * rec) {
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_nbytes(a) % 4 == 0);
+    GGML_ASSERT(rec != NULL);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+    ggml_set_op_params(result, &rec, sizeof(rec));
+
+    result->op     = GGML_OP_MBOX_POST;
+    result->src[0] = a;
+
+    return result;
+}
