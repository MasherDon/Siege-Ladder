+// SiegeLadder G16: a non-blocking query of the backend's stream. Under WDDM queued work may sit in the command
+// buffer until some call flushes it; a host thread polling a mailbox the GPU has not reached yet calls this.
+// Returns 1 when the stream is idle, 0 while work is pending, -1 on an error (cleared).
+int ggml_backend_cuda_stream_query(ggml_backend_t backend) {
+    if (!ggml_backend_is_cuda(backend)) {
+        return -1;
+    }
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    const cudaError_t err = cudaStreamQuery(cuda_ctx->stream());
+    if (err == cudaSuccess) {
+        return 1;
+    }
+    if (err == cudaErrorNotReady) {
+        (void) cudaGetLastError();
+        return 0;
+    }
+    (void) cudaGetLastError();
+    return -1;
+}
+
+// SiegeLadder G16: the device address of pinned host memory (cudaHostGetDevicePointer), or nullptr. Under unified
+// addressing it is the host address itself - the mailbox records rely on that.
+void * ggml_backend_cuda_host_device_ptr(void * host) {
+    void * dev = nullptr;
+    if (cudaHostGetDevicePointer(&dev, host, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    return dev;
+}
+
