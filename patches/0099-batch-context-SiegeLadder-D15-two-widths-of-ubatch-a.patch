From 36d1ac8c486c0b5177ddfd1719a5b3d756a3d397 Mon Sep 17 00:00:00 2001
From: MasherDon <62326358+MasherDon@users.noreply.github.com>
Date: Mon, 26 Oct 2026 04:27:04 +0000
Subject: [PATCH 099/121] batch + context : SiegeLadder D15 - two widths of
 ubatch at long context (automatic by default: only when the whole model's
 prompt graph does not fit at -ub; LLAMA_DSV4_UB_FULL=N - a fixed N, =0 -
 off). Under P4 + C7 the whole model is needed only by a long prompt's last
 ubatches (from C7's bound, the call's last 140 positions on): every ubatch
 before them runs P4's encoder-only graph, which has no use for the decoder's
 sparse plan - yet the compute buffers were reserved for the whole model at
 -ub, 15 172 MiB at 1M and -ub 2048, so 1M ran at -ub 512 only. Now a call's
 leading tokens that P4 runs encoder-only (no output, every sequence's
 position below its p4_dec_start; a last wide ubatch shorter than p4_min goes
 narrow) go in ubatches of -ub and the rest in ubatches of at most N
 (llama_batch_allocr::set_widths / split_width;
 llama_kv_cache_dsv4::init_batch takes its widths there, per-sequence streams
 only narrow), and sched_reserve reserves the whole model at N and P4's
 encoder-only graph at -ub, each with its non-sparse (D10) variant and D12's
 cap - the buffers the largest of all; the log gives what each graph asks on
 its own. Automatic: when the whole model's graph does not fit at -ub, its
 width halves down to 256; where it fits no width plan is set and nothing
 changes. At 1M: encoder only at 2048 6 964 MiB, the whole model at 512 5 828
 (the automatic mode picks 512 itself). Logits byte for byte when the two
 layouts coincide (prompt 2048 k + 140: the bound on a ubatch border),
 otherwise closer to -ub 2048 than -ub 512 is (mean |d log p| 0.0045 against
 0.0077, no argmax change). The 1M document (945 619 tokens) at -ub 2048:
 470.7 tok/s against 194.8 at 512 (x2.42, 33.5 min against 81), 21.9 TB from
 the drives against 65.7; agent turns on it read x1.66 (201 tok/s against
 121), answers the same (SiegeLadder runs.md 4.250)

---
 src/llama-batch.cpp         |  20 ++++++
 src/llama-batch.h           |  11 +++
 src/llama-context.cpp       | 137 ++++++++++++++++++++++++++++++++----
 src/llama-context.h         |   8 +++
 src/llama-kv-cache-dsv4.cpp |   8 ++-
 5 files changed, 169 insertions(+), 15 deletions(-)

diff --git a/src/llama-batch.cpp b/src/llama-batch.cpp
index 2b98a55..e3daea8 100644
--- a/src/llama-batch.cpp
+++ b/src/llama-batch.cpp
@@ -473,6 +473,22 @@ void llama_batch_allocr::split_reset() {
     used.resize(get_n_tokens(), false);
 }
 
+void llama_batch_allocr::set_widths(uint32_t n_wide, uint32_t n_ub_wide, uint32_t n_ub_narrow) {
+    d15_n_wide    = n_wide;
+    d15_ub_wide   = n_ub_wide;
+    d15_ub_narrow = n_ub_narrow;
+}
+
+uint32_t llama_batch_allocr::split_width(uint32_t n_ubatch, bool in_order) const {
+    if (d15_ub_narrow == 0) {
+        return n_ubatch;
+    }
+    if (in_order && n_used < d15_n_wide) {
+        return std::min(d15_ub_wide, d15_n_wide - n_used);
+    }
+    return std::min(n_ubatch, d15_ub_narrow);
+}
+
 llama_ubatch llama_batch_allocr::split_simple(uint32_t n_ubatch) {
     // find the first unused token
     uint32_t cur_idx = 0;
@@ -744,6 +760,10 @@ void llama_batch_allocr::clear() {
     seq_set_map.clear();
 
     std::fill(seq_idx.begin(), seq_idx.end(), -1);
+
+    d15_n_wide    = 0;
+    d15_ub_wide   = 0;
+    d15_ub_narrow = 0;
 }
 
 llama_ubatch llama_batch_allocr::ubatch_add(const std::vector<int32_t> & idxs, uint32_t n_seqs, bool equal_seqs) {
