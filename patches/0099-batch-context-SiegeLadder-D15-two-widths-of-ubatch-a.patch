+    if (d15_ub_full > 0) {
+        uint32_t n_wide = 0;
+        if (p4_reach > 0) {
+            const llama_batch & b = balloc->get_batch();
+            for (int32_t i = 0; i < b.n_tokens; ++i) {
+                bool below = !b.logits[i];
+                for (int32_t s = 0; s < b.n_seq_id[i] && below; ++s) {
+                    const llama_pos lo = p4_dec_start[b.seq_id[i][s]];
+                    below = lo >= 0 && b.pos[i] < lo;
+                }
+                if (!below) {
+                    break;
+                }
+                n_wide++;
+            }
+            const uint32_t tail = n_wide % cparams.n_ubatch;
+            if (tail > 0 && tail < p4_min) {
