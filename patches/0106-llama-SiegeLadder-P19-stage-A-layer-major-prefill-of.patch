diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 1ff84b8..4201c7d 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -7,6 +7,7 @@
 #include "llama-batch.h"
 #include "llama-io.h"
 #include "llama-memory.h"
+#include "llama-kv-cache-dsv4.h"
 #include "llama-mmap.h"
 #include "llama-model.h"
 #include "llama-moe-stream.h"
@@ -663,6 +664,19 @@ llama_context::llama_context(
             d16_margin_mib = atoi(p);
         }
 
+        // SiegeLadder P19 layer-major prefill
+        if (model.hparams.dsv4_v41) {
+            if (const char * lm = std::getenv("LLAMA_DSV4_LAYER_MAJOR")) {
+                lm_k = atoi(lm);
+            }
+            if (const char * gib = std::getenv("LLAMA_DSV4_LAYER_MAJOR_GIB")) {
+                const int v = atoi(gib);
+                if (v > 0) {
+                    lm_budget_gib = (uint32_t) v;
+                }
+            }
+        }
+
         sched_reserve();
 
         // P1: the -ub buffers are reserved only when the first long prompt comes. Probe them now, with the head
@@ -2037,8 +2051,8 @@ bool llama_context::set_adapter_cvec(
     return res;
 }
 
-llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
-    if (mctx && !mctx->apply()) {
+llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret, bool skip_apply) {
+    if (mctx && !skip_apply && !mctx->apply()) {
         LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
         ret = GGML_STATUS_FAILED;
         return nullptr;
@@ -2055,7 +2069,8 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     // is reused only if no other build on this model (a reserve, another context) came after it
     auto * mstream = model.moe_stream();
     llama_moe_stream_nvtx_push("graph_reuse");
-    const bool reuse = !graph_reuse_disable && (mstream == nullptr || res->ms_build == mstream->n_build) &&
+    const bool reuse = !graph_reuse_disable && cparams.dsv4_lm_carry_in == nullptr && cparams.dsv4_lm_carry_out == nullptr &&
+            (mstream == nullptr || res->ms_build == mstream->n_build) &&
             res->can_reuse(gparams);
     llama_moe_stream_nvtx_pop();
 
@@ -2109,6 +2124,20 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
     {
         //const auto t_start_us = ggml_time_us();
 
+        // SiegeLadder P19: a segment's carried state into the input tensors its graph made for it
+        if (cparams.dsv4_lm_carry_in != nullptr) {
+            const int64_t t0 = ggml_time_us();
+            // an input no op of this segment reads (the top-k or the verdicts before a layer that makes its own, P4's
+            // last group) is left out of the graph and has no buffer - its bytes stay the slot's for the next segment
+            for (const auto & it : cparams.dsv4_lm_carry_in->v) {
+                if (it.t != nullptr && it.t->buffer != nullptr) {
+                    GGML_ASSERT(it.host != nullptr);
+                    ggml_backend_tensor_set(it.t, it.host, 0, ggml_nbytes(it.t));
+                }
+            }
+            lm_copy_us += ggml_time_us() - t0;
+        }
+
         // FIXME this call causes a crash if any model inputs were not used in the graph and were therefore not allocated
         llama_moe_stream_nvtx_push("set_inputs");
         res->set_inputs(&ubatch);
@@ -2780,6 +2809,466 @@ int llama_context::decode(const llama_batch & batch_inp) {
     int64_t yoco_row_call = 0;
     int64_t yoco_cut_call = 0; // C7c: the rows cut out after the first decoder layer
 
+    bool layer_major_done = false;
+
+    if (lm_k > 0) {
+        const char * lm_off = nullptr;
+        auto * dctx = dynamic_cast<llama_kv_cache_dsv4_context *>(mctx.get());
+
+        if (!model.hparams.dsv4_v41) {
+            lm_off = "not V4.1";
+        } else if (dctx == nullptr) {
+            lm_off = "memory is not DSV4 batch context";
+        } else if (dctx->n_ubatches() < 2) {
+            lm_off = "fewer than 2 ubatches";
+        } else if (!cparams.causal_attn) {
+            lm_off = "not causal";
+        } else if (cparams.n_rs_seq != 0) {
+            lm_off = "n_rs_seq != 0";
+        } else if (cparams.embeddings || cparams.embeddings_nextn) {
+            lm_off = "embeddings request";
+        } else {
+            for (bool e : cparams.embeddings_layer_inp) {
+                if (e) {
+                    lm_off = "embeddings_layer_inp";
+                    break;
+                }
+            }
+        }
+
+        if (lm_off == nullptr) {
+            const llama_batch & b = balloc->get_batch();
+            llama_seq_id seq_ref = -1;
+            for (int32_t i = 0; i < b.n_tokens; ++i) {
+                if (b.n_seq_id[i] != 1) {
+                    lm_off = "coupled sequences";
+                    break;
+                }
+                const llama_seq_id s = b.seq_id[i][0];
+                if (seq_ref < 0) {
+                    seq_ref = s;
+                } else if (seq_ref != s) {
+                    lm_off = "multiple sequences";
+                    break;
+                }
+            }
+        }
+
+        if (lm_off != nullptr) {
+            // said only for a call that could have gone layer-major (more than one ubatch); a token's call is quiet
+            if (n_tokens_all > (int64_t) cparams.n_ubatch) {
+                LLAMA_LOG_INFO("%s: layer-major off (%s)\n", __func__, lm_off);
+            }
+        } else {
+            const int32_t n_layer  = model.hparams.n_layer();
+            const int32_t dec      = model.hparams.dsv4_dec_first();
+            const auto    groups   = [&]() {
+                std::vector<std::pair<int32_t, int32_t>> g;
+                int32_t l0 = 0;
+                while (l0 < n_layer) {
+                    int32_t l1 = l0 + lm_k;
+                    if (l0 < dec && l1 > dec) {
+                        l1 = dec;
+                    } else {
+                        l1 = std::min(l1, n_layer);
+                    }
+                    g.emplace_back(l0, l1);
+                    l0 = l1;
+                }
+                return g;
+            }();
+
+            const uint64_t budget_bytes = (uint64_t) lm_budget_gib*1024ull*1024*1024;
+            const size_t   n_ub         = dctx->n_ubatches();
+            const int64_t  hc_m         = model.hparams.dsv4_hc_mult;
+            const int64_t  n_embd_m     = model.hparams.n_embd;
+
+            // the state a ubatch carries between groups, estimated before any graph runs (the slots take what the graphs
+            // export, see lm_slot_pull): the stream (n_embd x hc f32), the mix (hc f32), the top-k (indexer_top_k i32)
+            // and the candidate verdicts - one f32 per block of the densest compressed cache the ubatch's last position
+            // reaches, plus that cache's padding
+            uint32_t ratio_min = 0;
+            for (int32_t il = 0; il < n_layer; ++il) {
+                const uint32_t r = model.hparams.dsv4_compress_ratios[il];
+                if (r > 0 && (ratio_min == 0 || r < ratio_min)) {
+                    ratio_min = r;
+                }
+            }
+            const uint64_t cand_block = model.hparams.dsv4_candidate_block_size;
+            auto lm_state_bytes = [&](const llama_ubatch & ub) -> uint64_t {
+                llama_pos p_max = 0;
+                for (uint32_t i = 0; i < ub.n_tokens; ++i) {
+                    p_max = std::max(p_max, ub.pos[i]);
+                }
+                uint64_t per_pos = 4*(uint64_t) (hc_m*n_embd_m) + 4*(uint64_t) hc_m + 4*(uint64_t) model.hparams.indexer_top_k;
+                if (cand_block > 0 && ratio_min > 0) {
+                    per_pos += 4*((uint64_t) (p_max + 1)/ratio_min/cand_block + 256);
+                }
+                return per_pos*(uint64_t) ub.n_tokens;
+            };
+
+            std::vector<std::pair<size_t, size_t>> superchunks;
+            for (size_t u0 = 0; u0 < n_ub;) {
+                size_t u1 = u0;
+                uint64_t acc = 0;
+                while (u1 < n_ub) {
+                    const uint64_t add = lm_state_bytes(dctx->lm_ubatch(u1));
+                    if (u1 > u0 && acc + add > budget_bytes) {
+                        break;
+                    }
+                    acc += add;
+                    ++u1;
+                }
+                if (u1 == u0) {
+                    ++u1;
+                }
+                superchunks.emplace_back(u0, u1);
+                u0 = u1;
+            }
+
+            bool any_multi_ub_sc = false;
+            for (const auto & sc : superchunks) {
+                if (sc.second - sc.first >= 2) {
+                    any_multi_ub_sc = true;
+                    break;
+                }
+            }
+
+            if (!any_multi_ub_sc) {
+                LLAMA_LOG_INFO("%s: layer-major off (superchunks are single-ubatch under %u GiB budget)\n", __func__,
+                        lm_budget_gib);
+            } else {
+            dctx->lm_metadata_pass();
+            lm_copy_us = 0;
+
+            ggml_backend_buffer_type_t lm_host_buft = nullptr;
+            for (auto & backend : backends) {
+                ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+                if (dev != nullptr) {
+                    lm_host_buft = ggml_backend_dev_host_buffer_type(dev);
+                    if (lm_host_buft != nullptr) {
+                        break;
+                    }
+                }
+            }
+            if (lm_host_buft == nullptr) {
+                LLAMA_LOG_INFO("%s: layer-major off (no pinned host buffer type)\n", __func__);
+            } else {
+            struct lm_ub_plan {
+                int32_t  n_out     = 0;
+                bool     enc_only  = false;
+                int32_t  yoco_lo   = -1;
+                int32_t  yoco_cut  = 0;
+                int64_t  yoco_row0 = 0;
+            };
+            std::vector<lm_ub_plan> ub_plans(n_ub);
+            for (size_t u = 0; u < n_ub; ++u) {
+                dctx->lm_seek(u);
+                const llama_ubatch & ub = dctx->get_ubatch();
+                lm_ub_plan &         p   = ub_plans[u];
+                if (n_outputs_all == n_tokens_all) {
+                    p.n_out = ub.n_tokens;
+                } else {
+                    for (uint32_t i = 0; i < ub.n_tokens; i++) {
+                        p.n_out += (int32_t) (ub.output[i] != 0);
+                    }
+                }
+                p.enc_only = p4_enc_only(ub);
+                if (yoco_k > 0 && !p.enc_only) {
+                    p.yoco_lo = yoco_ubatch_lo(ub, p.yoco_row0);
+                    if (yoco_nobound) {
+                        p.yoco_lo = -1;
+                    }
+                    p.yoco_row0 = yoco_rows ? p.yoco_row0 : 0;
+                    if (yoco_cut && p.yoco_lo >= 0 && p.yoco_row0 > 0 &&
+                            (int64_t) ub.n_tokens - p.yoco_row0 >= yoco_cut_min) {
+                        bool out_before = false;
+                        for (int64_t i = 0; i < p.yoco_row0 && !out_before; ++i) {
+                            out_before = ub.output[i] != 0;
+                        }
+                        if (!out_before) {
+                            p.yoco_cut = (int32_t) p.yoco_row0;
+                        }
+                    }
+                }
+            }
+
+            // one slot per ubatch of a superchunk: in - what the next group's graph reads (host bytes, shape, type; the
+            // graph fills in its input tensors), out - the tensors the group's graph exported. Each item has a pinned
+            // host buffer of its own, which grows as the item does (the candidate verdicts widen with the position)
+            using lm_carry = llama_cparams::llama_dsv4_lm_carry;
+            struct lm_carry_slot {
+                ggml_backend_buffer_ptr buf[lm_carry::N];
+                size_t                  cap[lm_carry::N] = {};
+                lm_carry                in;
+                lm_carry                out;
+            };
+            size_t  lm_pinned      = 0; // pinned host bytes the slots hold
+            size_t  lm_pinned_peak = 0;
+            int64_t lm_n_pull = 0, lm_n_keep = 0, lm_n_cut = 0;
+            int64_t lm_pull_bytes = 0;
+
+            // after a group's graph: what it exported becomes the slot's state - a computed tensor is read from its
+            // backend; the graph's own input is the slot's bytes already; a view of one (C7c's cut) is its rows moved
+            // to the front of those bytes
+            auto lm_slot_pull = [&](lm_carry_slot & s) {
+                for (int k = 0; k < lm_carry::N; ++k) {
+                    auto &        in = s.in.v[k];
+                    ggml_tensor * t  = s.out.v[k].t;
+                    s.out.v[k].t = nullptr;
+                    if (t == nullptr) {
+                        in = {};
+                        continue;
+                    }
+                    GGML_ASSERT(ggml_is_contiguous(t));
+                    const size_t nb = ggml_nbytes(t);
+                    if (in.t != nullptr && t == in.t) {
+                        lm_n_keep++;
+                    } else if (in.t != nullptr && t->view_src == in.t) {
+                        GGML_ASSERT(t->view_offs + nb <= ggml_nbytes(in.t));
+                        memmove(in.host, (char *) in.host + t->view_offs, nb);
+                        lm_n_cut++;
+                    } else {
+                        for (const auto & o : s.in.v) {
+                            GGML_ASSERT(o.t == nullptr || (t != o.t && t->view_src != o.t));
+                        }
+                        if (nb > s.cap[k]) {
+                            lm_pinned -= s.cap[k];
+                            s.buf[k].reset(ggml_backend_buft_alloc_buffer(lm_host_buft, nb));
+                            GGML_ASSERT(s.buf[k] && "P19: no pinned host memory for the carried state");
+                            s.cap[k]        = nb;
+                            lm_pinned      += nb;
+                            lm_pinned_peak  = std::max(lm_pinned_peak, lm_pinned);
+                        }
+                        in.host = ggml_backend_buffer_get_base(s.buf[k].get());
+                        ggml_backend_t be = ggml_backend_sched_get_tensor_backend(sched.get(), t);
+                        GGML_ASSERT(be != nullptr);
+                        ggml_backend_tensor_get_async(be, t, in.host, 0, nb);
+                        lm_n_pull++;
+                        lm_pull_bytes += (int64_t) nb;
+                    }
+                    in.type = t->type;
+                    for (int j = 0; j < 4; ++j) {
+                        in.ne[j] = t->ne[j];
+                    }
+                }
+                for (auto & it : s.in.v) {
+                    it.t = nullptr;
+                }
+            };
+
+            int64_t n_graphs = 0;
+            uint64_t state_bytes_total = 0;
+
+            auto run_ubatch_outputs = [&](const llama_ubatch & ubatch, int32_t n_out, llm_graph_result * res) -> int {
+                if (!res) {
+                    return -3;
+                }
+                n_outputs = n_out;
+
+                auto * t_logits  = res->get_logits();
+                auto * t_embd    = cparams.embeddings       ? res->get_embd()     : nullptr;
+                auto * t_h_nextn = cparams.embeddings_nextn ? res->get_h_nextn()  : nullptr;
+
+                if (t_embd && res->get_embd_pooled()) {
+                    t_embd = res->get_embd_pooled();
+                }
+
+                if (logits.data && t_logits && n_outputs > 0 && needs_raw_logits(ubatch, sampling.samplers)) {
+                    ggml_backend_t backend_res = ggml_backend_sched_get_tensor_backend(sched.get(), t_logits);
+                    GGML_ASSERT(backend_res != nullptr);
+                    float * logits_out = logits.data + n_outputs_prev*n_vocab;
+                    ggml_backend_tensor_get_async(backend_res, t_logits, logits_out, 0, n_outputs*n_vocab*sizeof(float));
+                }
+
+                if (cparams.head_out && n_outputs > 0) {
+                    ggml_tensor * t_h = res->get_embd();
+                    GGML_ASSERT(t_h != nullptr && t_h->ne[0] == p1_n_embd && t_h->ne[1] == n_outputs);
+                    ggml_backend_t backend_h = ggml_backend_sched_get_tensor_backend(sched.get(), t_h);
+                    ggml_backend_tensor_get_async(backend_h, t_h, p1_hidden.data() + n_outputs_prev*p1_n_embd, 0,
+                            n_outputs*p1_n_embd*sizeof(float));
+                    p1_groups.emplace_back(n_outputs_prev, n_outputs);
+                }
+
+                n_outputs_prev += n_outputs;
+                n_tokens_prev  += ubatch.n_tokens;
+                return 0;
+            };
+
+            auto run_ubatch_full = [&](size_t u) -> int {
+                dctx->lm_seek(u);
+                const llama_ubatch & ubatch = dctx->get_ubatch();
+                const lm_ub_plan &   p      = ub_plans[u];
+                n_ub_call++;
+
+                n_outputs = p.n_out;
+                cparams.dsv4_enc_only = p.enc_only;
+                if (p.enc_only) {
+                    p4_ub_call++;
+                    p4_tok_call += ubatch.n_tokens;
+                }
+                cparams.dsv4_yoco_lo  = p.yoco_lo;
+                cparams.dsv4_yoco_cut = p.yoco_cut;
+                auto * yoco_ms = yoco_k > 0 ? model.moe_stream() : nullptr;
+                if (yoco_ms) {
+                    yoco_ms->c7_row0   = p.yoco_row0;
+                    yoco_ms->c7_layer0 = model.hparams.dsv4_dec_first();
+                    yoco_ms->c7_layer1 = p.yoco_cut > 0 ? model.hparams.dsv4_dec_first() + 1 : -1;
+                    if (p.yoco_lo >= 0) {
+                        yoco_ub_call++;
+                    }
+                    yoco_row_call += p.yoco_row0;
+                    if (p.yoco_cut > 0) {
+                        yoco_cut_call += p.yoco_cut;
+                    }
+                }
+
+                cparams.dsv4_lm_l0 = -1;
+                cparams.dsv4_lm_l1 = -1;
+                cparams.dsv4_lm_carry_in  = nullptr;
+                cparams.dsv4_lm_carry_out = nullptr;
+
+                ggml_status status = GGML_STATUS_SUCCESS;
+                llm_graph_result * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx.get(), status, true);
+
+                cparams.dsv4_enc_only = false;
+                cparams.dsv4_yoco_lo  = -1;
+                cparams.dsv4_yoco_cut = 0;
+                if (yoco_ms) {
+                    yoco_ms->c7_row0   = 0;
+                    yoco_ms->c7_layer1 = -1;
+                }
+
+                if (!res) {
+                    return -3;
+                }
+                return run_ubatch_outputs(ubatch, p.n_out, res);
+            };
+
+            std::vector<lm_carry_slot> slots;
+            for (const auto & sc : superchunks) {
+                if (sc.second - sc.first < 2) {
+                    if (run_ubatch_full(sc.first) != 0) {
+                        return -3;
+                    }
+                    continue;
+                }
+
+                const size_t n_sc = sc.second - sc.first;
+                if (slots.size() < n_sc) {
+                    slots.resize(n_sc);
+                }
+                uint64_t sc_est = 0;
+                for (size_t i = 0; i < n_sc; ++i) {
+                    slots[i].in  = {};
+                    slots[i].out = {};
+                    sc_est += lm_state_bytes(dctx->lm_ubatch(sc.first + i));
+                }
+                state_bytes_total = std::max(state_bytes_total, sc_est);
+                std::vector<bool> ub_counted(n_sc, false);
+
+                for (const auto & gr : groups) {
+                    const bool last_group = gr.second >= n_layer;
+                    for (size_t i = 0; i < n_sc; ++i) {
+                        const size_t       u = sc.first + i;
+                        const lm_ub_plan & p = ub_plans[u];
+                        // P4: an encoder-only ubatch ends with the source part of the first decoder layer - in the group
+                        // that starts there (the groups break at it), with nothing to carry on
+                        if (p.enc_only && gr.first > dec) {
