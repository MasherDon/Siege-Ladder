         io_mirror_bytes.fetch_add((int64_t) len, std::memory_order_relaxed);
@@ -2736,12 +2842,24 @@ void llama_moe_stream::enqueue_slot_locked(llama_moe_stream_layer & sl, int32_t
 // "<call> <layer> <e1,e2,...>" per line, in call order. Plain text on purpose: this file is
