     }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_MIRROR_ADAPT")) {
+        d14_adapt_s = std::max(0, atoi(p));
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_MIRROR_ADAPT_MS")) {
+        d14_adapt_thr = (int64_t) (std::max(1.0, std::strtod(p, nullptr))*1000.0);
+    }
+    if (const char * p = std::getenv("LLAMA_MOE_STREAM_MIRROR_ADAPT_AT")) {
+        d14_adapt_at = std::max(0, atoi(p));
+    }
     // A copy is used only with the part's size and the same bytes in 17 sampled 64 KiB blocks (the start, 15 spread
     // through the file, the tail): a stale copy of another build must not feed the cache without a word
     const size_t blk = 64u << 10;
@@ -1896,23 +1971,54 @@ void llama_moe_stream::open_mirrors(const std::vector<std::string> & paths, cons
     moe_aligned_free(buf_b);
     LLAMA_LOG_INFO("%s: P16: copies of %d of %zu parts in %s (%.1f GB); a slab goes to a copy while the primary has >= %d "
             "reads in flight and the copies < %d\n", __func__, n_open, files.size(), dir, gb, mirror_at, mirror_max);
+    if (d14_adapt_s > 0 && n_open > 0) {
+        LLAMA_LOG_WARN("%s: moe stream: D14 switch on standby - a primary read of %.0f ms or more sends reads to the copies "
+                "from %d in flight for %d s after it (LLAMA_MOE_STREAM_MIRROR_ADAPT)\n", __func__, d14_adapt_thr/1000.0,
+                d14_adapt_at, d14_adapt_s);
+    }
 }
 
