     mirrors.clear();
     mirrors.resize(files.size());
@@ -1841,6 +1907,15 @@ void llama_moe_stream::open_mirrors(const std::vector<std::string> & paths, cons
     if (const char * p = std::getenv("LLAMA_MOE_STREAM_MIRROR_MAX")) {
