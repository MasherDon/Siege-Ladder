+            LLAMA_LOG_WARN("%s: moe stream: D14 switch on - a primary read took %.1f ms; until %d s after the latest such read "
+                    "the copies take reads from %d in flight (not %d)\n", __func__, d/1000.0, d14_adapt_s, d14_adapt_at,
+                    mirror_at);
