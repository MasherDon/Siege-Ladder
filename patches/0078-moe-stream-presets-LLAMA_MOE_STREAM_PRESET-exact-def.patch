+// SiegeLadder presets (LLAMA_MOE_STREAM_PRESET=exact|default|fast): one key for the decode modes of runs.md 4.157-4.161.
+// A preset only fills keys that are not set, so an explicit key still wins. exact - no drops (runahead K = 6 then takes
+// over by itself, lossless); default - the fork's own defaults (drop 0.14 with DROP_ALL, G31); fast - the default plus
+// C14 0.2 (late, N 1: +4.8...+5.2% over the default, general-100 dNLL about +0.005 more, 4.152 / 4.157). Runs before
+// any key is read, at the start of the ctor; the keys are set in the process environment, so children see them too.
+static void moe_stream_apply_preset() {
+    const char * name = std::getenv("LLAMA_MOE_STREAM_PRESET");
+    if (name == nullptr || *name == '\0') {
+        return;
+    }
+    // the ctor runs more than once per process (the loader's memory-fit dry run builds one with the log silenced): the
+    // first call sets the keys, the later ones repeat its line instead of calling the preset's own keys explicit
+    static std::string applied;
+    if (!applied.empty()) {
+        LLAMA_LOG_WARN("%s: moe stream: %s\n", __func__, applied.c_str());
+        return;
+    }
+    struct preset_key { const char * key; const char * value; };
+    static const preset_key k_exact[] = { { "LLAMA_MOE_STREAM_DROP_W", "0"   } };
+    static const preset_key k_fast[]  = { { "LLAMA_MOE_STREAM_C14",    "0.2" } };
+    const preset_key * keys = nullptr;
+    size_t             n    = 0;
+    if (std::strcmp(name, "exact") == 0) {
+        keys = k_exact;
+        n    = sizeof(k_exact)/sizeof(k_exact[0]);
+    } else if (std::strcmp(name, "fast") == 0) {
+        keys = k_fast;
+        n    = sizeof(k_fast)/sizeof(k_fast[0]);
+    } else if (std::strcmp(name, "default") != 0) {
+        LLAMA_LOG_WARN("%s: moe stream: unknown LLAMA_MOE_STREAM_PRESET=%s (exact, default, fast) - ignored\n", __func__, name);
+        return;
+    }
+    std::string set, kept;
+    for (size_t i = 0; i < n; i++) {
+        if (const char * v = std::getenv(keys[i].key)) {
+            kept += format("%s%s=%s", kept.empty() ? "" : ", ", keys[i].key, v);
+            continue;
+        }
+#ifdef _WIN32
+        _putenv_s(keys[i].key, keys[i].value);
+#else
+        setenv(keys[i].key, keys[i].value, 0);
+#endif
+        set += format("%s%s=%s", set.empty() ? "" : ", ", keys[i].key, keys[i].value);
+    }
+    applied = format("preset %s%s%s%s%s", name, set.empty() ? "" : " - sets ", set.c_str(),
+            kept.empty() ? "" : "; set explicitly, kept: ", kept.c_str());
+    LLAMA_LOG_WARN("%s: moe stream: %s\n", __func__, applied.c_str());
+}
