+// SiegeLadder D14, adaptive (LLAMA_MOE_STREAM_MIRROR_ADAPT=S seconds; off by default): the primary drive stalls ~40 ms
+// about once a second in episodes under sustained load (runs.md 4.149, 4.153), while a permanent shift of reads to the copy
+// costs ~0.7 ms per token outside them (4.160). So a primary read of MIRROR_ADAPT_MS (16) ms or more opens an episode: until
+// S seconds after the latest such read the copies take reads from MIRROR_ADAPT_AT (2) primary reads in flight instead of
+// MIRROR_AT. The drives are the process's, so is this state (file-static: no header change).
+static int32_t              d14_adapt_s   = 0;
+static int64_t              d14_adapt_thr = 16000; // us
+static int32_t              d14_adapt_at  = 2;
+static std::atomic<int64_t> d14_until_us{0};
+static std::atomic<int64_t> d14_start_us{0};
+static std::atomic<bool>    d14_on{false};
+static std::atomic<int64_t> d14_episodes{0};
+static std::atomic<int64_t> d14_total_us{0};
+
