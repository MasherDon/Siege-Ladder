+// M12: what a decode call is about to wait for - its loads still in flight, by where their bytes come from (slot_src).
+// 3 = a drive read of its own (a miss nobody staged ahead), 2 = drive reads staged ahead only, 1 = all from the host
+// tier, 0 = nothing in flight any more
+static int moe_wait_sources_locked(llama_moe_stream & mgr, llama_moe_stream_layer & sl) {
+    int64_t n_drive = 0;
+    int64_t n_tier  = 0;
+    int64_t n_own   = 0;
+    const int64_t now = ggml_time_us();
+    for (const int32_t s : sl.demand_slots) {
+        if (sl.slot_state[s] == LLAMA_MOE_STREAM_SLOT_RESIDENT) {
+            continue;
+        }
+        (sl.slot_src[s] & 1 ? n_drive : n_tier)++;
+        n_own += (sl.slot_src[s] & 3) == 1;
+        mgr.stats.n_wait_slots_staged += (sl.slot_src[s] & 2) != 0;
+        if (sl.slot_t_wait[s] == 0) {
+            sl.slot_t_wait[s] = now; // its time left is read when it turns RESIDENT (slot_resident_locked)
+        }
+    }
+    mgr.stats.n_wait_slots_drive += n_drive;
+    mgr.stats.n_wait_slots_tier  += n_tier;
+    return n_own > 0 ? 3 : n_drive > 0 ? 2 : n_tier > 0 ? 1 : 0;
+}
+
+static void moe_wait_account_locked(llama_moe_stream & mgr, int kind, int64_t dt_us) {
+    if (kind >= 2) {
+        mgr.stats.n_wait_calls_drive++;
+        mgr.stats.t_stall_drive_us += dt_us;
+        if (kind == 3) {
+            mgr.stats.n_wait_calls_own++;
+            mgr.stats.t_stall_own_us += dt_us;
+        }
+    } else if (kind == 1) {
+        mgr.stats.n_wait_calls_tier++;
+        mgr.stats.t_stall_tier_us += dt_us;
+    }
+}
