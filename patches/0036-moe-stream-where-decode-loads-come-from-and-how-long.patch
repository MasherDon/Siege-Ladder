+static int moe_dt_bucket(int64_t us) {
+    static const int64_t edge[7] = { 250, 500, 1000, 2000, 4000, 8000, 16000 };
+    int b = 0;
+    while (b < 7 && us >= edge[b]) {
+        b++;
+    }
+    return b;
+}
+
+void llama_moe_stream::slot_resident_locked(llama_moe_stream_layer & sl, int32_t slot) {
+    sl.slot_state[slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+    const uint8_t src = sl.slot_src[slot];
+    if ((src & 4) == 0) {
+        return; // not a decode load
+    }
+    const int64_t now    = ggml_time_us();
+    const int     drive  = src & 1;
+    const int     staged = (src >> 1) & 1;
+    const int64_t dt     = now - sl.slot_t_res[slot];
+    stats.n_dt[staged][drive][moe_dt_bucket(dt)]++;
+    stats.t_dt_us[staged][drive] += dt;
+    if (sl.slot_t_wait[slot] > 0) {
+        const int64_t left = now - sl.slot_t_wait[slot];
+        stats.n_left[staged][drive][moe_dt_bucket(left)]++;
+        stats.t_left_us[staged][drive] += left;
+        sl.slot_t_wait[slot] = 0;
+    }
+}
+
+bool llama_moe_stream::on_drive_locked(const llama_moe_stream_layer & sl, int32_t expert) {
+    if (!l2) {
+        return true;
+    }
+    for (const auto & wt : sl.weights) {
+        if (!l2->has(wt.file_idx, wt.offs + (size_t) expert*wt.nb_expert, wt.nb_expert)) {
+            return true;
+        }
+    }
+    return false;
+}
