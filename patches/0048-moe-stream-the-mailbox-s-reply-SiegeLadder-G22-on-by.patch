+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2412,6 +2412,9 @@ static bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct gg
         case GGML_OP_MBOX_POST:
             ggml_cuda_op_mbox_post(ctx, dst);
