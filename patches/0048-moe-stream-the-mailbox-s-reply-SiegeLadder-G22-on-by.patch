diff --git a/ggml/src/ggml-cuda/mbox.cu b/ggml/src/ggml-cuda/mbox.cu
index d96ec9e..5f98cef 100644
--- a/ggml/src/ggml-cuda/mbox.cu
+++ b/ggml/src/ggml-cuda/mbox.cu
@@ -33,3 +33,53 @@ void ggml_cuda_op_mbox_post(ggml_backend_cuda_context & ctx, ggml_tensor * dst)
             (volatile uint32_t *) rec);
     CUDA_CHECK(cudaGetLastError());
 }
+
+// SiegeLadder G22, the mailbox's reply. The host wrote the record before it launched this split, so the read needs no
+// wait; the record's head - the number of the post it answers - is checked against the post record's sequence word
+// all the same: a mismatch means the split ran before the host's answer, and then the output is fill (skip ids for the
+// MMVQ GEMMs, zero multipliers) and the error word tells the host which reply it was. volatile loads are system-scope
+// relaxed: they see what the host wrote, not a line some earlier replay left in a cache.
+static __global__ void k_mbox_read(const volatile uint32_t * rec, const int off_words, const int n_words,
+        const volatile uint32_t * post, volatile uint32_t * err, const uint32_t fill, const uint32_t who,
+        uint32_t * __restrict__ dst) {
+    ggml_cuda_pdl_sync(); // dst may reuse memory the kernel before this one still reads
+
+    __shared__ uint32_t ok;
+    if (threadIdx.x == 0) {
+        const uint32_t tag  = rec[0];
+        const uint32_t want = *post;
+        ok = tag == want;
+        if (!ok && err != nullptr) {
+            *err = who;
+            __threadfence_system();
+        }
+    }
+    __syncthreads();
+    for (int i = threadIdx.x; i < n_words; i += blockDim.x) {
+        dst[i] = ok ? rec[off_words + i] : fill;
+    }
+}
+
+void ggml_cuda_op_mbox_read(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(ggml_type_size(dst->type) == 4);
+
+    const uint8_t * p = (const uint8_t *) dst->op_params;
+    const char * rec;
+    const void * post;
+    void       * err;
+    int32_t      offset, fill, who;
+    memcpy(&rec,    p +  0, sizeof(rec));
+    memcpy(&post,   p +  8, sizeof(post));
+    memcpy(&err,    p + 16, sizeof(err));
+    memcpy(&offset, p + 24, sizeof(offset));
+    memcpy(&fill,   p + 28, sizeof(fill));
+    memcpy(&who,    p + 32, sizeof(who));
+    GGML_ASSERT(rec != nullptr && post != nullptr && offset % 4 == 0);
+
+    const int n_words = (int) ggml_nelements(dst);
+    k_mbox_read<<<1, 32, 0, ctx.stream()>>>((const volatile uint32_t *) rec, offset/4, n_words,
+            (const volatile uint32_t *) post, (volatile uint32_t *) err, (uint32_t) fill, (uint32_t) who,
+            (uint32_t *) dst->data);
+    CUDA_CHECK(cudaGetLastError());
+}
