diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 80f9b73..d983874 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -575,6 +575,7 @@ extern "C" {
         GGML_OP_DSV4_HC_PRE,
         GGML_OP_DSV4_HC_POST,
         GGML_OP_MBOX_POST,
+        GGML_OP_MBOX_READ,
 
         GGML_OP_UNARY,
 
@@ -2659,6 +2660,26 @@ extern "C" {
             struct ggml_tensor  * a,
             void                * rec);
 
+    // SiegeLadder G22, the mailbox's reply: a new tensor of the given type (4-byte elements) and shape, read from the
+    // host-written record rec - pinned host memory the device reaches through unified addressing - at rec + offset. The
+    // record's head holds the number of the post it answers; it must equal the sequence word of the post record post
+    // (the ggml_mbox_post this reply answers), or the read was earlier than the host's answer: then every element is
+    // fill, and who is written into the 32-bit word err (if not NULL) for the host to report. No sources: the graph
+    // orders it after the op that writes the record, and the host runs that op before it launches this one
+    GGML_API struct ggml_tensor * ggml_mbox_read(
+            struct ggml_context * ctx,
+            enum ggml_type        type,
+            int64_t               ne0,
+            int64_t               ne1,
+            int64_t               ne2,
+            int64_t               ne3,
+            const void          * rec,
+            int32_t               offset,
+            const void          * post,
+            void                * err,
+            int32_t               fill,
+            int32_t               who);
+
     // custom operators
 
     typedef void (*ggml_custom1_op_t)(struct ggml_tensor * dst , const struct ggml_tensor * a, int ith, int nth, void * userdata);
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 4be716e..18af0b8 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2088,6 +2088,38 @@ static void ggml_compute_forward(struct ggml_compute_params * params, struct ggm
                     *seq = *seq + 1;
                 }
             } break;
+        case GGML_OP_MBOX_READ:
+            {
+                // SiegeLadder G22 on the CPU: the reply's head must answer the post's sequence word, else fill
+                if (params->ith == 0) {
+                    const uint8_t * p = (const uint8_t *) tensor->op_params;
+                    const char * rec;
+                    const void * post;
+                    void       * err;
+                    int32_t      offset, fill, who;
+                    memcpy(&rec,    p +  0, sizeof(rec));
+                    memcpy(&post,   p +  8, sizeof(post));
+                    memcpy(&err,    p + 16, sizeof(err));
+                    memcpy(&offset, p + 24, sizeof(offset));
+                    memcpy(&fill,   p + 28, sizeof(fill));
+                    memcpy(&who,    p + 32, sizeof(who));
+                    const uint32_t tag  = *(const volatile uint32_t *) rec;
+                    const uint32_t want = *(const volatile uint32_t *) post;
+                    atomic_thread_fence(memory_order_acquire);
+                    const int64_t n = ggml_nelements(tensor);
+                    int32_t * dst = (int32_t *) tensor->data;
+                    if (tag == want) {
+                        memcpy(dst, rec + offset, n*sizeof(int32_t));
+                    } else {
+                        for (int64_t i = 0; i < n; i++) {
+                            dst[i] = fill;
+                        }
+                        if (err != NULL) {
+                            *(volatile uint32_t *) err = (uint32_t) who;
+                        }
+                    }
+                }
+            } break;
         case GGML_OP_MAP_CUSTOM1:
             {
                 ggml_compute_forward_map_custom1(params, tensor);
@@ -2275,6 +2307,7 @@ static int ggml_get_n_tasks(struct ggml_tensor * node, int n_threads) {
                 n_tasks = n_threads;
             } break;
         case GGML_OP_MBOX_POST:
+        case GGML_OP_MBOX_READ:
             {
                 n_tasks = 1;
             } break;
