 }
 
+// SiegeLadder G22: op_params - bytes 0..7 the reply record, 8..15 the post record whose sequence word the reply's head
+// must equal, 16..23 the error word (may be NULL), then int32 offset, fill and who
+struct ggml_tensor * ggml_mbox_read(
+        struct ggml_context * ctx,
+        enum ggml_type        type,
+        int64_t               ne0,
+        int64_t               ne1,
+        int64_t               ne2,
+        int64_t               ne3,
+        const void          * rec,
+        int32_t               offset,
+        const void          * post,
+        void                * err,
+        int32_t               fill,
+        int32_t               who) {
+    GGML_ASSERT(ggml_type_size(type) == 4 && ggml_blck_size(type) == 1);
+    GGML_ASSERT(rec != NULL && post != NULL);
+    GGML_ASSERT(offset >= 4 && offset % 4 == 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, type, ne0, ne1, ne2, ne3);
+
+    uint8_t params[36];
+    memcpy(params +  0, &rec,    sizeof(rec));
+    memcpy(params +  8, &post,   sizeof(post));
+    memcpy(params + 16, &err,    sizeof(err));
+    memcpy(params + 24, &offset, sizeof(offset));
+    memcpy(params + 28, &fill,   sizeof(fill));
+    memcpy(params + 32, &who,    sizeof(who));
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op = GGML_OP_MBOX_READ;
+
+    return result;
+}
+
