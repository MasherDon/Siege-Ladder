+// ------------------------------------------------------------------------------------------------------------------
+// SiegeLadder G22, the mailbox's reply (theories G22, runs.md 4.76). With the mailbox the remap's CPU split has no card
+// input, but its answers - the slot ids for the expert GEMMs, the multipliers of the drop rule or of runahead's pass -
+// still went to the card as the next card split's inputs: the scheduler synchronized the compute stream (which waits
+// on the slots' copy events, so the host slept until the copies landed), copied each answer synchronously and only
+// then launched the split - ~90 us of idle card per layer. Here an op on the same CPU split copies the answers into
+// the layer's reply record with the number of the post they answer, and ggml_mbox_read at the head of the next card
+// split gives the card its own copy: that split has no host input, the host launches it right after the remap, while
+// the copies are still in flight, and the card starts the GEMMs once the copy events fire. The host's order is the
+// guarantee - the CPU split ends before the next split is launched; the record of the next token is written only after
+// that token's post, which the card makes after it read this one. The number at the record's head is checked by the
+// card all the same (ggml_mbox_read), and a stale read stops the run at the next mailbox wait.
+
+static void moe_rp_write(llama_moe_stream_layer & sl, int k, const ggml_tensor * dst) {
+    char *              rec = (char *) sl.rp_rec[k];
+    const ggml_tensor * a   = dst->src[0];
+    const ggml_tensor * b   = dst->src[1];
+    GGML_ASSERT(rec != nullptr && a != nullptr && ggml_is_contiguous(a) && (b == nullptr || ggml_is_contiguous(b)));
+    const size_t na  = ggml_nbytes(a);
+    const size_t off = 64 + GGML_PAD(na, 64);
+    GGML_ASSERT(off + (b != nullptr ? ggml_nbytes(b) : 0) <= LLAMA_MOE_STREAM_RP_REC_BYTES);
+    std::memcpy(rec + 64, a->data, na);
+    if (b != nullptr) {
+        std::memcpy(rec + off, b->data, ggml_nbytes(b));
+    }
+    std::atomic_thread_fence(std::memory_order_release);
+    *(volatile uint32_t *) rec = sl.mb_seen[k]; // the post this answers; the card compares it with that post's number
+    sl.mgr->stats.n_rp_writes++;
+}
