+// one positional read finished (see io_path in the header); lock-free, called by every worker
+void llama_moe_stream::io_record(bool spec, int64_t t0_us, int64_t t1_us, size_t nbytes) {
+    auto & p = io[spec ? 1 : 0];
+    const int64_t d = t1_us - t0_us;
+    p.n     += 1;
+    p.us    += d;
+    p.bytes += (int64_t) nbytes;
+    for (int64_t m = p.us_max.load(); d > m && !p.us_max.compare_exchange_weak(m, d);) {}
