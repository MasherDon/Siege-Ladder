+// A4b. Reserve cache slots for the experts of the next vram_ahead calls and queue their loads now,
+// while the GPU still has this layer's experts and the next layer's attention to compute, instead of
+// after the next router: the uploads then overlap compute rather than follow it. Measured 2026-10-14
+// (SiegeLadder runs.md 4.21, Nsight with the oracle 200 calls ahead): expert uploads took 37 ms of a
+// ~100 ms token and overlapped compute for 0.00 ms.
+//
+// Victims come from the target layer's own slots and never one its call needs. A target layer is
+// idle until its call: the graph synchronises on every remap, so nothing on the GPU still reads its
+// slots, and the call itself waits for RESIDENT as for any other load. Without an evictable slot the
+// expert is left to demand. Math is untouched: this moves when an upload happens, not what is read.
+void llama_moe_stream::stage_ahead_locked(int64_t idx, int32_t il_now) {
+    for (int64_t j0 = idx + 1; j0 <= idx + vram_ahead && j0 < (int64_t) spec_oracle.size(); j0++) {
+        const int32_t il_f = spec_oracle[(size_t) j0].first;
+        if (il_f == il_now || il_f < 0 || (size_t) il_f >= layers.size() || !layers[il_f]) {
+            continue; // never the running layer: its slots are about to be read
+        }
+        auto & sf = *layers[il_f];
+        const auto & experts = spec_oracle[(size_t) j0].second;
+
+        std::fill(sf.keep.begin(), sf.keep.end(), 0);
+        for (const int32_t e : experts) {
+            const auto it = sf.expert_slot.find(e);
+            if (it != sf.expert_slot.end()) {
+                sf.keep[it->second] = 1;
+            }
+        }
+        for (const int32_t e : experts) {
+            if (e < 0 || (uint32_t) e >= sf.n_expert || sf.expert_slot.count(e)) {
+                continue;
+            }
+            const int32_t v = pick_victim_locked(sf, sf.keep.data());
+            if (v < 0) {
+                stats.n_stage_skip++;
+                continue;
+            }
+            if (!sf.seen[e]) {
+                stats.n_miss_cold++; // counted here, since the call will find the slot already reserved
+            }
+            reserve_slot_locked(sf, e, v);
+            sf.slot_staged[v] = 1;
+            sf.keep[v]        = 1;
+            enqueue_slot_locked(sf, e, v, /*stage =*/ true);
+            stats.n_stage++;
+        }
+    }
+}
