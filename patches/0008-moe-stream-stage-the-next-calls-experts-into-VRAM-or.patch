+// NVTX ranges for Nsight Systems: where the remap op and the I/O workers spend a token. Header-only
+// NVTX3 from the CUDA toolkit, defined by CMake when it is found; without a profiler attached a range
+// costs one call through a null function pointer. The payload is the layer, so a report can be split
+// per layer.
+#ifdef LLAMA_MOE_STREAM_NVTX
+#ifdef _WIN32
+// nvtx3 includes <windows.h>, whose min/max macros would break std::min/std::max below
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#endif
+#include <nvtx3/nvToolsExt.h>
+
+static void moe_nvtx_push(const char * name, int32_t il) {
+    nvtxEventAttributes_t a = {};
+    a.version        = NVTX_VERSION;
+    a.size           = NVTX_EVENT_ATTRIB_STRUCT_SIZE;
+    a.messageType    = NVTX_MESSAGE_TYPE_ASCII;
+    a.message.ascii  = name;
+    a.payloadType    = NVTX_PAYLOAD_TYPE_INT32;
+    a.payload.iValue = il;
+    nvtxRangePushEx(&a);
+}
+
+static void moe_nvtx_pop() {
+    nvtxRangePop();
+}
+#else
+static void moe_nvtx_push(const char *, int32_t) {}
+static void moe_nvtx_pop() {}
+#endif
+
+struct moe_nvtx_range {
+    moe_nvtx_range(const char * name, int32_t il) { moe_nvtx_push(name, il); }
+    ~moe_nvtx_range() { moe_nvtx_pop(); }
+};
