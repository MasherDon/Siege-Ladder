+// SiegeLadder C7: the bound of this ubatch's graph - its sequence's yoco_lo when some row at or past it lies inside its
+// first window (the only rows the bound changes), else -1 - and row0, C7b's first row at or past the bound when the
+// positions rise (the decoder rows before it are without consequence: no output, and the rows past the bound do not see
+// them). One sequence only: the masks are those of one stream, C7b's wave plan is the ubatch's
+int32_t llama_context::yoco_ubatch_lo(const llama_ubatch & ubatch, int64_t & row0) const {
+    row0 = 0;
+    if (yoco_k <= 0 || ubatch.n_tokens == 0 || ubatch.n_seqs_unq != 1 || ubatch.n_seq_id[0] != 1) {
+        return -1;
+    }
+    const llama_seq_id seq = ubatch.seq_id[0][0];
+    if (seq < 0 || seq >= (llama_seq_id) yoco_lo.size() || yoco_lo[seq] < 0) {
+        return -1;
+    }
+    const llama_pos lo     = yoco_lo[seq];
+    const llama_pos n_swa  = (llama_pos) model.hparams.n_swa;
+    bool            bound  = false;
+    bool            rising = true;
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        if (ubatch.n_seq_id[i] != 1 || ubatch.seq_id[i][0] != seq) {
+            return -1;
+        }
+        const llama_pos p = ubatch.pos[i];
+        bound  = bound || (p >= lo && p < lo + n_swa - 1);
+        rising = rising && (i == 0 || p > ubatch.pos[i - 1]);
+    }
+    if (rising) {
+        while (row0 < (int64_t) ubatch.n_tokens && ubatch.pos[row0] < lo) {
+            row0++;
+        }
+        if (row0 == (int64_t) ubatch.n_tokens) {
+            row0 = 0; // every row below the bound: a ubatch P4 did not take (P4 off) - C7b leaves it alone
+        }
+    }
+    return bound ? lo : -1;
+}
