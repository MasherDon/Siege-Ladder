+            yoco_call = !cparams.embeddings_layer_inp[il];
+        }
+        if (yoco_call) {
+            const llama_batch & b = balloc->get_batch();
+            std::vector<llama_pos> first_out(LLAMA_MAX_SEQ, std::numeric_limits<llama_pos>::max());
+            std::vector<llama_pos> start    (LLAMA_MAX_SEQ, std::numeric_limits<llama_pos>::max());
+            std::vector<llama_pos> end      (LLAMA_MAX_SEQ, -1);
+            for (int32_t i = 0; i < b.n_tokens; ++i) {
